msgstr "Noch keine Crawls – fügen Sie welche aus dem Projekt hinzu."

msgid "No crawls yet — try one above."
msgstr "Noch keine Crawls – starten Sie oben einen."

msgid "No finished crawls in this project yet."
msgstr "In diesem Projekt gibt es noch keine abgeschlossenen Crawls."

msgid "No further detail was recorded."
msgstr "Es wurden keine weiteren Details erfasst."

msgid "No other subdomains were linked from the pages crawled."
msgstr "Von den gecrawlten Seiten waren keine weiteren Subdomains verlinkt."

msgid "No page or sentence is in more than one crawl."
msgstr "Keine Seite und kein Satz kommt in mehr als einem Crawl vor."

msgid "No pages counted yet."
msgstr "Es wurden noch keine Seiten gezählt."

msgid "No project"
msgstr "Kein Projekt"

