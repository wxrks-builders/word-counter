msgid_plural "linked from %(n)s pages"
msgstr[0] "von %(n)s Seite verlinkt"
msgstr[1] "von %(n)s Seiten verlinkt"

#. %(date)s is when this connection was made, filled in by the browser.
#, python-format
msgid "made %(date)s"
msgstr "erstellt am %(date)s"

#. Translators: after a new connection's key hint ("wck_…a1b2 · made just
#. now").
msgid "made just now"
msgstr "gerade erstellt"

msgid "moved"
msgstr "verschoben"

msgid "new"
msgstr "neu"

#. the caption under the project's big number of new words.            %(n)s is
#. how many sites the project counts (two or more).
#, python-format
msgid ""
"new words to translate across the %(n)s site: each page and each sentence"
" counted once."
msgid_plural ""
"new words to translate across the %(n)s sites: each page and each "
"sentence counted once."
msgstr[0] ""
"Neue Wörter, die auf der %(n)s Website zu übersetzen sind: Jede Seite und"
" jeder Satz wird einmal gezählt."
msgstr[1] ""
"Neue Wörter, die auf den %(n)s Websites übersetzt werden müssen: Jede "
"Seite und jeder Satz werden einmal gezählt."

#. the caption under the project's big number of new words,          when the
#. project counts one site.
msgid ""
"new words to translate on this site: each page and each sentence counted "
"once."
msgstr ""
"Neue Wörter, die auf dieser Website übersetzt werden müssen: Jede Seite "
"und jeder Satz werden einmal gezählt."

#. the caption under a project's big number, which is a count of new words.
msgid "new words: each page and sentence once"
msgstr "neue Wörter: jede Seite und jeder Satz einmal"

msgid "not used yet"
msgstr "noch nicht verwendet"

#, python-format
msgid "of the %(n)s word checked"
msgid_plural "of the %(n)s words checked"
