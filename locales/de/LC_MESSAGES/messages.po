#, python-format
msgid "This run was set to “%(scope)s”, so other subdomains weren’t crawled."
msgstr ""
"Dieser Durchlauf war auf „%(scope)s“ eingestellt, daher wurden andere "
"Subdomains nicht gecrawlt."

#, python-format
msgid "This site has more than %(n)s word."
msgid_plural "This site has more than %(n)s words."
msgstr[0] "Diese Website enthält mehr als %(n)s Wort."
msgstr[1] "Diese Website enthält mehr als %(n)s Wörter."

msgid ""
"This site is password-protected. Enter the username and password its "
"owner gave you."
msgstr ""
"Diese Website ist passwortgeschützt. Geben Sie den Benutzernamen und das "
"Passwort ein, die Ihnen der Inhaber mitgeteilt hat."

msgid "This subdomain only"
msgstr "Nur diese Subdomain"

msgid "This will start automatically, and we'll email you when it's done."
msgstr ""
"Dies startet automatisch, und wir senden Ihnen eine E-Mail, sobald es "
"abgeschlossen ist."

msgid "Times"
msgstr "Zeiten"

msgid "Title"
msgstr "Titel"

msgid "Together"
msgstr "Gemeinsam"

