msgid "e.g. %(path)s"
msgstr "z. B. %(path)s"

msgid "e.g. Claude Code on my laptop"
msgstr "z. B. Claude Code auf meinem Laptop"

#. the caption under the project's number of new words; %(n)s is how many
#. crawls it covers.
#, python-format
msgid "each page and each sentence once, in %(n)s crawl"
msgid_plural "each page and each sentence once, across %(n)s crawls"
msgstr[0] "jede Seite und jeden Satz einmal in einem Crawl"
msgstr[1] "jede Seite und jeden Satz einmal, über %(n)s Crawls hinweg"

#. Translators: in the Words column instead of a number; keep it short.
msgid "failed"
msgstr "fehlgeschlagen"

