#, python-format
msgid "You’re not signed in, so this report is kept for %(days)s day."
msgid_plural "You’re not signed in, so this report is kept for %(days)s days."
msgstr[0] "ログインしていないため、このレポートは%(days)s日間保存されます。"

msgid "a tool by wxrks"
msgstr "wxrksのツール"

