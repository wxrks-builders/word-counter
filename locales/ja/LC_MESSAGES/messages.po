#, python-format
msgid "made %(date)s"
msgstr "%(date)sに作成されました"

#. Translators: after a new connection's key hint ("wck_…a1b2 · made just
#. now").
msgid "made just now"
msgstr "たった今作成されました"

msgid "moved"
msgstr "移動しました"

msgid "new"
msgstr "新規"

