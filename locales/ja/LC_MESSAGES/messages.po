msgid "each page and each sentence once, in %(n)s crawl"
msgid_plural "each page and each sentence once, across %(n)s crawls"
msgstr[0] "%(n)s回のクロールを通じて、各ページと各文を1回ずつ"

#. Translators: in the Words column instead of a number; keep it short.
msgid "failed"
msgstr "失敗しました"

