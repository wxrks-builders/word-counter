#, python-format
msgid "about %(n)s× faster"
msgstr "aproximadamente %(n)s× más rápido"

#. Translators: %(time)s is a duration such as "25 min", shown in bold.
#, python-format
msgid "about %(time)s on Pro"
msgstr "aproximadamente %(time)s en Pro"

