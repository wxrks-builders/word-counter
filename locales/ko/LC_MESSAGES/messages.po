#. Translators: one exclusion in the settings pill: %(entry)s is what was
#. typed, %(kind)s is "folder" or "subdomain".
#, python-format
msgid "%(entry)s (%(kind)s)"
msgstr "%(entry)s (%(kind)s)"

#. Translators: a duration in hours, abbreviated ("3h").
#, python-format
msgid "%(h)sh"
msgstr "%(h)sh"

#. Translators: a duration, abbreviated: h is hours, m is minutes ("1h 8m").
#, python-format
msgid "%(h)sh %(m)sm"
msgstr "%(h)sh %(m)sm"

#. Translators: one line of the plain-text email: a label and its value
#. ("Total words: 1,234"). Keep both placeholders.
#, python-format
msgid "%(label)s: %(value)s"
msgstr "%(label)s: %(value)s"

#. Translators: beside "Show more": %(loaded)s of %(total)s pages shown.
#, python-format
msgid "%(loaded)s of %(total)s"
msgstr "%(loaded)s개 / 총 %(total)s개"

#. Translators: part of the "Not counted" line; %(n)s counts pages
#. that asked for a sign-in. Agree with "pages" where your language must.
#, python-format
msgid "%(n)s behind a login"
msgid_plural "%(n)s behind a login"
msgstr[0] "로그인 뒤 %(n)s개"

#. Translators: part of the "Not counted" line; %(n)s counts pages the
#. site's bot protection refused. Agree with "pages" where your language must.
#, python-format
msgid "%(n)s blocked"
msgid_plural "%(n)s blocked"
msgstr[0] "차단됨 %(n)s개"

#. how many crawls a project holds, in a project's one-line summary.
#. how many crawls the project holds, then how many of them are still running.
#. a project's crawl count, then its words added up across those crawls.
#, python-format
msgid "%(n)s crawl"
msgid_plural "%(n)s crawls"
msgstr[0] "크롤링 %(n)s회"

#. Translators: the next four are parts of a short line under "Not
#. counted": "3 duplicates · 2 blocked". Keep them short.
#, python-format
msgid "%(n)s duplicate"
msgid_plural "%(n)s duplicates"
msgstr[0] "중복 %(n)s개"

#, python-format
msgid "%(n)s duplicate page isn’t in the total at all."
msgid_plural "%(n)s duplicate pages aren’t in the total at all."
msgstr[0] "중복 페이지 %(n)s개는 총계에 전혀 포함되지 않습니다."

#, python-format
msgid "%(n)s duplicate page within the sites."
msgid_plural "%(n)s duplicate pages within the sites."
msgstr[0] "사이트 내 중복 페이지 %(n)s개."

#. Translators: part of the "Not counted" line; %(n)s counts pages that
#. didn't load. Agree with "pages" where your language must.
#, python-format
msgid "%(n)s failed"
msgid_plural "%(n)s failed"
msgstr[0] "실패 %(n)s건"

#. how many Markdown files are in the ZIP download.
#, python-format
msgid "%(n)s file"
msgid_plural "%(n)s files"
msgstr[0] "파일 %(n)s개"

#. after the label "Subdomains": %(n)s subdomains were found,        and
#. %(words)s is "N more words", translated on its own.
#, python-format
msgid "%(n)s found, with %(words)s, each on its own line."
msgid_plural "%(n)s found, with %(words)s, each on its own line."
msgstr[0] "%(n)s개를 찾았습니다. 각 줄에 %(words)s개씩 있습니다."

#. Translators: a duration in minutes, abbreviated ("25 min").
#. how long a count took, in minutes, abbreviated.
#, python-format
msgid "%(n)s min"
msgid_plural "%(n)s min"
msgstr[0] "%(n)s분"

#. Translators: more pages in that language that weren't fetched at all.
#, python-format
msgid "%(n)s more not fetched"
msgid_plural "%(n)s more not fetched"
msgstr[0] "%(n)s개 더 가져오지 않음"

#, python-format
msgid "%(n)s more word"
msgid_plural "%(n)s more words"
msgstr[0] "단어 %(n)s개 더"

#, python-format
msgid "%(n)s new word"
msgid_plural "%(n)s new words"
msgstr[0] "새 단어 %(n)s개"

#. Translators: a page count, as part of a longer sentence.
#. how much two sites share: a number of pages, then a number of words in
#. shared sentences.
#, python-format
msgid "%(n)s page"
msgid_plural "%(n)s pages"
msgstr[0] "페이지 %(n)s개"

#. how many pages a plan fetches at the same time.
#, python-format
msgid "%(n)s page at a time"
msgid_plural "%(n)s pages at a time"
msgstr[0] "한 번에 %(n)s페이지씩"

#, python-format
msgid "%(n)s page behind a sign-in."
msgid_plural "%(n)s pages behind a sign-in."
msgstr[0] "로그인 뒤에 있는 페이지 %(n)s개."

#, python-format
msgid "%(n)s page failed to load."
msgid_plural "%(n)s pages failed to load."
msgstr[0] "페이지 %(n)s개를 불러오지 못했습니다."

#, python-format
msgid "%(n)s page was blocked by this site's own bot detection."
msgid_plural "%(n)s pages were blocked by this site's own bot detection."
msgstr[0] "이 사이트 자체의 봇 감지 기능으로 페이지 %(n)s개가 차단되었습니다."

#. Translators: pages in another language that were fetched, then left
#. out of the count.
#, python-format
msgid "%(n)s read and set aside"
msgid_plural "%(n)s read and set aside"
msgstr[0] "%(n)s개 읽고 보류하기"

#. pages matched only by their address, because their text wasn't kept to
#. compare; %(n)s is a number of pages.
#, python-format
msgid "%(n)s same address"
msgid_plural "%(n)s same address"
msgstr[0] "주소 %(n)s개 동일함"

#. under a pair of sites, how many of their shared pages have
#. the same text, changed text, or only the same address. Each %(n)s is a
#. number of pages.
#, python-format
msgid "%(n)s same text"
msgid_plural "%(n)s same text"
msgstr[0] "동일한 텍스트 %(n)s개"

#. after the number of crawls in a project: how many of them are still running.
#, python-format
msgid "%(n)s still crawling"
msgid_plural "%(n)s still crawling"
msgstr[0] "크롤링 중인 항목 %(n)s개 더 있음"

#. shared pages whose text differs between the two sites; %(n)s is a number of
#. pages.
#, python-format
msgid "%(n)s text changed"
msgid_plural "%(n)s text changed"
msgstr[0] "텍스트 %(n)s개가 변경되었습니다."

#. %(n)s is a number of translated pages the crawl skipped.
#, python-format
msgid "%(n)s translated page set aside, never fetched."
msgid_plural "%(n)s translated pages set aside, never fetched."
msgstr[0] "번역된 페이지 %(n)s개를 따로 보관했으며, 가져오지 않았습니다."

#. Translators: a word count, as part of a longer sentence.
#. a site's word count, in a small chip beside its address.
#. a crawl's word count and page count, in the list of crawls.
#, python-format
msgid "%(n)s word"
msgid_plural "%(n)s words"
msgstr[0] "단어 %(n)s개"

#, python-format
msgid "%(n)s word added up, each page once"
msgid_plural "%(n)s words added up, each page once"
msgstr[0] "페이지마다 한 번씩 총 %(n)s개 단어 추가됨"

#, python-format
msgid "%(n)s word checked by page only."
msgid_plural "%(n)s words checked by page only."
msgstr[0] "페이지별로만 확인한 단어 %(n)s개."

#. under a sketch of a web page, how many of its words were counted.
#. %(n)s is the number, in bold.
#, python-format
msgid "%(n)s word counted"
msgid_plural "%(n)s words counted"
msgstr[0] "단어 %(n)s개를 셌습니다."

#, python-format
msgid "%(n)s word in sentences"
msgid_plural "%(n)s words in sentences"
msgstr[0] "문장에 %(n)s개 단어"

#. a promotion on the report; %(n)s is the report's word count, in bold.
#. the headline of the wxrks offer, in the crawl email
#. and on the report. %(n)s is the site's word count.
#, python-format
msgid "%(n)s word to translate."
msgid_plural "%(n)s words to translate."
msgstr[0] "번역할 단어 %(n)s개."

#, python-format
msgid "%(name)s (you)"
msgstr "%(name)s (나)"

#. Translators: %(pct)s is a percentage (64%%), %(folder)s a folder such
#. as /blog, %(words)s a number of words; the plural follows the pages.
#, python-format
msgid "%(pct)s of the words are in %(folder)s: %(words)s on %(n)s page."
msgid_plural "%(pct)s of the words are in %(folder)s: %(words)s on %(n)s pages."
msgstr[0] "전체 단어 중 %(pct)s가 %(folder)s에 있습니다: %(n)s개 페이지에 %(words)s개의 단어가 있습니다."

#. a percentage in a table cell ("12%"); add the space or sign your language
#. uses.
#, python-format
msgctxt "percent"
msgid "%(pct)s%%"
msgstr "%(pct)s%%"

#, python-format
msgid "%(pct)s%% measured on every count, by sentence."
msgstr "문장별로 각 단어 수에서 %(pct)s%%를 측정했습니다."

#. %(pct)s is a percentage of the words; %(new)s is a number of words.
#, python-format
msgid "%(pct)s%% of it repeats text from other pages; %(new)s word is new."
msgid_plural "%(pct)s%% of it repeats text from other pages; %(new)s words are new."
msgstr[0] "%(pct)s%%는 다른 페이지의 텍스트를 반복하며, 새로운 단어는 %(new)s개입니다."

#, python-format
msgid "%(pct)s%% repeated in its own report"
msgstr "자체 보고서에서 %(pct)s%% 반복됨"

#, python-format
msgid "%(person)s shared a report with you"
msgstr "%(person)s님이 보고서를 공유했습니다."

#. Translators: the subject of the email inviting someone to a report.
#. %(person)s is the sender's name, or their email address.
#, python-format
msgid "%(person)s shared a word-count report with you"
msgstr "%(person)s님이 단어 수 보고서를 공유했습니다."

#. Translators: the first line of the README inside a Markdown download.
#. %(product)s is the product's name; %(site)s is the address crawled.
#, python-format
msgid "%(product)s — saved Markdown for %(site)s"
msgstr "%(product)s — %(site)s의 저장된 Markdown"

#. Translators: the crawl email's subject line. %(status)s is "Crawl
#. finished", "Crawl failed" or "Crawl stopped"; %(site)s is the address
#. that was crawled.
#, python-format
msgid "%(status)s: %(site)s"
msgstr "%(status)s: %(site)s"

#. under the product name on the sign-in page. %(tagline)s is          the
#. product's tagline, such as "Count every word on a website".
#, python-format
msgid "%(tagline)s. Sign in to point it at your own site."
msgstr "%(tagline)s. 로그인하여 본인 사이트를 지정하세요."

#. Translators: the inbox preview of the crawl-finished email.
#. %(words)s is "1,234 words" and %(pages)s is "56 pages", each
#. already in the plural form its number needs.
#, python-format
msgid "%(words)s across %(pages)s"
msgstr "%(pages)s개 페이지에서 %(words)s개의 단어"

#. an assistant's answer: "2,696,246 words on 2,494 pages".        %(words)s is
#. "N words" and %(pages)s is "N pages", each translated on its own.
#, python-format
msgid "%(words)s on %(pages)s"
msgstr "%(pages)s개 페이지에서 %(words)s개 단어"

#. Translators: crawl speed, abbreviated; %(words)s and %(pages)s are numbers.
#, python-format
msgid "%(words)s words/min · %(pages)s pages/min"
msgstr "%(words)s단어/분 · %(pages)s페이지/분"

msgid "(root)"
msgstr "(root)"

#. what goes between the items of a list ("A, B"). Use your        language's
#. list punctuation, such as "、" or "، ".
#. what goes between the items of a list of site names ("a.com, b.com").    Use
#. your language's list punctuation, such as "、" or "، ".
msgctxt "list separator"
msgid ", "
msgstr ", "

msgid "A chat transcript."
msgstr "채팅 기록."

msgid "A count you can check, not just a number"
msgstr "확인할 수 있는 단어 수, 단순한 숫자가 아닙니다"

msgid "A page or a sentence on more than one site is counted once."
msgstr "여러 사이트에 있는 페이지나 문장은 한 번만 계산됩니다."

msgid "A report link, a CSV of every page, the text as Markdown."
msgstr "보고서 링크, 모든 페이지가 담긴 CSV, 마크다운 형식의 텍스트."

msgid "A report you can send"
msgstr "전송할 수 있는 보고서"

msgid ""
"A run can be in more than one project. In each, a page found in several "
"crawls counts once."
msgstr "한 번의 실행은 둘 이상의 프로젝트에 포함될 수 있습니다. 각 항목에서 여러 크롤링에서 발견된 페이지는 한 번만 계산됩니다."

msgid "A website has 200 pages. But how much work is that?"
msgstr "웹사이트에 페이지가 200개 있습니다. 하지만 그 작업량은 얼마나 되나요?"

#. Translators: the inbox preview of that email. %(site)s is a web address.
#, python-format
msgid "A word count for %(site)s"
msgstr "%(site)s의 단어 수"

#. an assistant's advice on what to put in a translation quote.
#, python-format
msgid ""
"About %(words)s word, without the machine-generated API docs and the user"
" forum."
msgid_plural ""
"About %(words)s words, without the machine-generated API docs and the "
"user forum."
msgstr[0] "기계 생성 API 문서와 사용자 포럼을 제외하면 약 %(words)s단어입니다."

#. %(n)s and %(raw)s are whole-number multiples ("3", "4").
#, python-format
msgid ""
"About “%(n)s× faster” is measured, not arithmetic. Pro fetches %(raw)s× "
"as many pages at once, but fetching is only part of the work — every page"
" is also rendered and its text extracted, and that competes for CPU. The "
"honest number is the smaller one."
msgstr ""
"“%(n)s배 더 빠름”은 산술적 계산이 아니라 측정 결과입니다. Pro는 한 번에 %(raw)s배 더 많은 페이지를 가져오지만, "
"가져오기는 작업의 일부일 뿐입니다. 모든 페이지를 렌더링하고 텍스트를 추출하는 작업도 CPU를 사용합니다. 정확한 수치는 더 작은 "
"쪽입니다."

msgid "Add"
msgstr "추가하기"

msgid ""
"Add --scope user to have it in every project. Then type /mcp in Claude "
"Code to check that word-counter is connected, and ask away."
msgstr ""
"모든 프로젝트에 적용하려면 --scope user를 추가하세요. 그런 다음 Claude Code에서 /mcp를 입력해 word-"
"counter가 연결되었는지 확인하고, 원하는 내용을 질문하세요."

#. Translators: placeholder in the exclusions box once it holds an entry.
msgid "Add another…"
msgstr "하나 더 추가…"

#, python-format
msgid "Add existing runs to %(name)s"
msgstr "기존 실행을 %(name)s에 추가합니다."

#. opens a dialog for adding earlier crawls to this project.
msgid "Add existing runs…"
msgstr "기존 실행 추가…"

msgid "Add it to your app"
msgstr "앱에 추가하기"

msgid "Add people by email"
msgstr "이메일로 사용자 추가하기"

msgid "Add the crawls you already have, or crawl a site straight into it."
msgstr "이미 보유한 크롤링 결과를 추가하거나, 사이트를 바로 크롤링해 추가하세요."

#. a button that opens a dialog for choosing projects.
msgid "Add to a project…"
msgstr "프로젝트에 추가…"

msgid "Add to project"
msgstr "프로젝트에 추가하기"

msgid "Add to project…"
msgstr "프로젝트에 추가…"

msgid "Added since the last consolidation — in the next one."
msgstr "마지막 통합 이후 추가됨 — 다음 통합에 포함됩니다."

msgid "Added up: every page of every crawl"
msgstr "합계: 모든 크롤링의 모든 페이지"

msgid "Added up: every page of every site"
msgstr "합산: 모든 사이트의 모든 페이지"

msgid "Address shown on this report"
msgstr "이 보고서에 표시된 주소"

msgid "Adjust settings"
msgstr "설정 조정하기"

msgid "Advanced"
msgstr "고급"

#. a link to a comparison table; %(n)s is how many rows it has.
#, python-format
msgid "All %(n)s differences, side by side"
msgid_plural "All %(n)s differences, side by side"
msgstr[0] "차이점 %(n)s개 모두 나란히 보기"

msgid "All crawls"
msgstr "모든 크롤링 작업"

msgid "All your crawls"
msgstr "모든 크롤링 실행 내역"

#. a heading with the number of crawls in brackets: "All your crawls (25)".
#, python-format
msgid "All your crawls (%(n)s)"
msgid_plural "All your crawls (%(n)s)"
msgstr[0] "모든 크롤링(%(n)s)"

msgid "All your runs are in this project already."
msgstr "모든 실행이 이미 이 프로젝트에 있습니다."

msgid ""
"Already working in an AI assistant? Connect it to Word Counter and ask "
"about any website in plain words. The crawl runs on Word Counter’s "
"servers, and your assistant answers with the total, the repetition and "
"the split by language, with a link to the full report."
msgstr ""
"이미 AI 어시스턴트에서 작업 중이신가요? Word Counter에 연결하고 어떤 웹사이트든 일상적인 표현으로 질문하세요. 크롤링은"
" Word Counter 서버에서 실행되며, 어시스턴트가 총 단어 수, 반복 횟수, 언어별 분류와 전체 보고서 링크를 제공합니다."

msgid "An AI assistant on its own"
msgstr "독립형 AI 어시스턴트"

msgid "An assistant answering with Word Counter"
msgstr "Word Counter로 답변하는 어시스턴트"

msgid ""
"An assistant writes a new crawler every time, and its steps change from "
"one run to the next. Word Counter counts every site the same way, so next"
" month’s count compares with this one."
msgstr ""
"어시스턴트는 실행할 때마다 새 크롤러를 작성하며, 단계는 실행마다 달라집니다. Word Counter는 모든 사이트를 동일한 "
"방식으로 집계하므로 다음 달 집계와 이번 달 집계를 비교할 수 있습니다."

msgid ""
"An estimate of the sentences repeated across pages, and the split by "
"language, section and subdomain — the numbers a quote is built on."
msgstr "페이지 전반에 반복되는 문장 수 추정치와 언어, 섹션, 하위 도메인별 분포입니다. 견적 산정의 기준이 되는 수치입니다."

msgid ""
"An estimate: each page is split into sentences, matched exactly across "
"the pages counted, as CAT tools do at their simplest. Your TMS analysis "
"will differ with its own segmentation, tags, numbers and translation "
"memory."
msgstr ""
"예상치입니다. 각 페이지를 문장 단위로 나눈 다음, 가장 기본적인 CAT 도구처럼 집계된 페이지 전체에서 정확히 일치하는 문장을 "
"찾습니다. TMS 분석은 자체 세그먼트 분할, 태그, 숫자 및 번역 메모리에 따라 달라집니다."

msgid ""
"Any other app: use Streamable HTTP with the server URL and the key as a "
"Bearer token — or, if it only takes a URL, your personal URL."
msgstr ""
"다른 앱에서는 서버 URL과 키를 Bearer 토큰으로 사용해 Streamable HTTP를 설정하세요. URL만 입력할 수 있는 "
"경우에는 개인 URL을 사용하세요."

msgid "Anyone with the link can view this project"
msgstr "링크가 있는 사람은 누구나 이 프로젝트를 볼 수 있습니다."

msgid "Anyone with the link can view this report"
msgstr "링크가 있는 사람은 누구나 이 보고서를 볼 수 있습니다."

msgid "Articles"
msgstr "관사"

msgid "Ask Claude or ChatGPT how many words a website has"
msgstr "Claude 또는 ChatGPT에 웹사이트의 단어 수를 물어보세요."

msgid "Ask Claude or ChatGPT. Get the real count."
msgstr "Claude 또는 ChatGPT에 문의하세요. 정확한 단어 수를 확인하세요."

msgid "Ask about any website"
msgstr "웹사이트에 대해 무엇이든 물어보세요"

msgid "Ask your assistant the question it couldn’t answer before."
msgstr "이전에 답변하지 못한 질문을 어시스턴트에게 물어보세요."

#, python-format
msgid ""
"At %(n)s words, the crawl pauses and shows the projected word count, page"
" count and time remaining. When a sitemap is available, it helps check "
"the estimate."
msgstr ""
"단어 수가 %(n)s개에 도달하면 크롤링이 일시 중지되고 예상 단어 수, 페이지 수 및 남은 시간이 표시됩니다. 사이트맵을 사용할 "
"수 있으면 예상치를 확인하는 데 도움이 됩니다."

#. %(n)s is a number of words (where a count pauses to estimate).
#, python-format
msgid ""
"At about %(n)s word a count pauses with an estimate of the whole site. "
"Ask your assistant to continue and it counts every page."
msgid_plural ""
"At about %(n)s words a count pauses with an estimate of the whole site. "
"Ask your assistant to continue and it counts every page."
msgstr[0] ""
"약 %(n)s단어를 세면 전체 사이트의 예상치와 함께 카운트가 일시 중지됩니다. 어시스턴트에게 계속 진행하도록 요청하면 모든 "
"페이지를 셉니다."

msgid ""
"Available in English, Arabic, Chinese, French, German, Italian, Japanese,"
" Korean, Portuguese, Spanish and Swedish."
msgstr "영어, 아랍어, 중국어, 프랑스어, 독일어, 이탈리아어, 일본어, 한국어, 포르투갈어, 스페인어 및 스웨덴어로 제공됩니다."

msgid "Available when the crawl finishes"
msgstr "크롤링이 완료되면 이용할 수 있습니다."

msgid "Avg words / page"
msgstr "페이지당 평균 단어 수"

msgid "Before you count"
msgstr "계산하기 전에"

msgid "Behind a login"
msgstr "로그인 후 이용 가능"

msgid "Between"
msgstr "사이"

msgid "Big site? See the estimate before you keep going."
msgstr "사이트가 크신가요? 계속 진행하기 전에 예상 견적을 확인하세요."

msgid "Blocked by the host"
msgstr "호스트에 의해 차단됨"

#. Translators: a page row's tooltip: the site refused the crawler.
msgid "Blocked by the host's bot detection"
msgstr "호스트의 봇 감지로 차단됨"

msgid "Blocked or failed pages"
msgstr "차단되었거나 실패한 페이지들"

#. Translators: %(reason)s is the technical reason a page was blocked, often in
#. English.
#, python-format
msgid "Blocked: %(reason)s"
msgstr "차단됨: %(reason)s"

msgid "Broken down where it's useful"
msgstr "유용한 곳에서 세분화됨"

msgid "Built for translation quotes"
msgstr "번역 견적을 위해 제작됨"

msgid "Built with AI"
msgstr "AI로 제작됨"

msgid "Busy server load"
msgstr "서버 부하가 높습니다"

msgid "By folder"
msgstr "폴더별로"

msgid "By language"
msgstr "언어별"

msgid "By subdomain"
msgstr "하위 도메인별"

msgid "CMS and site builders"
msgstr "CMS 및 사이트 빌더\n"

msgid "CSV export, Markdown ZIP, shareable reports"
msgstr "CSV 내보내기, Markdown ZIP, 공유 가능한 보고서"

msgid "Cancel"
msgstr "취소"

msgid "Cancel anytime, from your billing page"
msgstr "결제 페이지에서 언제든지 취소할 수 있습니다."

msgid "Cancel crawl"
msgstr "크롤링 취소"

msgid "Cancel every active crawl on the server? This cannot be undone."
msgstr "서버에서 진행 중인 모든 크롤링을 취소하시겠습니까? 이 작업은 취소할 수 없습니다."

msgid "Cancelled"
msgstr "취소됨"

msgid "Cancelling…"
msgstr "취소 중…"

#. Translators: %(reason)s says why, such as "the server was running out
#. of disk space".
#, python-format
msgid ""
"Capture stopped before the end of the crawl because %(reason)s, so this "
"archive covers only the pages listed above. The word count itself is "
"complete."
msgstr ""
"%(reason)s 때문에 크롤링이 끝나기 전에 캡처가 중지되어 이 아카이브에는 위에 나열된 페이지만 포함됩니다. 단어 수 계산이 "
"완료되었습니다."

msgid "Carries a large site past its estimate to the very last page."
msgstr "대규모 사이트를 예상치를 넘어 마지막 페이지까지 크롤링합니다."

msgid "Change language"
msgstr "언어 변경"

msgid "Change the address this report shows"
msgstr "이 보고서에 표시되는 주소 변경하기"

msgid "Check staging content before launch"
msgstr "출시 전에 스테이징 콘텐츠를 확인하세요."

#. %(sites)s is a list of site names.
#, python-format
msgid ""
"Checked by page only: %(sites)s. These crawls kept no sentences and saved"
" no Markdown, so their pages count in full unless the same page is in "
"another crawl. A new crawl checks them sentence by sentence."
msgstr ""
"페이지별로만 확인됨: %(sites)s. 이 크롤링에서는 문장을 하나도 보존하지 않았고 Markdown도 저장하지 않았으므로, 같은"
" 페이지가 다른 크롤링에 포함되지 않는 한 페이지 수에 전체 페이지가 포함됩니다. 새 크롤링은 문장별로 확인합니다."

#. Translators: the name used for text in Chinese or Japanese characters,
#. which the language check can't tell apart.
msgid "Chinese or Japanese characters"
msgstr "중국어 또는 일본어 문자"

msgid "Choose Add custom connector."
msgstr "사용자 지정 커넥터 추가를 선택합니다."

msgid "Claude (claude.ai and Claude Desktop)"
msgstr "Claude (claude.ai 및 Claude Desktop)"

msgid "Claude (web and desktop)"
msgstr "Claude(웹 및 데스크톱)"

msgid "Claude Code — paste in a terminal"
msgstr "Claude Code — 터미널에 붙여넣기"

msgid "Claude Code, writing its own crawler"
msgstr "자체 크롤러를 작성하는 Claude Code"

msgid "Claude alone vs. with Word Counter"
msgstr "Claude 단독 사용 vs. Word Counter와 함께 사용"

msgid "Claude with and without it →"
msgstr "Claude 사용 여부 →"

msgid "Client view"
msgstr "고객 보기"

msgid "Close"
msgstr "닫기"

msgid ""
"Comma-separated subdomains and folders to leave out. A leading / excludes"
" a folder, anything else a subdomain."
msgstr "제외할 쉼표로 구분된 하위 도메인 및 폴더. 앞에 /가 있으면 폴더를 제외하고, 그 외의 경우에는 하위 도메인을 제외합니다."

msgid ""
"Comma-separated. A leading / excludes a folder, anything else a subdomain"
" — staging also matches web-staging.example.com. Useful with “Whole "
"domain”, which otherwise includes every subdomain, staging mirrors "
"included."
msgstr ""
"쉼표로 구분됨. 앞에 /가 있으면 폴더를 제외하고, 그 외의 경우에는 하위 도메인을 제외합니다. staging은 web-"
"staging.example.com에도 일치합니다. “전체 도메인”과 함께 사용하면 유용합니다. “전체 도메인”은 기본적으로 "
"스테이징 미러를 포함한 모든 하위 도메인을 포함합니다."

#. a button that opens the pricing page.
msgid "Compare plans"
msgstr "요금제 비교"

msgid "Compare the word counts of our live site and our staging site."
msgstr "라이브 사이트와 스테이징 사이트의 단어 수를 비교합니다."

msgid "Comparing sentences…"
msgstr "문장 비교 중…"

msgid "Completed"
msgstr "완료됨"

msgid "Connect Claude or ChatGPT"
msgstr "Claude 또는 ChatGPT 연결하기"

msgid "Connect Claude, ChatGPT or another assistant"
msgstr "Claude, ChatGPT 또는 다른 어시스턴트 연결하기"

msgid ""
"Connect Word Counter to Claude, ChatGPT, Cursor or any MCP client and ask"
" how many words a website has. It crawls every page and answers with the "
"real total, the repetition and the split by language."
msgstr ""
"Word Counter를 Claude, ChatGPT, Cursor 또는 MCP 클라이언트에 연결하고 웹사이트의 단어 수를 "
"물어보세요. 모든 페이지를 크롤링해 실제 총 단어 수와 반복 횟수, 언어별 분류를 알려줍니다."

msgid ""
"Connect Word Counter to your AI assistant. When you ask about a website, "
"it crawls every page and comes back with the real total — the same count "
"as our reports, not a guess from the homepage."
msgstr ""
"Word Counter를 AI 어시스턴트에 연결하세요. 웹사이트에 대해 문의하면 사이트의 모든 페이지를 크롤링해 실제 총 단어 수를"
" 알려드립니다. 홈페이지를 바탕으로 추정한 수치가 아니라 보고서에 표시되는 것과 동일한 단어 수입니다."

msgid "Connect an assistant"
msgstr "어시스턴트 연결하기"

msgid "Connect in three steps"
msgstr "세 단계로 연결하기"

msgid "Connect your assistant"
msgstr "어시스턴트 연결하기"

msgid "Consolidate"
msgstr "통합하기"

msgid "Consolidate again"
msgstr "다시 통합하기"

#. %(date)s is when the project's totals were last worked out, filled in by the
#. browser.
#, python-format
msgid "Consolidated %(date)s"
msgstr "%(date)s 통합됨"

msgid "Consolidating"
msgstr "통합 중"

msgid "Consolidating…"
msgstr "통합 중…"

msgid "Copied"
msgstr "복사됨"

msgid "Copy"
msgstr "복사하기"

msgid "Copy it now: this is the only time it’s shown. It works like a password."
msgstr "지금 복사하세요. 이 내용은 지금만 표시됩니다. 비밀번호처럼 작동합니다."

msgid "Copy link"
msgstr "링크 복사"

msgid "Could not reach billing"
msgstr "결제 페이지에 연결할 수 없습니다"

msgid ""
"Couldn't find a sign-in form there. Enter the address of the site's sign-"
"in page."
msgstr "해당 위치에서 로그인 양식을 찾을 수 없습니다. 사이트 로그인 페이지의 주소를 입력하세요."

msgid "Couldn't load more pages."
msgstr "페이지를 더 불러오지 못했습니다."

msgid "Couldn't send — try again."
msgstr "전송할 수 없습니다 — 다시 시도해 주세요."

msgid "Couldn’t delete this crawl. Try again."
msgstr "이 크롤링을 삭제할 수 없습니다. 다시 시도하세요."

msgid "Count a website"
msgstr "웹사이트를 크롤링하세요"

#. Translators: shown after the product name in page titles
#. ("Word Counter — Count every word on a website") and on the sign-in page.
msgid "Count every word on a website"
msgstr "웹사이트의 모든 단어를 세어 보세요."

msgid "Count my website’s words"
msgstr "내 웹사이트의 단어 수 세기"

msgid "Count only www.example.com — leave out its subdomains."
msgstr "www.example.com만 계산하고 하위 도메인은 제외합니다."

msgid "Count the content that belongs in your project"
msgstr "프로젝트에 포함할 콘텐츠를 계산하세요"

msgid "Count the words on example.com and tell me how much of it repeats."
msgstr "example.com의 단어 수를 세고 반복되는 부분이 얼마나 되는지 알려주세요."

#. %(product)s is the product's name.
#, python-format
msgid "Counted with %(product)s by wxrks"
msgstr "wxrks의 %(product)s로 집계됨"

msgid ""
"Counting relies on spaces between words, so totals for Chinese, Japanese "
"and Thai will be much too low."
msgstr "단어 수 계산은 단어 사이의 공백을 기준으로 하므로 중국어, 일본어, 태국어의 총 단어 수는 실제보다 훨씬 적게 표시됩니다."

msgid ""
"Counts a website: the total, pages, repetition, and the split by "
"language, section and subdomain, with a link to the full report. The "
"whole domain by default, or one host only. Reuses an earlier count of the"
" same site unless asked to count again."
msgstr ""
"웹사이트를 집계합니다. 전체 수, 페이지 수, 반복 횟수와 언어·섹션·하위 도메인별 분포를 보여 주며, 전체 보고서 링크도 "
"제공합니다. 기본적으로 전체 도메인 또는 호스트 하나만. 다시 세도록 요청하지 않는 한 동일한 사이트의 이전 단어 수를 "
"재사용합니다."

msgid "Counts each page once"
msgstr "각 페이지를 한 번씩 계산합니다"

#. Translators: %(checked)s and %(total)s are word counts; the sentence
#. says how much of the total the repetition estimate covers.
#, python-format
msgid "Covers %(checked)s of %(total)s word"
msgid_plural "Covers %(checked)s of %(total)s words"
msgstr[0] "%(total)s개 단어 중 %(checked)s개를 포함합니다"

#. Translators: the button that starts a crawl of the address typed in (a
#. verb).
#. the button that starts counting a website (a verb).
msgctxt "button"
msgid "Crawl"
msgstr "크롤링하기"

#. a table column of crawls (a noun).
msgctxt "noun"
msgid "Crawl"
msgstr "크롤링하기"

msgid "Crawl a site"
msgstr "사이트 크롤링하기"

msgid ""
"Crawl a website and count every word it contains — total, per page, per "
"folder."
msgstr "웹사이트를 크롤링해 전체, 페이지별, 폴더별 단어 수를 확인합니다."

msgid "Crawl another site"
msgstr "다른 사이트 크롤링하기"

msgid ""
"Crawl any website and count every word — per page, per folder, in total. "
"Built for sizing translation projects, with CSV export and a shareable "
"report."
msgstr ""
"어떤 웹사이트든 크롤링하여 모든 단어를 세어 보세요 — 페이지별, 폴더별, 전체 합계까지. 번역 프로젝트 규모 산정을 위해 "
"제작되었으며, CSV 내보내기와 공유 가능한 보고서를 제공합니다."

msgid ""
"Crawl any website and export every page as clean Markdown in a single "
"ZIP. Main content only — ready to feed a language model, a RAG pipeline "
"or a CMS migration."
msgstr ""
"어떤 웹사이트든 크롤링하고 모든 페이지를 깔끔한 Markdown으로 변환해 하나의 ZIP 파일로 내보냅니다. 주요 콘텐츠만 — 언어"
" 모델, RAG 파이프라인 또는 CMS 마이그레이션에 바로 사용할 수 있습니다."

msgid "Crawl didn’t finish: counted only for what the other sites don’t have"
msgstr "크롤링이 완료되지 않았습니다: 다른 사이트에 없는 항목만 집계했습니다"

msgid "Crawl failed"
msgstr "크롤링 실패"

#. Translators: the heading of the email sent when a crawl ends, and the
#. start of its subject line.
msgid "Crawl finished"
msgstr "크롤링 완료"

msgid "Crawl stopped"
msgstr "크롤링이 중지되었습니다."

msgid "Crawled"
msgstr "크롤링 완료"

#. %(url)s is the address the crawl started from.
#, python-format
msgid "Crawled from %(url)s — only you see this."
msgstr "%(url)s에서 크롤링됨 — 나만 볼 수 있습니다."

msgid "Crawled signed in on the site’s sign-in page"
msgstr "사이트의 로그인 페이지에서 로그인한 상태로 크롤링됨"

#. Translators: %(date)s is the date and time of the crawl.
#, python-format
msgid "Crawled: %(date)s"
msgstr "크롤링 완료: %(date)s"

#. Translators: status badge: the crawl is reading pages right now.
msgid "Crawling"
msgstr "크롤링"

msgid "Crawls"
msgstr "크롤링 실행 횟수"

msgid "Crawls run at full speed"
msgstr "크롤링이 최고 속도로 실행됩니다"

msgid "Create"
msgstr "만들기"

msgid "Cursor — in ~/.cursor/mcp.json:"
msgstr "Cursor — ~/.cursor/mcp.json에서:"

msgid "Cursor, VS Code and others"
msgstr "Cursor, VS Code 및 기타 항목"

msgid ""
"Custom MCP servers depend on your ChatGPT plan and, in a workspace, on "
"what your admin allows."
msgstr "맞춤 MCP 서버는 사용 중인 ChatGPT 요금제에 따라 달라지며, 워크스페이스에서는 관리자가 허용한 항목에 따라 달라집니다."

#. Translators: the language row for pages with no language in their address.
msgid "Default"
msgstr "기본값"

msgid "Delete project"
msgstr "프로젝트 삭제"

msgid "Delete run"
msgstr "실행 삭제"

#. Translators: %(site)s is the address of the site that was crawled.
#, python-format
msgid "Delete this crawl of %(site)s? This can’t be undone."
msgstr "%(site)s의 이 크롤링을 삭제하시겠습니까? 이 작업은 되돌릴 수 없습니다."

msgid ""
"Delete this project? Its crawls stay, in your runs and in any other "
"project."
msgstr "이 프로젝트를 삭제하시겠습니까? 크롤링 기록은 실행 내역과 다른 모든 프로젝트에 그대로 유지됩니다."

msgid "Delete this run and everything saved with it? This cannot be undone."
msgstr "이 실행과 함께 저장된 모든 항목을 삭제하시겠습니까? 이 작업은 취소할 수 없습니다."

msgid "Deleting…"
msgstr "삭제 중…"

msgid "Detected platform"
msgstr "감지된 플랫폼"

#. Translators: %(cms)s is a platform's name, such as WordPress.
#, python-format
msgid "Detected platform: %(cms)s"
msgstr "감지된 플랫폼: %(cms)s"

msgid "Detected platform: Contentful (headless — sitemap conventions vary)"
msgstr "감지된 플랫폼: Contentful(헤드리스 — 사이트맵 규칙은 다를 수 있음)"

msgid ""
"Didn’t finish: adds only the pages and sentences the crawls above don’t "
"have."
msgstr "완료되지 않음: 위 크롤링에 없는 페이지만 추가합니다."

msgid "Didn’t load when the crawler asked for them."
msgstr "크롤러가 요청했을 때 로드되지 않았습니다."

msgid ""
"Different pages, but at least half of their words are sentences another "
"crawl has."
msgstr "페이지는 다르지만, 단어의 절반 이상이 다른 크롤링에 포함된 문장입니다."

msgid "Differs only by numbers"
msgstr "숫자만 다릅니다"

msgid "Download Markdown"
msgstr "마크다운 다운로드"

#. Translators: a button; %(size)s is a file size such as "12 MB".
#, python-format
msgid "Download Markdown · %(size)s"
msgstr "마크다운 다운로드 · %(size)s"

msgid "Download every page, with its new words (CSV)"
msgstr "새 단어가 포함된 모든 페이지 다운로드(CSV)"

msgid "Download the pages in more than one crawl (CSV)"
msgstr "두 번 이상의 크롤링에서 페이지 다운로드(CSV)"

msgid "Download the repeated sentences (CSV)"
msgstr "반복 문장 다운로드(CSV)"

msgid "Duplicate of a page already counted"
msgstr "이미 집계된 페이지의 중복 항목"

msgid "Duplicate pages"
msgstr "중복 페이지"

msgid "Duplicate pages within a crawl"
msgstr "크롤링 내 중복 페이지들"

msgid "Duplicate · listed separately"
msgstr "중복 · 별도 항목으로 표시됨"

msgid ""
"Each page is opened in a real browser and counted only once it has "
"finished loading — usually a second or two more per page. Tools that read"
" a page the moment it appears finish sooner, but miss text that loads "
"afterwards; on some sites that’s whole sections."
msgstr ""
"각 페이지는 실제 브라우저에서 열리며, 로딩이 완료된 후에만 한 번 계산됩니다. 페이지당 보통 1~2초 정도 더 걸립니다. 페이지가"
" 표시되는 즉시 읽는 도구는 더 빨리 완료되지만, 나중에 로드되는 텍스트는 놓칩니다. 일부 사이트에서는 섹션 전체를 놓치기도 "
"합니다."

msgid ""
"Each page is opened in a real browser and counted only once it has "
"finished loading — usually a second or two more per page. Tools that read"
" a page the moment it appears finish sooner, but miss text that loads "
"afterwards; on some sites that’s whole sections. You don’t have to wait: "
"if you’re signed in, you’ll get an email when the crawl finishes."
msgstr ""
"각 페이지는 실제 브라우저에서 열리며, 로딩이 완료된 후에만 한 번 계산됩니다. 페이지당 보통 1~2초 정도 더 걸립니다. 페이지가"
" 표시되는 즉시 읽는 도구는 더 빨리 작업을 마치지만, 나중에 로드되는 텍스트는 놓칩니다. 일부 사이트에서는 섹션 전체를 놓치기도 "
"합니다. 기다리실 필요 없습니다. 로그인되어 있으면 크롤링이 완료될 때 이메일을 보내드립니다."

msgid ""
"Each page runs through a content filter that drops navigation and "
"repeated chrome. That's the difference between a corpus you can search "
"and one where every document matches the phrase “Book Now”."
msgstr ""
"각 페이지는 탐색 요소와 반복되는 공통 UI를 제거하는 콘텐츠 필터를 거칩니다. 검색할 수 있는 말뭉치와 모든 문서에 “Book "
"Now”라는 문구가 포함된 말뭉치의 차이가 바로 이것입니다."

msgid ""
"Each site’s own report has its pages, its repetition estimate and what it"
" left out."
msgstr "각 사이트의 자체 보고서에는 페이지, 반복 횟수 추정치, 누락된 항목이 포함됩니다."

msgid "Easy server load"
msgstr "간편한 서버 부하 관리"

msgid "Email"
msgstr "이메일"

msgid "Email or username"
msgstr "이메일 또는 사용자 이름"

#. Translators: write the numbers the way your language does
#. (662.000 in German, 662 000 in French). "Tokens" are the units a
#. language model reads.
msgid ""
"English runs near 1.3 tokens per word. A 662,000-word site is about "
"880,000 tokens of clean text — as raw HTML it would be several times "
"that, nearly all of it markup."
msgstr ""
"영어는 단어당 토큰 수가 약 1.3개입니다. 662,000단어 분량의 사이트는 정제된 텍스트 기준으로 약 880,000토큰입니다. "
"원시 HTML로는 그 몇 배에 달하며, 거의 대부분이 마크업입니다."

msgid "Enter a web address, such as https://www.example.com."
msgstr "https://www.example.com과 같은 웹 주소를 입력하세요."

msgid "Enter an email address to send the report to."
msgstr "보고서를 보낼 이메일 주소를 입력하세요."

msgid "Enter both the email (or username) and the password."
msgstr "이메일(또는 사용자 이름)과 비밀번호를 모두 입력하세요."

msgid "Enter the sign-in page as a web address, like https://example.com/login."
msgstr "로그인 페이지의 웹 주소를 입력하세요(예: https://example.com/login)."

msgid "Enter your website URL"
msgstr "웹사이트 URL을 입력하세요."

msgid "Estimate confidence"
msgstr "신뢰도 추정하기"

msgid "Estimate — before you crawl"
msgstr "크롤링 전에 예상하기"

#. %(sites)s is a list of site names.
#, python-format
msgid ""
"Estimated from saved Markdown: %(sites)s. These crawls are from before "
"crawls kept their sentences, so their sentences come from the Markdown "
"they saved — main content only — and each page’s words are split in the "
"same proportions. A new crawl gives exact figures."
msgstr ""
"저장된 Markdown 기준 예상치: %(sites)s. 이 크롤링은 크롤링에서 문장을 보존하기 전의 것이므로, 문장은 저장된 "
"Markdown의 주요 콘텐츠에서 가져오며 각 페이지의 단어는 동일한 비율로 나뉩니다. 새 크롤링으로 정확한 수치를 확인할 수 "
"있습니다."

msgid "Estimated total"
msgstr "예상 총계"

msgid "Estimated total pages"
msgstr "예상 총 페이지 수"

msgid "Estimated total time"
msgstr "예상 총 소요 시간"

msgid ""
"Every file opens with the URL it came from, so nothing loses its source "
"on the way into a retrieval pipeline."
msgstr "모든 파일은 가져온 URL과 함께 열리므로 검색 파이프라인으로 전달되는 과정에서 출처가 누락되지 않습니다."

#. %(n)s is a number of pages fetched, in a card comparing two ways of
#. counting.
#, python-format
msgid "Every language crawled: %(n)s page."
msgid_plural "Every language crawled: %(n)s pages."
msgstr[0] "크롤링한 모든 언어: 페이지 %(n)s개."

msgid ""
"Every page is rendered in a real browser, so content built by JavaScript "
"is counted. Tools that only fetch HTML report a fraction of the truth."
msgstr ""
"모든 페이지는 실제 브라우저에서 렌더링되므로 JavaScript로 생성된 콘텐츠도 집계됩니다. HTML만 가져오는 도구는 실제 "
"내용의 일부만 보여 줍니다."

msgid "Everything else"
msgstr "그 외 모든 항목"

msgid "Everything in Free"
msgstr "무료 플랜에서 모든 기능 이용 가능"

msgid "Example"
msgstr "예시"

msgid "Exclude subdomains or folders"
msgstr "하위 도메인 또는 폴더 제외"

msgid "Exclude subdomains or folders before continuing"
msgstr "계속하기 전에 하위 도메인이나 폴더를 제외하세요."

#. placeholder of a field of subdomains and folders to leave out; the examples
#. may be adapted.
msgid "Exclude: staging, /careers"
msgstr "제외: 스테이징, /careers"

#. Translators: a pill; %(entries)s is a list such as "staging (subdomain),
#. /careers (folder)".
#, python-format
msgid "Excluded: %(entries)s"
msgstr "제외됨: %(entries)s"

msgid "Excluded: none"
msgstr "제외됨: 없음"

msgid "Export"
msgstr "내보내기"

msgid "Export CSV"
msgstr "CSV 내보내기"

msgid "Failed"
msgstr "실패했습니다"

msgid "Failed to fetch page"
msgstr "페이지를 가져오지 못했습니다."

msgid "Failed to load"
msgstr "로드하지 못했습니다"

#. Translators: %(reason)s is the technical reason a page failed, often in
#. English.
#, python-format
msgid "Failed: %(reason)s"
msgstr "실패: %(reason)s"

msgid "Find out how much work is on your website."
msgstr "웹사이트에 작업이 얼마나 많은지 확인하세요."

msgid ""
"Find your longest pages and most content-heavy folders. Export a CSV with"
" each page’s URL, title and word count to help build your scope."
msgstr ""
"가장 긴 페이지와 콘텐츠가 가장 많은 폴더를 찾아보세요. 범위 설정에 도움이 되도록 각 페이지의 URL, 제목, 단어 수가 포함된 "
"CSV를 내보내세요."

msgid "Folder"
msgstr "폴더"

msgid "Folders"
msgstr "폴더"

msgid ""
"Follows a count that’s still running, and returns the result when it’s "
"done."
msgstr "계속 진행 중인 카운트를 추적하고, 완료되면 결과를 반환합니다."

msgid "Footer · not counted"
msgstr "바닥글 · 집계되지 않음"

msgid "For Claude and ChatGPT"
msgstr "Claude 및 ChatGPT용"

msgid ""
"For a site that asks for a username and password in a browser pop-up, "
"like most staging sites. Sent only to that site, used only for this "
"crawl, never stored."
msgstr ""
"대부분의 스테이징 사이트처럼 브라우저 팝업에서 사용자 이름과 비밀번호를 입력하라는 메시지가 표시되는 사이트에 적합합니다. 해당 "
"사이트에만 전송되며, 이 크롤링에만 사용되고, 저장되지 않습니다."

msgid ""
"For a site where you sign in with an email and password. The crawler "
"signs in before it starts and crawls as that account, so use one that can"
" only read; it never opens a log-out, delete or cancel link. Sent only to"
" that site, used only for this crawl, never stored."
msgstr ""
"이메일과 비밀번호로 로그인하는 사이트용입니다. 크롤러는 시작하기 전에 로그인한 다음 해당 계정으로 크롤링하므로, 읽기 권한만 있는 "
"계정을 사용하세요. 로그아웃, 삭제 또는 취소 링크는 절대 열지 않습니다. 해당 사이트에만 전송되며, 이 크롤링에만 사용되고, "
"저장되지 않습니다."

msgid "For developers"
msgstr "개발자용"

msgid ""
"For staging sites protected by a browser username-and-password pop-up, "
"enter the credentials to run the crawl. They’re sent only to that site, "
"used only for that crawl and never stored."
msgstr ""
"브라우저의 사용자 이름 및 비밀번호 팝업으로 보호되는 스테이징 사이트의 경우, 크롤링을 실행하려면 인증 정보를 입력하세요. 해당 "
"사이트에만 전송되고, 해당 크롤링에만 사용되며, 저장되지 않습니다."

msgid "For your client"
msgstr "고객용"

#, python-format
msgid ""
"Found a sitemap — this site has approximately %(n)s page. Crawling all of"
" them may take a while."
msgid_plural ""
"Found a sitemap — this site has approximately %(n)s pages. Crawling all "
"of them may take a while."
msgstr[0] "사이트맵을 찾았습니다. 이 사이트에는 페이지가 약 %(n)s개 있습니다. 모두 크롤링하는 데 시간이 걸릴 수 있습니다."

msgid "Found while crawling, but not in the total."
msgstr "크롤링 중 발견되었지만 총계에는 포함되지 않았습니다."

msgid "Frameworks and hand-written code"
msgstr "프레임워크 및 직접 작성한 코드"

msgid "Free"
msgstr "무료"

#. %(n)s is a number of words (the size at which a guest crawl pauses).
#, python-format
msgid ""
"Free to use. No sign-up to start. Sites over %(n)s word require Google "
"sign-in to finish."
msgid_plural ""
"Free to use. No sign-up to start. Sites over %(n)s words require Google "
"sign-in to finish."
msgstr[0] ""
"무료로 사용할 수 있습니다. 시작하는 데 가입할 필요가 없습니다. %(n)s단어가 넘는 사이트는 완료하려면 Google에 로그인해야"
" 합니다."

msgid ""
"Free with a Word Counter account. Works with Claude Code, Claude, "
"ChatGPT, Cursor, VS Code and any app that speaks MCP."
msgstr ""
"Word Counter 계정이 있으면 무료로 이용할 수 있습니다. Claude Code, Claude, ChatGPT, "
"Cursor, VS Code 및 MCP를 지원하는 모든 앱과 호환됩니다."

#. %(n)s is a number of words (the size at which a guest crawl pauses).
#, python-format
msgid ""
"Free. No sign-up for sites under %(n)s word. Sign in with Google to "
"finish larger sites."
msgid_plural ""
"Free. No sign-up for sites under %(n)s words. Sign in with Google to "
"finish larger sites."
msgstr[0] "무료. %(n)s단어 미만인 사이트는 가입할 필요가 없습니다. Google로 로그인하여 더 큰 사이트를 완료하세요."

msgid "Full report, every page →"
msgstr "전체 보고서, 모든 페이지 →"

msgid "Get the Markdown"
msgstr "마크다운 받기"

msgid "Get the text without the copy-paste"
msgstr "복사하여 붙여넣지 않고 텍스트 가져오기"

msgid "Get your connection URL"
msgstr "연결 URL 받기"

msgid "Give the project a name."
msgstr "프로젝트 이름을 입력하세요."

msgid "Going through the crawls for the first time…"
msgstr "크롤링을 처음으로 진행하는 중…"

msgid "Good to know"
msgstr "알아두면 좋은 정보"

msgid ""
"Google didn’t send your profile. Try again, and allow access to your name"
" and email."
msgstr "Google에서 프로필을 보내지 않았습니다. 다시 시도하고 이름과 이메일에 대한 액세스를 허용하세요."

msgid "Google sign-in didn’t finish. Try again."
msgstr "Google 로그인 완료되지 않았습니다. 다시 시도하세요."

msgid ""
"Ground a support assistant in your own answers, audit content at a scale "
"nobody can read, brief translators with real terminology, or move "
"platforms without losing the writing."
msgstr ""
"자체 답변을 바탕으로 지원 어시스턴트를 구축하고, 사람이 읽을 수 없는 규모의 콘텐츠를 감사하고, 실제 용어를 활용해 번역가에게 "
"브리핑하거나, 글을 잃지 않고 플랫폼을 이전하세요."

msgid ""
"Groups this crawl with others of the same client: combined totals, each "
"page counted once, and the overlap between crawls. Optional — a run can "
"join a project later, from its report."
msgstr ""
"이 크롤링을 같은 고객의 다른 크롤링과 그룹화합니다. 합산 총계, 페이지별 한 번만 집계, 크롤링 간 중복 항목을 표시합니다. 선택"
" 사항 — 실행은 나중에 보고서에서 프로젝트에 추가할 수 있습니다."

msgid ""
"Hand it to a translator, prepare a CMS migration or use it with an AI "
"tool or search index."
msgstr "번역가에게 전달하거나, CMS 마이그레이션을 준비하거나, AI 도구 또는 검색 색인에 활용하세요."

msgid "Header and menu · not counted"
msgstr "머리글 및 메뉴 · 집계되지 않음"

#. Translators: how sure the word-count estimate is, shown in the email as
#. "Estimate confidence: High".
msgid "High"
msgstr "높음"

msgid "High confidence"
msgstr "높은 신뢰도"

msgid "Host"
msgstr "호스트"

msgid "How long does a count take?"
msgstr "단어 수를 세는 데 얼마나 걸리나요?"

msgid "How many words are in the German part of example.com?"
msgstr "example.com의 독일어 부분에는 단어가 몇 개 있나요?"

msgid "How many words does wxrks.com have?"
msgstr "wxrks.com에는 단어가 몇 개 있나요?"

msgid "How the added-up words split"
msgstr "합산된 단어 수의 분포"

msgid "How the crawls come down to the new words"
msgstr "크롤링 결과에서 새 단어 수를 확인하는 방법"

msgid "I counted every page with Word Counter:"
msgstr "Word Counter로 모든 페이지를 세었습니다:"

msgid ""
"If it opens in a browser, Word Counter can count it — whatever it was "
"built with: a CMS, a site builder, a framework, hand-written code or an "
"AI tool. It also recognises WordPress, Webflow, Drupal, Shopify, "
"Squarespace, Wix, Ghost and Contentful, and names the platform in the "
"report."
msgstr ""
"브라우저에서 열리는 콘텐츠라면 CMS, 사이트 빌더, 프레임워크, 직접 작성한 코드, AI 도구 등 무엇으로 만들었든 Word "
"Counter로 단어 수를 셀 수 있습니다. WordPress, Webflow, Drupal, Shopify, "
"Squarespace, Wix, Ghost, Contentful도 인식하며 보고서에 플랫폼 이름을 표시합니다."

#, python-format
msgid ""
"If your vendor prices by translation memory, the %(new)s new word is the "
"number that matters."
msgid_plural ""
"If your vendor prices by translation memory, the %(new)s new words are "
"the number that matters."
msgstr[0] "공급업체가 번역 메모리 기준으로 가격을 책정한다면, 새 단어 %(new)s개가 중요한 수치입니다."

msgid "In a chat, add Word Counter from the + menu and ask your question."
msgstr "채팅에서 + 메뉴를 열어 Word Counter를 추가하고 질문을 입력하세요."

msgid "In a terminal, add the server with your key in a header:"
msgstr "터미널에서 헤더에 키를 포함해 서버를 추가합니다:"

msgid ""
"Include the whole domain, a single subdomain or just the main site. Leave"
" out folders and subdomains you don’t need, such as /careers, old "
"archives or a staging copy."
msgstr ""
"전체 도메인, 단일 하위 도메인 또는 메인 사이트만 포함합니다. 필요하지 않은 폴더와 하위 도메인은 제외하세요. 예를 들어 "
"/careers, 오래된 아카이브 또는 스테이징 사본이 있습니다."

msgid "Includes content loaded by JavaScript"
msgstr "JavaScript로 로드된 콘텐츠 포함"

msgid ""
"Includes waiting for each page to finish loading, so text that loads late"
" isn’t missed."
msgstr "각 페이지의 로딩이 완료될 때까지 기다리므로 늦게 로드되는 텍스트도 놓치지 않습니다."

#, python-format
msgid "Interactive report: %(url)s"
msgstr "대화형 보고서: %(url)s"

msgid ""
"Into Your runs, like any count you start here — each with its report, "
"every page and a CSV."
msgstr "여기에서 시작한 모든 집계와 마찬가지로 실행 내역에 추가됩니다. 각 실행에는 보고서, 모든 페이지 및 CSV가 포함됩니다."

msgid "Invited"
msgstr "초대됨"

#. Translators: under an invited person's address; %(date)s is when.
#, python-format
msgid "Invited %(date)s"
msgstr "%(date)s에 초대됨"

msgid "Is my URL safe to share?"
msgstr "내 URL을 공유해도 안전한가요?"

msgid "Is our help center bigger than our blog?"
msgstr "도움말 센터가 블로그보다 더 큰가요?"

msgid ""
"It also assumes this app is what's slowing you down. A site that rate-"
"limits or blocks a heavier crawler caps every plan at the same place; the"
" report marks those pages, so you can see when that's what happened."
msgstr ""
"또한 이 앱이 작업 속도를 늦추는 원인이라고 가정합니다. 더 많은 부하를 유발하는 크롤러의 요청 속도를 제한하거나 크롤러를 차단하는"
" 사이트에서는 모든 요금제가 동일한 지점에서 제한됩니다. 보고서에 해당 페이지가 표시되므로, 이런 상황이 발생했는지 확인할 수 "
"있습니다."

msgid "It counts what a translator is handed"
msgstr "번역가가 전달받은 내용을 셉니다."

msgid "It counts what you would translate"
msgstr "번역할 단어 수를 세어 줍니다."

msgid ""
"It follows links the way a visitor does, so it finds the help centers, "
"docs and subdomains a sitemap leaves out."
msgstr "방문자처럼 링크를 따라가므로 사이트맵에 포함되지 않은 고객 지원 센터, 문서 및 하위 도메인도 찾아냅니다."

msgid "It knows what repeats"
msgstr "반복되는 항목을 알아냅니다"

msgid "It reads every page"
msgstr "모든 페이지를 읽습니다."

msgid "It sees pages the way a reader does"
msgstr "독자가 보는 방식 그대로 페이지를 확인합니다"

msgid "Keep the scope under control"
msgstr "범위를 적절히 관리하세요"

msgid "Keep translated copies out of the total"
msgstr "번역된 사본은 총계에서 제외합니다."

msgid "Key — for apps that send it as a header"
msgstr "키 — 헤더로 전송하는 앱용"

msgid "Know how much content you’re dealing with."
msgstr "처리해야 할 콘텐츠의 양을 파악하세요."

msgid "Language"
msgstr "언어"

#. a field for language codes such as en or pt; "auto" means detected
#. automatically.
msgid "Language (auto)"
msgstr "언어(자동)"

#. Translators: a small pill; %(lang)s is a language's name, shown in bold.
#, python-format
msgid "Language: %(lang)s"
msgstr "언어: %(lang)s"

#. Translators: a small pill; %(lang)s is the language the crawler detected, in
#. bold.
#, python-format
msgid "Language: %(lang)s (auto)"
msgstr "언어: %(lang)s (자동)"

msgid "Languages"
msgstr "언어"

#. Translators: a small pill; %(primary)s is the first language (bold),
#. %(rest)s a list of the others.
#, python-format
msgid "Languages: %(primary)s + %(rest)s"
msgstr "언어: %(primary)s + %(rest)s"

#. Translators: a small pill on the report; keep it short.
msgid "Languages: All"
msgstr "언어: 전체"

msgid ""
"Leave the advanced settings empty and add it. In a chat, make sure Word "
"Counter is switched on in the tools menu. On the Free plan Claude allows "
"one custom connector."
msgstr ""
"고급 설정을 비워 둔 채 추가합니다. 채팅에서 도구 메뉴의 Word Counter가 켜져 있는지 확인하세요. 무료 요금제에서는 "
"Claude에서 사용자 지정 커넥터를 하나 사용할 수 있습니다."

msgid "Left out"
msgstr "제외됨"

msgid "Linked but not crawled"
msgstr "연결되었지만 크롤링되지 않음"

msgid ""
"Linked from the pages crawled but not counted — outside this run’s "
"settings, excluded, or not reached before it stopped."
msgstr ""
"크롤링한 페이지에서 링크되었지만 집계되지 않은 페이지 — 이번 실행의 설정 범위를 벗어났거나, 제외되었거나, 실행이 중단되기 전에 "
"도달하지 못했습니다."

msgid "Linked subdomains not crawled"
msgstr "연결된 하위 도메인은 크롤링되지 않음"

msgid "List the 20 longest pages under example.com/blog."
msgstr "example.com/blog에서 가장 긴 페이지 20개를 나열합니다."

msgid "Loading…"
msgstr "불러오는 중…"

msgid "Log out"
msgstr "로그아웃"

msgid "Low"
msgstr "낮음"

msgid "Low confidence"
msgstr "신뢰도 낮음"

msgid "MCP server"
msgstr "MCP 서버"

msgid "Main content, not the whole page"
msgstr "페이지 전체가 아닌 주요 콘텐츠"

msgid ""
"Main page content only — site navigation, footers and other repeated "
"chrome are stripped. Each file starts with the URL it came from."
msgstr ""
"메인 페이지 콘텐츠만 — 사이트 탐색 메뉴, 바닥글 및 기타 반복되는 인터페이스 요소는 제외됩니다. 각 파일은 해당 파일의 출처 "
"URL로 시작합니다."

msgid "Main site"
msgstr "메인 사이트"

msgid "Make a connection"
msgstr "연결하기"

msgid ""
"Make a connection for each app you use. Each one has its own URL and key,"
" and you can revoke it without touching the others."
msgstr ""
"사용하는 각 앱을 연결하세요. 각 항목에는 고유한 URL과 키가 있으며, 다른 항목에 영향을 주지 않고 해당 항목만 취소할 수 "
"있습니다."

msgid "Manage billing"
msgstr "결제 관리하기"

msgid "Manage subscription"
msgstr "구독 관리"

msgid ""
"Many sites keep adding content after a page appears. Each page is counted"
" only once it has finished loading, so lists, tabs and sections that load"
" late are included. It takes a little longer, and the count is more "
"complete."
msgstr ""
"많은 사이트는 페이지가 표시된 후에도 계속 콘텐츠를 추가합니다. 각 페이지는 로딩이 완료된 후에만 집계되므로, 늦게 로드되는 목록,"
" 탭, 섹션도 포함됩니다. 시간이 조금 더 걸리지만, 단어 수가 더 정확합니다."

msgid "Markdown saved"
msgstr "마크다운 저장됨"

#, python-format
msgid ""
"Markdown was saved for the first %(n)s page, then stopped because of an "
"error while saving. The word count below is complete either way."
msgid_plural ""
"Markdown was saved for the first %(n)s pages, then stopped because of an "
"error while saving. The word count below is complete either way."
msgstr[0] ""
"처음 %(n)s개 페이지의 Markdown이 저장된 후, 저장 중 오류가 발생해 작업이 중단되었습니다. 아래 단어 수는 어느 쪽이든"
" 전체 단어 수입니다."

#, python-format
msgid ""
"Markdown was saved for the first %(n)s page, then stopped because the "
"per-crawl size limit was reached. The word count below is complete either"
" way."
msgid_plural ""
"Markdown was saved for the first %(n)s pages, then stopped because the "
"per-crawl size limit was reached. The word count below is complete either"
" way."
msgstr[0] ""
"크롤당 크기 제한에 도달해 중단되기 전까지 처음 %(n)s개 페이지의 Markdown이 저장되었습니다. 아래 단어 수는 어느 쪽이든"
" 전체 단어 수입니다."

#, python-format
msgid ""
"Markdown was saved for the first %(n)s page, then stopped because the "
"server was running low on disk space. The word count below is complete "
"either way."
msgid_plural ""
"Markdown was saved for the first %(n)s pages, then stopped because the "
"server was running low on disk space. The word count below is complete "
"either way."
msgstr[0] ""
"처음 %(n)s개 페이지의 Markdown이 저장된 후, 서버의 디스크 공간이 부족해져 작업이 중단되었습니다. 아래 단어 수는 어느"
" 쪽이든 전체 단어 수입니다."

#, python-format
msgid ""
"Markdown was saved for the first %(n)s page, then stopped because the "
"server's total Markdown limit was reached. The word count below is "
"complete either way."
msgid_plural ""
"Markdown was saved for the first %(n)s pages, then stopped because the "
"server's total Markdown limit was reached. The word count below is "
"complete either way."
msgstr[0] ""
"처음 %(n)s개 페이지의 Markdown이 저장된 후 서버의 전체 Markdown 한도에 도달하여 작업이 중단되었습니다. 아래 "
"단어 수는 어느 쪽이든 전체 단어 수입니다."

msgid "Matching pages…"
msgstr "페이지를 일치시키는 중…"

msgid "Measured only when asked."
msgstr "요청 시에만 측정합니다."

msgid "Medium"
msgstr "중간"

msgid "Medium confidence"
msgstr "중간 신뢰도"

msgid "Member logins aren’t supported."
msgstr "회원 로그인은 지원되지 않습니다."

msgid "Member-only content stays out."
msgstr "회원 전용 콘텐츠는 제외됩니다."

#. %(n)s is a percentage.
#, python-format
msgid ""
"Menu and footer counted on every page: %(n)s%% more than the text people "
"read"
msgstr "모든 페이지에서 메뉴와 푸터를 포함해 집계: 실제로 읽는 텍스트보다 %(n)s%% 더 많음"

msgid "Menus, footers and forms, which repeat on every page."
msgstr "모든 페이지에 반복되는 메뉴, 푸터 및 양식."

msgid "Moderate server load"
msgstr "서버 부하 보통"

msgid "More"
msgstr "더 보기"

msgid "More actions"
msgstr "더 많은 작업"

msgid ""
"More pages fetched at once, and it starts ahead of the queue. Everything "
"else about the crawl is identical."
msgstr "한 번에 더 많은 페이지를 가져오고 대기열보다 먼저 시작합니다. 크롤링의 다른 모든 사항은 동일합니다."

msgid "Most repeated text"
msgstr "가장 많이 반복된 텍스트"

msgid "Name it Word Counter and paste your personal URL:"
msgstr "Word Counter라고 이름을 지정하고 개인 URL을 붙여넣으세요:"

#. Translators: write the numbers the way your language does.
msgid ""
"Navigation, footers, sidebars and forms are stripped before counting, so "
"a 500-page site doesn't inflate by the same menu repeated 500 times."
msgstr ""
"계산 전에 내비게이션, 푸터, 사이드바, 양식은 제거되므로, 500페이지 사이트에서 같은 메뉴가 500번 반복되어도 단어 수가 "
"부풀려지지 않습니다."

msgid ""
"Need the content as well as the count? Select Save Markdown to download "
"each page’s main text as a separate file, with its source URL included, "
"all in one ZIP."
msgstr ""
"단어 수뿐 아니라 콘텐츠도 필요하신가요? 각 페이지의 본문을 별도 파일로 다운로드하고 원본 URL을 포함해 하나의 ZIP 파일로 "
"받으려면 Markdown 저장을 선택하세요."

msgid "New"
msgstr "새로 만들기"

msgid "New crawl"
msgstr "새 크롤링"

msgid "New project name"
msgstr "새 프로젝트 이름"

msgid "New project, e.g. the client’s name"
msgstr "새 프로젝트(예: 고객 이름)"

msgid "New project…"
msgstr "새 프로젝트…"

msgid "New words"
msgstr "새 단어"

msgid "New words and repeated words"
msgstr "새 단어 및 반복된 단어"

msgid "Newest first"
msgstr "최신순"

msgid ""
"No crawler on your laptop and no AI usage spent fetching pages. Close the"
" tab: if you’re signed in, you’ll get an email when it’s done."
msgstr ""
"노트북에서 크롤러를 실행할 필요가 없으며, 페이지를 가져오는 데 AI 사용량도 소모되지 않습니다. 탭을 닫으세요. 로그인한 상태라면"
" 완료 시 이메일을 받게 됩니다."

msgid "No crawls in this project yet"
msgstr "이 프로젝트에는 아직 크롤링이 없습니다."

#. keep the <a href="%(href)s"> and </a> tags around the words that link to a
#. new crawl.
#, python-format
msgid "No crawls yet — <a href=\"%(href)s\">start one</a>."
msgstr "아직 크롤링이 없습니다 — <a href=\"%(href)s\">크롤링을 시작하세요</a>."

msgid "No crawls yet — add some from the project."
msgstr "아직 크롤링이 없습니다 — 프로젝트에서 추가하세요."

msgid "No crawls yet — try one above."
msgstr "아직 크롤링이 없습니다 — 위에서 크롤링을 시작해 보세요."

msgid "No finished crawls in this project yet."
msgstr "이 프로젝트에는 아직 완료된 크롤링이 없습니다."

msgid "No further detail was recorded."
msgstr "추가 세부 정보가 기록되지 않았습니다."

msgid "No other subdomains were linked from the pages crawled."
msgstr "크롤링한 페이지에서 다른 하위 도메인으로 연결된 링크가 없습니다."

msgid "No page or sentence is in more than one crawl."
msgstr "한 번의 크롤링에서 여러 페이지나 문장에 중복으로 포함되지 않습니다."

msgid "No pages counted yet."
msgstr "아직 집계된 페이지가 없습니다."

msgid "No project"
msgstr "프로젝트 없음"

msgid ""
"No projects yet. Make one above, then add crawls to it — from the project"
" page, or from any report’s ⋯ menu."
msgstr "아직 프로젝트가 없습니다. 위에서 하나 만든 다음, 프로젝트 페이지나 각 보고서의 ⋯ 메뉴에서 크롤링을 추가하세요."

msgid "No sentence is in more than one crawl."
msgstr "어떤 문장도 두 번 이상의 크롤링에 포함되지 않습니다."

#, python-format
msgid ""
"No sitemap found — this estimate is based only on pages discovered so far"
" (approximately %(n)s), so it may be less accurate. Crawling all of them "
"may take a while."
msgid_plural ""
"No sitemap found — this estimate is based only on pages discovered so far"
" (approximately %(n)s), so it may be less accurate. Crawling all of them "
"may take a while."
msgstr[0] ""
"사이트맵을 찾을 수 없습니다 — 이 예상치는 지금까지 발견된 페이지(약 %(n)s개)만을 기준으로 하므로 정확도가 낮을 수 "
"있습니다. 모두 크롤링하는 데 시간이 걸릴 수 있습니다."

msgid "No sitemap needed"
msgstr "사이트맵이 필요하지 않습니다."

msgid ""
"No — treat it like a password: anyone with it can count as you. You can "
"revoke it at any time and make a new one."
msgstr ""
"아니요 — 비밀번호처럼 취급하세요. 이 정보를 가진 사람은 누구나 귀하인 것처럼 단어를 셀 수 있습니다. 언제든지 이를 취소하고 "
"새로 만들 수 있습니다."

msgid "Nobody knows how many words are on their website."
msgstr "자신의 웹사이트에 단어가 몇 개 있는지 아는 사람은 없습니다."

msgid "None found. It trusted the sitemap."
msgstr "찾을 수 없음. 사이트맵을 신뢰했습니다."

msgid "None yet."
msgstr "아직 없습니다."

msgid "Not checked"
msgstr "확인되지 않음"

msgid "Not counted"
msgstr "계산되지 않음"

msgid "Not found"
msgstr "찾을 수 없음"

msgid "Not in the total"
msgstr "총계에 포함되지 않음"

msgid "Not in this count"
msgstr "이 개수에 포함되지 않음"

msgid ""
"Not the marketing lead, not the person who built it, and not the agency "
"about to quote you for translating it. Point this at a URL and find out —"
" page by page, folder by folder."
msgstr ""
"마케팅 책임자도, 웹사이트를 만든 사람도, 번역 견적을 내려고 하는 에이전시도 아닙니다. URL을 입력하면 페이지별, 폴더별로 "
"확인할 수 있습니다."

msgid ""
"Nothing could be counted because the starting page itself couldn't be "
"accessed. If you know another page on this site that might be more "
"accessible (e.g. a blog post or inner page rather than the homepage), try"
" starting the crawl from that URL instead."
msgstr ""
"시작 페이지에 액세스할 수 없어 아무것도 셀 수 없습니다. 이 사이트에서 더 쉽게 접근할 수 있는 다른 페이지(예: 홈페이지 대신 "
"블로그 게시물이나 내부 페이지)를 알고 있다면 해당 URL에서 크롤링을 시작해 보세요."

msgid "Nothing extra: the same as counting on the website. Pro counts run faster."
msgstr "추가 기능 없이 웹사이트에서 세는 것과 동일합니다. Pro에서는 실행 횟수가 더 빠르게 집계됩니다."

msgid "Nothing left out"
msgstr "누락된 항목 없음"

msgid "Older →"
msgstr "이전 →"

msgid ""
"On its own, an assistant estimates from the pages it opens — or, in "
"Claude Code, writes a one-off crawler that counts the menu on every page."
" Word Counter follows every link and the sitemap until there is nothing "
"left to read."
msgstr ""
"단독으로는 어시스턴트가 열어 보는 페이지를 바탕으로 추정하거나, Claude Code에서는 각 페이지의 메뉴를 세는 일회성 크롤러를"
" 작성합니다. Word Counter는 더 이상 읽을 내용이 없을 때까지 모든 링크와 사이트맵을 따라갑니다."

msgid ""
"One client, every crawl that belongs to it, and the number that counts "
"each page once."
msgstr "클라이언트 하나, 해당 클라이언트에 속한 모든 크롤링, 각 페이지를 한 번씩만 계산하는 숫자입니다."

msgid "One file per page, provenance intact"
msgstr "페이지당 파일 하나, 출처 정보 유지"

msgid "One subdomain"
msgstr "하위 도메인 1개"

msgid ""
"Only crawl this language’s pages, for sites with a /en/, /fr/, ... path "
"per language. Leave blank to auto-detect the starting page’s language."
msgstr ""
"언어별로 /en/, /fr/ 등의 경로가 있는 사이트에서 이 언어의 페이지만 크롤링합니다. 시작 페이지의 언어를 자동 감지하려면 "
"비워 두세요."

msgid ""
"Only crawl this language’s pages, for sites with a /en/, /fr/, ... path "
"per language. Leave blank to auto-detect the starting page’s language. "
"Comma-separate multiple codes to keep more than one (e.g. en, pt, es)."
msgstr ""
"언어별로 /en/, /fr/ 등의 경로가 있는 사이트에서 이 언어의 페이지만 크롤링합니다. 시작 페이지의 언어를 자동 감지하려면 "
"비워 두세요. 여러 코드를 유지하려면 쉼표로 구분하세요(예: en, pt, es)."

msgid ""
"Open Plugins and choose + → Add custom MCP server. (Some accounts have it"
" under Settings → Apps & Connectors → Advanced → Developer mode → "
"Create.)"
msgstr ""
"플러그인을 열고 + → 사용자 지정 MCP 서버 추가를 선택합니다. (일부 계정에서는 설정 → 앱 및 커넥터 → 고급 → 개발자 "
"모드 → 만들기에서 찾을 수 있습니다.)"

msgid "Open Settings → Connectors (on some versions, Customize → Connectors)."
msgstr "설정 → 커넥터를 여세요(일부 버전에서는 맞춤 설정 → 커넥터)."

#. Translators: a link that opens the crawled page in a new tab.
msgid "Open ↗"
msgstr "열기 ↗"

msgid "Opening checkout…"
msgstr "결제 페이지를 여는 중…"

#. above the report's address, for mail apps that hide the button.
msgid "Or paste this into your browser:"
msgstr "또는 브라우저에 붙여넣으세요:"

msgid "Overview"
msgstr "개요\n"

msgid "Owner"
msgstr "소유자"

msgid "PDFs, Word and Excel files, images and videos aren’t counted."
msgstr "PDF, Word 및 Excel 파일, 이미지와 동영상은 계산되지 않습니다."

msgid "Page"
msgstr "페이지"

#, python-format
msgid "Page %(page)s of %(total)s"
msgstr "%(total)s페이지 중 %(page)s페이지"

msgid ""
"Page counts only tell you so much. Some pages have a paragraph. Others "
"have thousands of words. Opening them one by one takes time you could "
"spend doing the work."
msgstr ""
"페이지 수만으로는 알 수 있는 정보가 제한적입니다. 일부 페이지에는 단락이 있습니다. 다른 사이트에는 수천 개의 단어가 있습니다. "
"하나씩 열어 보면 작업에 쓸 시간을 낭비하게 됩니다."

msgid "Pages"
msgstr "페이지"

msgid "Pages appear below as they’re read."
msgstr "페이지는 읽히는 대로 아래에 표시됩니다."

msgid ""
"Pages behind a login or blocked by the site are listed separately, so you"
" can see what the total leaves out."
msgstr "로그인 뒤에 있거나 사이트에서 차단된 페이지는 별도로 표시되므로, 전체 페이지 수에 포함되지 않은 항목을 확인할 수 있습니다."

msgid "Pages behind a sign-in"
msgstr "로그인해야 볼 수 있는 페이지들"

msgid "Pages counted"
msgstr "계산된 페이지 수"

msgid "Pages fetched so far"
msgstr "현재까지 가져온 페이지 수"

msgid "Pages in more than one crawl"
msgstr "둘 이상의 크롤링에 포함된 페이지"

#. Translators: %(saved)s is how many pages are in the download and
#. %(total)s how many the crawl counted.
#, python-format
msgid "Pages in this archive: %(saved)s of %(total)s crawled"
msgid_plural "Pages in this archive: %(saved)s of %(total)s crawled"
msgstr[0] "이 보관 파일의 페이지: 크롤링한 %(total)s개 중 %(saved)s개"

msgid "Pages mostly repeated from another crawl"
msgstr "다른 크롤링에서 대부분 반복된 페이지들"

msgid "Pages need a link to be found."
msgstr "페이지가 검색되려면 링크가 필요합니다."

msgid ""
"Pages open in Chrome, so text that appears after JavaScript runs can be "
"counted too."
msgstr "페이지가 Chrome에서 열리므로 JavaScript 실행 후 표시되는 텍스트도 셀 수 있습니다."

msgid "Pages requiring a member login are listed but can’t be read."
msgstr "회원 로그인이 필요한 페이지는 목록에 표시되지만 읽을 수 없습니다."

msgid "Pages so far"
msgstr "현재까지의 페이지 수"

msgid "Pages with no links pointing to them may be missed."
msgstr "링크가 연결되지 않은 페이지는 누락될 수 있습니다."

msgid ""
"Part of this is estimated: some sites were crawled before their sentences"
" were kept, so their repetition is worked out from their main content."
msgstr "이 중 일부는 추정치입니다. 일부 사이트는 문장을 보관하기 전에 크롤링되었으므로, 반복 횟수는 주요 콘텐츠를 바탕으로 계산됩니다."

msgid "Password"
msgstr "비밀번호"

msgid "Password-protected"
msgstr "비밀번호로 보호됨"

msgid "Password-protected site"
msgstr "비밀번호로 보호된 사이트"

msgid "Paused"
msgstr "일시 중지됨"

#. a crawl stops here to show its estimate. %(n)s is a number of words.
#, python-format
msgid "Paused at %(n)s word"
msgid_plural "Paused at %(n)s words"
msgstr[0] "%(n)s개 단어에서 일시 중지됨"

msgid "People with access"
msgstr "액세스 권한이 있는 사용자"

msgid "Personal URL — for Claude, ChatGPT and apps that only take a URL"
msgstr "개인 URL — Claude, ChatGPT 및 URL만 입력할 수 있는 앱용"

msgid "Pick your app below and paste it in. It takes a minute."
msgstr "아래에서 앱을 선택한 다음 붙여넣으세요. 1분 정도 걸립니다."

msgid "Plans for teams of every size, billed monthly or yearly."
msgstr "모든 규모의 팀을 위한 요금제, 월간 또는 연간 결제 가능."

msgid "Please enter a valid http(s) URL"
msgstr "유효한 http(s) URL을 입력해 주세요."

msgid ""
"Point this at a URL and get every page back as Markdown, in one ZIP — "
"main content only, no navigation, no cookie banners, no markup burning "
"tokens without carrying meaning."
msgstr ""
"URL을 지정하면 모든 페이지를 Markdown으로 변환해 하나의 ZIP 파일로 받아볼 수 있습니다. 주요 콘텐츠만 포함되며, 탐색"
" 메뉴나 쿠키 배너, 의미 없이 토큰만 차지하는 마크업은 제외됩니다."

msgid "Preparing…"
msgstr "준비 중…"

msgid ""
"Press Enter or comma to add one. A leading / excludes a folder, anything "
"else a subdomain — each entry is labelled with how it will be treated. "
"Applies to the rest of this crawl; pages already counted stay counted."
msgstr ""
"하나를 추가하려면 Enter 또는 쉼표를 누르세요. 앞에 /가 있으면 폴더를 제외하고, 그 외의 항목은 하위 도메인으로 처리합니다."
" 각 항목에는 처리 방식이 표시됩니다. 이 크롤링의 나머지 부분에 적용됩니다. 이미 계산된 페이지는 계속 계산된 상태로 유지됩니다."

msgid "Preview"
msgstr "미리보기"

msgid "Pricing"
msgstr "요금제"

#. a field for language codes such as en or pt; "auto" means detected
#. automatically.
msgid "Primary language (auto)"
msgstr "기본 언어(자동)"

msgid "Print"
msgstr "인쇄"

msgid "Print report"
msgstr "보고서 인쇄"

msgid "Pro"
msgstr "Pro"

msgid "Proceed with crawl"
msgstr "크롤링 진행하기"

msgid "Project"
msgstr "프로젝트"

msgid "Project name"
msgstr "프로젝트 이름"

msgid "Projects"
msgstr "프로젝트"

msgid "Public link"
msgstr "공개 링크"

msgid "Questions people ask"
msgstr "자주 묻는 질문"

msgid "Queued"
msgstr "대기열에 추가됨"

msgid "Quote with a word count behind you"
msgstr "단어 수를 확인한 후 견적을 받아보세요"

msgid ""
"Quoting a translation, planning a website rewrite or moving to a new CMS?"
" Get a word count for your site, broken down by page and folder, so you "
"can scope the work before you commit."
msgstr ""
"번역 견적을 내거나, 웹사이트 개편을 계획하거나, 새 CMS로 이전하시나요? 작업을 확정하기 전에 사이트의 단어 수를 페이지와 "
"폴더별로 확인해 작업 범위를 파악하세요."

msgid "Re-crawl"
msgstr "다시 크롤링하기"

#. menu items that open a form or a dialog, hence the ellipsis.
msgid "Re-crawl…"
msgstr "다시 크롤링…"

msgid "Re-run to check every word"
msgstr "모든 단어를 확인하려면 다시 실행하세요"

msgid "Read how Claude does with and without it →"
msgstr "Claude가 이를 사용할 때와 사용하지 않을 때 어떻게 작동하는지 확인하세요 →"

msgid ""
"Read in this order, each crawl adds what the ones above it don’t have: "
"completed crawls first, newest first; a crawl that didn’t finish only "
"fills the gaps. Of a site crawled twice, the latest completed crawl "
"counts."
msgstr ""
"위에서부터 순서대로 읽습니다. 각 크롤링은 위에 있는 크롤링에 없는 내용만 추가합니다. 완료된 크롤링을 먼저 최신순으로 표시하고, "
"완료되지 않은 크롤링은 누락된 부분만 채웁니다. 사이트를 두 번 크롤링한 경우, 가장 최근에 완료된 크롤링이 집계됩니다."

msgid "Reading sentences…"
msgstr "문장을 읽는 중…"

msgid "Reading the crawls…"
msgstr "크롤링을 읽는 중…"

msgid "Ready for whatever comes next"
msgstr "다음에 무엇이 오든 준비 완료"

msgid "Remove"
msgstr "제거하기"

#. Translators: the × beside an invited person; %(email)s is their address.
#, python-format
msgid "Remove %(email)s"
msgstr "%(email)s 삭제하기"

#. Translators: the × on an exclusion chip; %(entry)s is what was typed, such
#. as /careers.
#, python-format
msgid "Remove %(entry)s"
msgstr "%(entry)s 삭제하기"

msgid "Removing…"
msgstr "제거 중…"

msgid "Rename project"
msgstr "프로젝트 이름 변경"

msgid "Repeated"
msgstr "반복됨"

msgid "Repeated from other crawls"
msgstr "다른 크롤링에서 반복됨"

msgid "Repeated within"
msgstr "반복 간격"

msgid "Repeated words"
msgstr "반복된 단어들"

msgid "Repeated · est."
msgstr "반복 · 예상됨."

msgid "Repetition"
msgstr "반복"

msgid "Repetition estimate"
msgstr "반복 횟수 추정"

msgid "Replaced by the newer crawl of this site — not counted."
msgstr "이 사이트의 최신 크롤링으로 대체됨 — 집계되지 않음."

msgid "Report sections"
msgstr "보고서 섹션들"

#. Translators: why a page wasn't counted, in the report's list of pages
#. that failed and in its tooltips.
msgid "Requires login"
msgstr "로그인 필요"

msgid "Resuming…"
msgstr "다시 시작하는 중…"

msgid ""
"Review the scope, exclude anything you don’t need and sign in with Google"
" to finish for free."
msgstr "범위를 검토하고 필요하지 않은 항목은 제외한 다음, Google로 로그인하면 무료로 완료할 수 있습니다."

msgid "Revoke"
msgstr "취소하기"

msgid ""
"Revoke this connection? Any app using it stops counting until you give it"
" a new one."
msgstr "이 연결을 해제하시겠습니까? 이를 사용하는 모든 앱은 새 항목을 제공할 때까지 집계를 중단합니다."

msgid "Runs not in a project"
msgstr "프로젝트에 포함되지 않은 실행 항목"

msgid "Runs on our servers, not your computer"
msgstr "사용자 컴퓨터가 아닌 당사 서버에서 실행됩니다."

#. %(pro)s is "N pages" in bold (how many pages Pro fetches at        once) and
#. %(free)s is the Free plan's number, in bold, with the noun left        out
#. ("instead of 4"). %(counter)s and %(markdown)s are the two product
#. names.
#, python-format
msgid ""
"Same crawler, same counting, same reports. Pro fetches %(pro)s at once "
"instead of %(free)s, and starts ahead of everyone else when the queue is "
"busy. One subscription covers both %(counter)s and %(markdown)s — they’re"
" the same account."
msgstr ""
"동일한 크롤러, 동일한 집계, 동일한 보고서. Pro는 한 번에 %(pro)s개를 가져오며, %(free)s개를 가져오는 대신 "
"대기열이 혼잡할 때 다른 모든 사용자보다 먼저 시작합니다. 하나의 구독으로 %(counter)s와 %(markdown)s를 모두 "
"이용할 수 있습니다. 두 서비스는 같은 계정으로 제공됩니다."

msgid "Same page in another crawl"
msgstr "다른 크롤링에서 같은 페이지"

msgid "Same page in more than one crawl"
msgstr "둘 이상의 크롤링에서 동일한 페이지"

msgid "Same page on more than one site"
msgstr "둘 이상의 사이트에 있는 동일한 페이지"

msgid "Same pages"
msgstr "동일한 페이지들"

msgid "Save"
msgstr "저장하기"

msgid "Save Markdown"
msgstr "마크다운 저장"

msgid "Save each page as Markdown"
msgstr "각 페이지를 Markdown으로 저장합니다."

msgid ""
"Save each page's main content as Markdown, downloadable as a ZIP when the"
" crawl finishes."
msgstr "크롤링이 완료되면 각 페이지의 주요 콘텐츠를 Markdown으로 저장하고 ZIP 파일로 다운로드할 수 있습니다."

msgid "Saving…"
msgstr "저장 중…"

msgid "Search your runs"
msgstr "실행 기록 검색하기"

msgid ""
"Seconds for a small site, minutes for a large one. Your assistant waits "
"up to a minute, then checks back on the count until it’s done."
msgstr ""
"소규모 사이트는 몇 초, 대규모 사이트는 몇 분이면 됩니다. 어시스턴트가 최대 1분 동안 대기한 후, 완료될 때까지 단어 수를 다시"
" 확인합니다."

msgid "See a real report"
msgstr "실제 보고서 보기"

#. a link to every crawl; %(n)s is how many there are.
#, python-format
msgid "See all %(n)s →"
msgid_plural "See all %(n)s →"
msgstr[0] "모두 보기 %(n)s →"

msgid ""
"See how many words need translating, editing or rewriting. Repeated "
"menus, headers and footers are left out, and duplicate pages don’t "
"inflate the total."
msgstr ""
"번역, 편집 또는 재작성이 필요한 단어 수를 확인하세요. 반복되는 메뉴, 머리글, 바닥글은 제외되며 중복 페이지는 총계에 반영되지 "
"않습니다."

#. %(cms)s is a website platform such as WordPress or Webflow.            The
#. same words as the email's button; the arrow beside it follows the reading
#. direction.
#. %(cms)s is a website platform such as WordPress or Webflow.
#, python-format
msgid "See the %(cms)s connector"
msgstr "%(cms)s 커넥터 보기"

msgid "See what comes out"
msgstr "결과 확인하기"

msgid "See what that costs →"
msgstr "비용 확인하기 →"

#. a button. %(site)s is the crawled site's domain, such as example.com.
#, python-format
msgid "See what wxrks would do with %(site)s"
msgstr "wxrks가 %(site)s에서 어떻게 작동하는지 확인하세요."

msgid "See where the work is"
msgstr "작업 현황 보기"

msgid "Seems slow? Here’s why"
msgstr "느린 것 같나요? 이유는 다음과 같습니다."

msgid "Seen"
msgstr "확인함"

msgid "Send"
msgstr "보내기"

msgid ""
"Send a public report link, share by email, print the results or export "
"them. If you’re signed in, you’ll get an email when the crawl finishes."
msgstr ""
"공개 보고서 링크를 보내거나, 이메일로 공유하거나, 결과를 인쇄하거나 내보내세요. 로그인한 상태라면 크롤링이 완료될 때 이메일을 "
"받습니다."

msgid "Sending…"
msgstr "전송 중…"

#. Translators: %(email)s is the address the report was just sent to.
#, python-format
msgid "Sent to %(email)s"
msgstr "%(email)s(으)로 전송됨"

msgid "Sentence"
msgstr "문장"

msgid "Sentences"
msgstr "문장"

msgid "Sentences estimated from saved Markdown."
msgstr "저장된 Markdown에서 추정한 문장 수."

msgid ""
"Sentences found in more than one crawl. Each counts once, where it was "
"first seen; its other copies are the words removed."
msgstr ""
"둘 이상의 크롤링에서 발견된 문장입니다. 각 단어는 처음 표시된 위치에서 한 번만 계산되며, 나머지 복사본은 제거된 단어로 "
"처리됩니다."

msgid "Sentences in common"
msgstr "일반적인 문장들"

msgid "Sentences repeated across crawls"
msgstr "크롤링 간 반복된 문장들"

msgid "Sentences repeated across sites"
msgstr "여러 사이트에서 반복되는 문장들"

msgid "Sentences repeated within a crawl"
msgstr "크롤링 중 반복된 문장들"

msgid "Sentences repeated within a site"
msgstr "사이트 내에서 반복되는 문장들"

msgid "Session from your browser"
msgstr "브라우저 세션"

msgid ""
"Set Authentication to None — the key is already in the URL — and create "
"it."
msgstr "인증을 없음으로 설정하세요. 키는 이미 URL에 있으므로 그대로 생성하세요."

msgid "Set aside: other languages"
msgstr "제외: 기타 언어"

msgid "Set exclusions before the crawl or adjust them when the estimate appears."
msgstr "크롤링을 시작하기 전에 제외 항목을 설정하거나 예상치가 표시된 후 조정하세요."

msgid "Settings applied"
msgstr "설정이 적용되었습니다"

msgid "Share"
msgstr "공유하기"

msgid ""
"Share a link with your client, export every page to CSV, or put a "
"client’s sites in one project that counts each page and sentence once."
msgstr ""
"고객에게 링크를 공유하거나, 모든 페이지를 CSV로 내보내거나, 고객의 사이트를 하나의 프로젝트에 모아 각 페이지와 문장을 한 "
"번씩만 계산하세요."

msgid "Share results"
msgstr "결과 공유하기"

msgid "Share the scope. Get everyone working from the same numbers."
msgstr "범위를 공유하세요. 모두가 동일한 수치를 기준으로 작업할 수 있습니다."

msgid "Share this project"
msgstr "이 프로젝트 공유하기"

msgid "Share this report"
msgstr "이 보고서 공유하기"

msgid "Shared"
msgstr "공유됨"

msgid "Shared between the sites"
msgstr "사이트 간 공유됨"

msgid "Show all"
msgstr "모두 표시"

#. Translators: a link under a table that shows every row; %(n)s is how many.
#, python-format
msgid "Show all %(n)s"
msgstr "%(n)s개 모두 표시합니다"

msgid "Show more"
msgstr "더 보기"

#. Translators: a link under the top pages, when the list is itself the top
#. %(n)s of more.
#, python-format
msgid "Show top %(n)s"
msgstr "상위 %(n)s개 표시"

msgid "Showed a member login instead of the page."
msgstr "페이지 대신 회원 로그인 화면이 표시되었습니다."

#, python-format
msgid ""
"Showing the first %(loaded)s of %(n)s page. Export the CSV for the "
"complete list."
msgid_plural ""
"Showing the first %(loaded)s of %(n)s pages. Export the CSV for the "
"complete list."
msgstr[0] "%(n)s페이지 중 처음 %(loaded)s페이지 표시 중입니다. 전체 목록의 CSV를 내보냅니다."

#, python-format
msgid "Showing the first %(n)s — export the CSV for the rest."
msgstr "처음 %(n)s개를 표시하고 있습니다 — 나머지는 CSV로 내보내세요."

#, python-format
msgid "Showing the most recent %(n)s page while this crawl runs."
msgid_plural "Showing the most recent %(n)s pages while this crawl runs."
msgstr[0] "이 크롤링이 진행되는 동안 가장 최근 페이지 %(n)s개를 표시합니다."

msgid ""
"Shown on this report, its shared link and the CSV. It has to be on the "
"site that was crawled. Leave it empty to show where the crawl started."
msgstr "이 보고서, 공유 링크 및 CSV에 표시됩니다. 크롤링한 사이트에 있어야 합니다. 크롤링이 시작된 위치를 표시하려면 비워 두세요."

msgid "Shows what’s missing"
msgstr "누락된 항목 표시합니다"

msgid "Sign in"
msgstr "로그인하십시오"

msgid ""
"Sign in to the site in Chrome, open View → Developer → Developer Tools, "
"choose Network and reload the page. Click the first request, find "
"“cookie” under Request Headers and copy its value here. It works until "
"that session ends, and is never stored."
msgstr ""
"Chrome에서 사이트에 로그인한 다음 보기 → 개발자 → 개발자 도구를 열고, 네트워크를 선택한 뒤 페이지를 새로고침합니다. 첫 "
"번째 요청을 클릭하고 Request Headers에서 “cookie”를 찾아 값을 여기에 복사하세요. 해당 세션이 종료될 때까지 "
"작동하며, 저장되지 않습니다."

msgid "Sign in to upgrade"
msgstr "업그레이드하려면 로그인하세요."

msgid "Sign in with Google"
msgstr "Google로 로그인하기"

msgid ""
"Sign in with Google and make a connection. You get a personal URL — and a"
" key for apps that take one — shown once."
msgstr "Google로 로그인하고 연결을 설정하세요. 개인 URL과 이를 사용하는 앱용 키가 한 번 표시됩니다."

msgid "Sign in with Google to continue"
msgstr "Google로 로그인하여 계속하기"

msgid "Sign in with Google to count the rest of this site."
msgstr "Google로 로그인하여 이 사이트의 나머지 페이지도 계산하세요."

msgid ""
"Sign in with Google to count the rest. It’s free, and the crawl carries "
"on from here."
msgstr "Google로 로그인하여 나머지를 계산하세요. 무료이며, 크롤링은 여기서부터 계속됩니다."

msgid "Sign in with Google to keep it"
msgstr "Google로 로그인하여 저장하세요."

msgid "Sign-in email"
msgstr "로그인 이메일"

msgid "Sign-in page"
msgstr "로그인 페이지"

msgid "Sign-in page — optional, if the crawl starts on it"
msgstr "로그인 페이지 — 크롤링이 이 페이지에서 시작되는 경우에만 선택 사항"

msgid "Sign-in password"
msgstr "로그인 비밀번호"

msgid "Signed in"
msgstr "로그인됨"

msgid ""
"Signing in isn't available right now. Try again in a minute, or paste a "
"session."
msgstr "현재 로그인할 수 없습니다. 1분 후에 다시 시도하거나 세션을 붙여넣으세요."

msgid "Signs in with a code, or with Google or Microsoft? Paste a session instead"
msgstr "코드 또는 Google이나 Microsoft 계정으로 로그인하시나요? 대신 세션을 붙여넣으세요."

msgid "Site"
msgstr "사이트"

msgid "Site password"
msgstr "사이트 비밀번호"

#. Translators: the name of the companion product. Markdown is a file
#. format and stays as written.
msgid "Site to Markdown"
msgstr "Site to Markdown"

msgid "Site username"
msgstr "사이트 사용자 이름"

msgid "Site with a sign-in page"
msgstr "로그인 페이지가 있는 사이트"

msgid "Skipped as translations"
msgstr "번역으로 건너뜀"

msgid "Skips the queue when crawls are waiting"
msgstr "크롤링 대기 중인 작업이 있으면 대기열을 건너뜁니다."

msgid "Some languages are undercounted."
msgstr "일부 언어는 단어 수가 실제보다 적게 집계됩니다."

msgid ""
"Some sites use bot protection such as Cloudflare or Akamai. Pages it "
"blocks are listed separately, never counted as empty, so you can see the "
"total is incomplete. If it’s your site, a staging copy often works best —"
" including one behind a browser username-and-password pop-up."
msgstr ""
"일부 사이트는 Cloudflare 또는 Akamai와 같은 봇 차단 기능을 사용합니다. 차단된 페이지는 별도로 표시되며 빈 페이지로"
" 계산되지 않으므로 전체 개수가 불완전하다는 점을 확인할 수 있습니다. 본인 사이트라면 브라우저의 사용자 이름 및 비밀번호 팝업 "
"뒤에 있는 사이트를 포함해 스테이징 사본을 사용하는 것이 가장 좋은 경우가 많습니다."

msgid "Something went wrong"
msgstr "문제가 발생했습니다."

msgid "Source code (AGPL-3.0)"
msgstr "소스 코드 (AGPL-3.0)"

msgid "Start re-crawl"
msgstr "재크롤링 시작"

#. Translators: %(date)s is a date and time, such as "27 November 2026, 15:08".
#, python-format
msgid "Started: %(date)s"
msgstr "시작됨: %(date)s\n"

#. Translators: the label of a crawl's status badge, and of the form's
#. button while a crawl starts.
msgid "Starting…"
msgstr "시작 중…"

#. Translators: the banner's button that keeps the English page and hides the
#. banner.
msgid "Stay in English"
msgstr "영어로 유지하기"

msgid "Still crawling — joins when it finishes."
msgstr "크롤링 중 — 완료되면 참여합니다."

msgid "Stop this crawl before deleting it."
msgstr "삭제하기 전에 이 크롤링을 중지하세요."

msgid "Stopped: the server restarted while it ran, several times in a row."
msgstr "중지됨: 실행 중 서버가 여러 차례 연속으로 재시작되었습니다."

msgid ""
"Streamable HTTP at the URL below, plain JSON responses, no sessions. "
"Protocol versions 2025-03-26 to 2026-07-28. Authentication: a Bearer key,"
" or the key in the URL path."
msgstr ""
"아래 URL에서 세션 없이 일반 JSON 응답을 제공하는 스트리밍 가능한 HTTP입니다. 프로토콜 버전 "
"2025-03-26~2026-07-28. 인증: Bearer 키 또는 URL 경로의 키."

msgid "Subdomain"
msgstr "하위 도메인"

msgid "Subdomains"
msgstr "하위 도메인"

msgid "Summary"
msgstr "요약"

#. Translators: %(email)s is the account's email address, shown in bold.
#, python-format
msgid "Summary emailed to %(email)s"
msgstr "요약이 %(email)s(으)로 이메일 전송되었습니다."

#. Translators: %(email)s is the account's email address, shown in bold.
#, python-format
msgid "Summary will be emailed to %(email)s"
msgstr "요약이 %(email)s(으)로 이메일 전송됩니다."

msgid "Support in your language"
msgstr "사용하시는 언어로 지원합니다"

#. Translators: the banner's button that opens this page in your language.
#, python-format
msgid "Switch to %(language)s"
msgstr "%(language)s(으)로 전환합니다"

msgid "Text"
msgstr "텍스트"

#. %(url)s is the address of the page, as a link.
#, python-format
msgid "Text not kept — first seen on %(url)s"
msgstr "텍스트가 저장되지 않았습니다 — %(url)s에서 처음 확인됨"

msgid ""
"That doesn't look like a session. Copy the value of the “cookie” line "
"from the browser's developer tools."
msgstr "세션이 아닌 것 같습니다. 브라우저 개발자 도구에서 “cookie” 줄의 값을 복사합니다."

msgid "That project isn't yours, or it no longer exists."
msgstr "해당 프로젝트는 회원님의 프로젝트가 아니거나 더 이상 존재하지 않습니다."

msgid ""
"That session didn't get past the sign-in page; it may have ended. Sign in"
" again in your browser and copy a fresh one."
msgstr ""
"해당 세션은 로그인 페이지를 벗어나지 못했습니다. 세션이 종료되었을 수 있습니다. 브라우저에서 다시 로그인한 후 새 항목을 "
"복사하세요."

msgid "The configured page limit was reached — the crawl may be incomplete."
msgstr "설정된 페이지 한도에 도달했습니다 — 크롤링이 완료되지 않았을 수 있습니다."

msgid ""
"The crawl counts the starting page’s language only. Every page is checked"
" — by the language it declares, and by the script it’s written in — and "
"pages in another language are set aside, whatever their address says. "
"Folders such as /de/ are skipped without being fetched."
msgstr ""
"크롤링은 시작 페이지의 언어만 계산합니다. 모든 페이지는 페이지에 선언된 언어와 실제로 사용된 문자 체계를 기준으로 확인하며, "
"주소에 표시된 내용과 관계없이 다른 언어로 된 페이지는 제외합니다. /de/와 같은 폴더는 가져오지 않고 건너뜁니다."

msgid "The crawl failed."
msgstr "크롤링에 실패했습니다."

msgid ""
"The crawl, project or page may have been deleted, or the link may be "
"missing a part. A report that’s private only opens for the account that "
"made it."
msgstr ""
"크롤링, 프로젝트 또는 페이지가 삭제되었거나 링크의 일부가 누락되었을 수 있습니다. 비공개 보고서는 해당 보고서를 만든 계정에서만 "
"열 수 있습니다."

#. at the end of the printed report. %(n)s is the number of pages.
#, python-format
msgid ""
"The full list of %(n)s page, with each page’s title and word count, is in"
" the CSV export."
msgid_plural ""
"The full list of %(n)s pages, with each page’s title and word count, is "
"in the CSV export."
msgstr[0] "%(n)s개 페이지의 전체 목록과 각 페이지의 제목 및 단어 수는 CSV 내보내기 파일에 있습니다."

#. Translators: %(error)s is a technical reason, often in English.
#, python-format
msgid "The last consolidation didn’t finish: %(error)s"
msgstr "마지막 통합이 완료되지 않았습니다: %(error)s"

msgid ""
"The link opens the client view: the combined total, the sites and where "
"the words are. Each crawl’s own report stays private unless you share it "
"too."
msgstr ""
"링크를 열면 고객용 화면이 표시됩니다. 합산된 총 단어 수와 사이트 목록, 단어가 있는 위치를 확인할 수 있습니다. 각 크롤링의 "
"보고서는 공유하지 않는 한 비공개로 유지됩니다."

#. %(hosts)s is a list of subdomains, such as "help.example.com,
#. docs.example.com".
#, python-format
msgid "The linked subdomains that weren’t crawled: %(hosts)s."
msgstr "크롤링되지 않은 연결된 하위 도메인: %(hosts)s."

msgid ""
"The main text a visitor reads — without menus, footers and forms, and "
"with each duplicate page counted once."
msgstr "방문자가 읽는 주요 텍스트입니다. 메뉴, 바닥글, 양식은 제외하고 중복 페이지는 한 번만 계산합니다."

msgid "The only thing that changes is how long you wait."
msgstr "달라지는 것은 기다리는 시간뿐입니다."

msgid ""
"The pages of a count with their words, largest first, optionally only one"
" section."
msgstr "단어 수가 많은 순으로 정렬된 단어 수 집계 페이지이며, 원하는 경우 한 섹션만 표시할 수 있습니다."

msgid ""
"The same page in more than one crawl — the same address on one site, or "
"the same text anywhere — counts once, from the crawl listed first above. "
"Crawls can also share sentences without sharing a page."
msgstr ""
"여러 크롤링에서 동일한 페이지가 발견되면, 한 사이트 내의 동일한 주소이든 어디서든 동일한 텍스트이든 위에 먼저 나열된 크롤링에서 "
"한 번만 계산됩니다. 크롤링은 페이지를 공유하지 않고도 문장을 공유할 수 있습니다."

msgid "The same rules on every site"
msgstr "모든 사이트에 동일한 규칙 적용"

msgid "The same site, the same day"
msgstr "같은 사이트, 같은 날"

msgid ""
"The same text as a page already counted, under another address. Counted "
"once, not twice."
msgstr "이미 집계된 페이지와 동일한 텍스트이며, 주소만 다릅니다. 두 번이 아닌 한 번만 계산했습니다."

#, python-format
msgid ""
"The server restarted during this crawl, so the estimate covers %(n)s of "
"its words."
msgid_plural ""
"The server restarted during this crawl, so the estimate covers %(n)s of "
"its words."
msgstr[0] "이 크롤링 중에 서버가 재시작되어 예상치는 해당 크롤링의 단어 %(n)s개를 기준으로 합니다."

msgid ""
"The server restarted while this crawl was paused, and the site's password"
" is never kept. Start a re-crawl and enter it again."
msgstr "이 크롤링이 일시 중지된 동안 서버가 재시작되었으며, 사이트 비밀번호는 저장되지 않습니다. 다시 크롤링을 시작하고 다시 입력하세요."

msgid ""
"The server restarted while this crawl was paused, and the site's sign-in "
"is never kept. Start a re-crawl and sign in again."
msgstr ""
"이 크롤링이 일시 중지된 동안 서버가 다시 시작되었으며, 사이트 로그인 정보는 저장되지 않습니다. 다시 크롤링을 시작하고 다시 "
"로그인하세요."

msgid "The sign-in page didn't load. Check its address and try again."
msgstr "로그인 페이지가 로드되지 않았습니다. 주소를 확인한 후 다시 시도하세요."

msgid "The site didn't accept that username and password."
msgstr "사이트에서 해당 사용자 이름과 비밀번호를 허용하지 않았습니다."

msgid ""
"The site didn't let the crawler in with that email and password, or it "
"asked for more, like a code. For a code or a Google or Microsoft sign-in,"
" paste a session instead."
msgstr ""
"해당 이메일과 비밀번호로는 크롤러가 사이트에 접속할 수 없었거나, 코드와 같은 추가 정보를 요청했습니다. 코드 또는 Google이나"
" Microsoft 계정으로 로그인하려면 대신 세션을 붙여넣으세요."

msgid "The sites"
msgstr "사이트들"

msgid "The sites you’ve counted, with their totals."
msgstr "계산한 사이트와 총 단어 수입니다."

msgid "The text people read, each page once"
msgstr "사람들이 읽는 텍스트, 각 페이지당 한 번씩"

msgid "The token arithmetic is the argument"
msgstr "토큰 산술이 핵심 논거입니다"

msgid "The tools"
msgstr "도구들"

msgid "Their words"
msgstr "해당 단어 수"

msgid ""
"Then keep asking. Your assistant reads the numbers with you: which "
"sections are biggest, what to leave out of a quote, how many words are "
"new."
msgstr ""
"그런 다음 계속 질문하세요. 어시스턴트가 함께 수치를 살펴봅니다. 어떤 섹션이 가장 큰지, 견적에서 무엇을 제외할지, 새로 추가된 "
"단어가 몇 개인지 확인할 수 있습니다."

msgid "There’s nothing at this address"
msgstr "이 주소에는 아무것도 없습니다."

msgid "They ran a word count on this site and gave you access to the full report."
msgstr "이 사이트의 단어 수를 계산하고 전체 보고서에 액세스할 수 있도록 했습니다."

msgid "This crawl couldn't be completed."
msgstr "이 크롤링을 완료하지 못했습니다."

#, python-format
msgid ""
"This crawl stalled — no page was fetched for over %(minutes)s minutes — "
"and was stopped automatically."
msgstr "이 크롤링은 중단되었습니다. %(minutes)s분 넘게 페이지를 가져오지 못해 자동으로 중지되었습니다."

#. %(took)s and %(pro)s are approximate durations such as "~25 min";
#. %(pro)s is shown in bold.
#. in the crawl email's Pro offer. %(took)s and %(pro)s
#. are approximate durations such as "~1h 8m": how long this crawl
#. took, and how long it would have taken on the Pro plan.
#, python-format
msgid "This crawl took %(took)s. On Pro: %(pro)s."
msgstr "이 크롤링에는 %(took)s이(가) 걸렸습니다. Pro에서는 %(pro)s."

msgid "This crawl was cancelled — showing partial results."
msgstr "이 크롤링이 취소되어 일부 결과만 표시됩니다."

msgid ""
"This crawl was paused for an estimate and never resumed — showing partial"
" results from before the pause."
msgstr "이 크롤링은 견적을 위해 일시 중지된 후 재개되지 않았습니다. 일시 중지 전의 일부 결과만 표시됩니다."

msgid ""
"This crawl was stopped automatically — it was using too much memory to "
"continue safely on this server."
msgstr "이 크롤링은 자동으로 중지되었습니다. 이 서버에서 안전하게 계속 실행하기에는 메모리를 너무 많이 사용하고 있었습니다."

msgid ""
"This crawl was stopped before it finished, so the report shows partial "
"results."
msgstr "이 크롤링은 완료되기 전에 중지되어 보고서에 일부 결과만 표시됩니다."

msgid "This link points to a downloadable file, not a webpage"
msgstr "이 링크는 웹페이지가 아니라 다운로드 가능한 파일을 가리킵니다."

#. Translators: a banner on the English page. %(language)s is your language's
#. own name (Deutsch, 日本語); the sentence is shown in your language.
#, python-format
msgid "This page is also in %(language)s."
msgstr "이 페이지는 %(language)s로도 제공됩니다."

msgid "This project is being prepared. The page updates by itself."
msgstr "이 프로젝트를 준비하고 있습니다. 페이지가 자동으로 업데이트됩니다."

#. Translators: %(scope)s is one of "Whole domain (incl. subdomains)",
#. "This subdomain only" or "Top-level domain only".
#, python-format
msgid "This run was set to “%(scope)s”, so other subdomains weren’t crawled."
msgstr "이 실행은 “%(scope)s”로 설정되어 있어 다른 하위 도메인은 크롤링되지 않았습니다."

#, python-format
msgid "This site has more than %(n)s word."
msgid_plural "This site has more than %(n)s words."
msgstr[0] "이 사이트에는 단어가 %(n)s개 넘게 있습니다."

msgid ""
"This site is password-protected. Enter the username and password its "
"owner gave you."
msgstr "이 사이트는 비밀번호로 보호됩니다. 소유자가 제공한 사용자 이름과 비밀번호를 입력하세요."

msgid "This subdomain only"
msgstr "이 하위 도메인만 해당합니다."

msgid "This will start automatically, and we'll email you when it's done."
msgstr "자동으로 시작되며, 완료되면 이메일로 알려드립니다."

msgid "Times"
msgstr "시간"

msgid "Title"
msgstr "제목"

msgid "Together"
msgstr "함께"

#. Translators: why a project couldn't be consolidated. %(limit)s is the
#. server's page limit; the plural follows the pages.
#, python-format
msgid ""
"Too large to consolidate here: %(n)s page across its crawls (this "
"server's limit is %(limit)s)."
msgid_plural ""
"Too large to consolidate here: %(n)s pages across its crawls (this "
"server's limit is %(limit)s)."
msgstr[0] "여기에 통합하기에는 너무 큽니다: 크롤링할 때마다 페이지 %(n)s개(이 서버의 한도는 %(limit)s페이지입니다)."

#, python-format
msgid "Took %(time)s"
msgstr "%(time)s 소요됨"

msgid "Tool"
msgstr "도구"

msgid "Top pages by word count"
msgstr "단어 수 기준 상위 페이지"

msgid "Top-level domain only"
msgstr "최상위 도메인만"

msgid "Total words"
msgstr "총 단어 수"

msgid ""
"Totals per folder and per page, your longest pages ranked, and a CSV of "
"every URL — so a quote turns into a plan you can phase."
msgstr ""
"폴더 및 페이지별 총계, 가장 긴 페이지 순위, 모든 URL이 담긴 CSV를 확인할 수 있어 견적을 단계별 계획으로 구체화할 수 "
"있습니다."

msgid ""
"Translation is priced per word, so the first question is one most site "
"owners can only guess at. Guessing wrong by a factor of three is a budget"
" that runs out halfway through."
msgstr ""
"번역은 단어당 요금이 책정되므로, 사이트 소유자가 추측할 수밖에 없는 첫 번째 질문이 있습니다. 세 배나 잘못 추산하면 예산이 "
"절반도 채 쓰기 전에 바닥납니다."

msgid "Translations"
msgstr "번역문"

msgid "Turn any website into clean Markdown"
msgstr "모든 웹사이트를 깔끔한 Markdown으로 변환하세요."

msgid "Turned away by the site’s bot protection."
msgstr "사이트의 봇 보호 기능에 의해 차단되었습니다."

msgid "URL"
msgstr "URL"

msgid "Unknown reason"
msgstr "알 수 없는 이유"

msgid "Unlimited crawls, unlimited pages"
msgstr "크롤링 무제한, 페이지 무제한"

msgid "Unlimited projects"
msgstr "무제한 프로젝트"

#, python-format
msgid "Up to %(n)s crawl in a project."
msgid_plural "Up to %(n)s crawls in a project."
msgstr[0] "프로젝트당 크롤링 최대 %(n)s회."

msgid "Upgrade to Pro"
msgstr "Pro로 업그레이드하십시오"

msgid "Use an address on the site that was crawled."
msgstr "크롤링한 사이트의 주소를 사용합니다."

msgid "Username"
msgstr "사용자 이름"

msgid "VS Code — in .vscode/mcp.json:"
msgstr "VS Code — .vscode/mcp.json에서:"

msgid "View blocked/failed pages"
msgstr "차단되었거나 실패한 페이지 보기"

msgid "View full report"
msgstr "전체 보고서 보기"

msgid "View report"
msgstr "보고서 보기"

msgid "View the list"
msgstr "목록 보기"

msgid "Waiting for a free slot. It starts on its own."
msgstr "사용 가능한 슬롯을 기다리는 중입니다. 자동으로 시작됩니다."

msgid "Waiting to start…"
msgstr "시작 대기 중…"

msgid "Waits for each page to finish loading"
msgstr "각 페이지의 로딩이 완료될 때까지 기다립니다"

msgid "Waits its turn when the server is busy"
msgstr "서버가 사용 중일 때 차례를 기다립니다."

msgid ""
"We tried it on our own site. Asked how many words wxrks.com has, Claude "
"Code wrote a crawler, fetched the pages its sitemap lists and counted "
"every word in their HTML. Word Counter counted the same site, the same "
"day."
msgstr ""
"자체 사이트에서 사용해 봤습니다. wxrks.com의 단어 수를 묻자 Claude Code는 크롤러를 작성해 사이트맵에 나열된 "
"페이지를 가져온 다음 HTML에 있는 모든 단어를 세었습니다. Word Counter가 같은 날 같은 사이트를 집계했습니다."

msgid "Web pages only."
msgstr "웹 페이지 전용."

msgid "What about very large sites?"
msgstr "매우 큰 사이트는 어떻습니까?"

msgid "What does it cost?"
msgstr "비용은 얼마인가요?"

msgid "What every plan includes"
msgstr "모든 요금제에 포함된 항목"

msgid "What if the site blocks bots?"
msgstr "사이트에서 봇을 차단하면 어떻게 되나요?"

msgid "What is it for?"
msgstr "무엇에 사용하나요?"

msgid "What it does"
msgstr "기능 설명"

msgid "What overlapped"
msgstr "겹친 항목"

msgid "What should I quote on?"
msgstr "어떤 항목에 대해 견적을 내야 하나요?"

msgid "What that costs"
msgstr "비용은 얼마인가요?"

msgid "What to ask"
msgstr "무엇을 물어볼까요?"

msgid "Where do my counts go?"
msgstr "내 단어 수는 어디로 가나요?"

msgid "Where the new words are"
msgstr "새 단어가 있는 위치"

msgid "Where to paste it, app by app →"
msgstr "앱별로 붙여넣을 위치 →"

msgid "Which pages count as part of this site?"
msgstr "이 사이트의 일부로 간주되는 페이지는 무엇인가요?"

msgid "Which sections of example.com have the most text?"
msgstr "example.com에서 텍스트가 가장 많은 섹션은 어디인가요?"

msgid "Whole domain"
msgstr "전체 도메인"

msgid "Whole domain (incl. subdomains)"
msgstr "전체 도메인(하위 도메인 포함)"

msgid "Why does a crawl take a while?"
msgstr "크롤링에 시간이 걸리는 이유는 무엇인가요?"

msgid "Why it took this long"
msgstr "이렇게 오래 걸린 이유"

msgid "Why not just ask ChatGPT or Claude?"
msgstr "그냥 ChatGPT나 Claude에 물어보면 안 되나요?"

msgid "Why your assistant needs it"
msgstr "어시스턴트에게 필요한 이유"

#. Translators: the product's name, in titles and running text (the logo
#. keeps it as written). Translate it only where your market knows the
#. product by a translated name.
msgid "Word Counter"
msgstr "Word Counter"

msgid ""
"Word Counter checks for identical text, pages that identify another URL "
"as their original, and URLs that differ only by tracking or sign-in "
"parameters. Duplicates are listed separately."
msgstr ""
"Word Counter는 동일한 텍스트, 다른 URL을 원본으로 지정하는 페이지, 추적 또는 로그인 매개변수만 다른 URL을 "
"확인합니다. 중복 항목은 별도로 표시됩니다."

msgid ""
"Word Counter detects the starting page’s language and skips translated "
"versions under folders such as /fr/ and /de/, helping you scope one "
"language at a time."
msgstr ""
"Word Counter는 시작 페이지의 언어를 감지하고 /fr/ 및 /de/와 같은 폴더에 있는 번역된 버전은 건너뛰므로 한 번에 "
"한 언어만 범위에 포함할 수 있습니다."

msgid "Word Counter for Claude and ChatGPT (MCP server)"
msgstr "Claude 및 ChatGPT용 Word Counter(MCP 서버)"

msgid ""
"Word Counter opens your site’s linked pages in a real browser and adds up"
" the main content. You get a total, a breakdown and a clearer picture of "
"what’s ahead."
msgstr ""
"Word Counter는 실제 브라우저에서 사이트의 링크된 페이지를 열고 주요 콘텐츠의 단어 수를 합산합니다. 총계와 세부 내역을 "
"확인하고 앞으로의 상황을 더 명확하게 파악할 수 있습니다."

msgid ""
"Word Counter’s MCP server crawls every page and gives your assistant the "
"real total — not a guess from the homepage."
msgstr "Word Counter의 MCP 서버는 모든 페이지를 크롤링해 홈페이지에서 추측한 값이 아닌 실제 총계를 어시스턴트에 제공합니다."

msgid "Word count · project"
msgstr "단어 수 · 프로젝트"

msgid "Words"
msgstr "단어"

msgid "Words each"
msgstr "단어당"

msgid "Words on the main site"
msgstr "메인 사이트의 단어 수"

msgid "Words removed"
msgstr "제거된 단어들"

msgid "Words so far"
msgstr "현재까지의 단어 수"

msgid "Works with"
msgstr "호환되는 항목"

msgid "Works with any website"
msgstr "모든 웹사이트에서 작동합니다."

#, python-format
msgid ""
"You have %(n)s connection, the most there can be. Revoke one to make "
"another."
msgid_plural ""
"You have %(n)s connections, the most there can be. Revoke one to make "
"another."
msgstr[0] "연결이 %(n)s개 있습니다. 가능한 최대 개수입니다. 다른 항목을 만들려면 하나를 취소하세요."

msgid "You have as many connections as there can be. Revoke one to make another."
msgstr "가능한 한 많은 연결을 보유하고 있습니다. 다른 항목을 추가하려면 하나를 취소하세요."

#. Translators: %(n)s is a position in the queue (1, 2, 3…).
#, python-format
msgid ""
"You're #%(n)s in line — this server is busy right now. This will start "
"automatically, and we'll email you when it's done."
msgstr "현재 서버가 혼잡합니다. 대기열에서 #%(n)s번째입니다. 자동으로 시작되며, 완료되면 이메일로 알려드립니다."

#. Translators: %(product)s is the product's name, such as "Word Counter".
#, python-format
msgid "You're getting this because someone shared a %(product)s report with you."
msgstr "누군가 %(product)s 보고서를 공유했기 때문에 이 메시지를 받으셨습니다."

#. Translators: %(product)s is the product's name, such as "Word Counter".
#, python-format
msgid "You're getting this because you started this crawl on %(product)s."
msgstr "이 크롤링은 %(product)s에서 시작하셨기 때문에 이 메시지를 받으셨습니다."

msgid "Your app"
msgstr "내 앱"

msgid "Your assistant picks these itself; you just ask in your own words."
msgstr "이 항목은 어시스턴트가 직접 선택하므로, 원하는 내용을 편하게 요청하기만 하면 됩니다."

msgid "Your connection is ready"
msgstr "연결이 준비되었습니다"

msgid "Your connections"
msgstr "연결 항목"

msgid "Your crawl finished. Here's what it counted."
msgstr "크롤링이 완료되었습니다. 계산된 결과입니다."

msgid "Your current plan"
msgstr "현재 이용 중인 요금제"

#. %(date)s is the date the subscription renews, filled in by the browser.
#, python-format
msgid "Your current plan · renews %(date)s"
msgstr "현재 요금제 · %(date)s에 갱신됩니다"

#. %(domain)s is a website's address; %(words)s is a number of words, in bold.
#, python-format
msgid "Your last crawl of %(domain)s found %(words)s word."
msgid_plural "Your last crawl of %(domain)s found %(words)s words."
msgstr[0] "%(domain)s의 마지막 크롤링에서 단어 %(words)s개를 찾았습니다."

msgid "Your recent runs"
msgstr "최근 실행 내역"

msgid "Your runs"
msgstr "실행 내역"

msgid "Your runs →"
msgstr "실행 내역 →"

msgid "Your website, as clean text a language model can actually read."
msgstr "언어 모델이 실제로 읽을 수 있는 깔끔한 텍스트로 변환한 웹사이트입니다."

#. %(days)s is a number of days a guest's report is kept.
#, python-format
msgid "You’re not signed in, so this report is kept for %(days)s day."
msgid_plural "You’re not signed in, so this report is kept for %(days)s days."
msgstr[0] "로그인하지 않은 상태이므로 이 보고서는 %(days)s일 동안 보관됩니다."

msgid "a tool by wxrks"
msgstr "wxrks의 도구"

#. %(n)s is a whole number: how many times faster Pro is.
#, python-format
msgid "about %(n)s× faster"
msgstr "약 %(n)s배 더 빠름"

#. Translators: %(time)s is a duration such as "25 min", shown in bold.
#, python-format
msgid "about %(time)s on Pro"
msgstr "Pro에서는 약 %(time)s 정도"

#, python-format
msgid "also in %(site)s:"
msgstr "%(site)s에도 있음:"

msgid "and anything else built with AI"
msgstr "AI로 제작된 그 밖의 모든 것"

#. Translators: in the Words column instead of a number; keep it short and
#. lower-case if your language does.
msgid "blocked"
msgstr "차단됨"

#. Translators: %(cms)s is a platform's name, such as WordPress or Webflow.
#, python-format
msgid "built with %(cms)s"
msgstr "%(cms)s로 제작됨"

#, python-format
msgid "counted from %(site)s"
msgstr "%(site)s에서 집계됨"

#. Translators: %(path)s is the address of one page, such as /fr/pricing.
#, python-format
msgid "e.g. %(path)s"
msgstr "예: %(path)s"

msgid "e.g. Claude Code on my laptop"
msgstr "예: 내 노트북의 Claude Code"

#. the caption under the project's number of new words; %(n)s is how many
#. crawls it covers.
#, python-format
msgid "each page and each sentence once, in %(n)s crawl"
msgid_plural "each page and each sentence once, across %(n)s crawls"
msgstr[0] "%(n)s회 크롤링에 걸쳐 각 페이지와 각 문장을 한 번씩"

#. Translators: in the Words column instead of a number; keep it short.
msgid "failed"
msgstr "실패했습니다"

#. Translators: on an exclusion chip: the entry is a folder (it starts with /).
msgid "folder"
msgstr "폴더"

msgid "for its careful count"
msgstr "정확한 집계를 위해"

msgid "free"
msgstr "무료"

#, python-format
msgid "from %(sites)s"
msgstr "%(sites)s에서"

#. %(sites)s is a list of site names.
#, python-format
msgid "in %(sites)s"
msgstr "%(sites)s에서"

#. %(date)s is when this connection was last used, filled in by the browser.
#, python-format
msgid "last used %(date)s"
msgstr "마지막 사용일 %(date)s"

msgid "less than a minute"
msgstr "1분 미만"

#. Translators: beside a subdomain or language that wasn't counted: how
#. many of the crawled pages link to it.
#, python-format
msgid "linked from %(n)s page"
msgid_plural "linked from %(n)s pages"
msgstr[0] "%(n)s개 페이지에서 링크됨"

#. %(date)s is when this connection was made, filled in by the browser.
#, python-format
msgid "made %(date)s"
msgstr "%(date)s에 생성됨"

#. Translators: after a new connection's key hint ("wck_…a1b2 · made just
#. now").
msgid "made just now"
msgstr "방금 생성됨"

msgid "moved"
msgstr "이동됨"

msgid "new"
msgstr "새로 만들기"

#. the caption under the project's big number of new words.            %(n)s is
#. how many sites the project counts (two or more).
#, python-format
msgid ""
"new words to translate across the %(n)s site: each page and each sentence"
" counted once."
msgid_plural ""
"new words to translate across the %(n)s sites: each page and each "
"sentence counted once."
msgstr[0] "%(n)s개 사이트에서 번역할 새 단어: 각 페이지와 문장을 한 번씩 계산합니다."

#. the caption under the project's big number of new words,          when the
#. project counts one site.
msgid ""
"new words to translate on this site: each page and each sentence counted "
"once."
msgstr "이 사이트에서 번역할 새 단어: 각 페이지와 각 문장을 한 번씩 계산합니다."

#. the caption under a project's big number, which is a count of new words.
msgid "new words: each page and sentence once"
msgstr "새 단어: 각 페이지와 문장을 한 번씩"

msgid "not used yet"
msgstr "아직 사용되지 않음"

#, python-format
msgid "of the %(n)s word checked"
msgid_plural "of the %(n)s words checked"
msgstr[0] "확인한 단어 %(n)s개 중"

#. Translators: under the total word count: "on 1,204 pages".
#, python-format
msgid "on %(n)s page"
msgid_plural "on %(n)s pages"
msgstr[0] "페이지 %(n)s개에서"

#. Translators: under the total word count while the crawl still runs.
#, python-format
msgid "on %(n)s page so far"
msgid_plural "on %(n)s pages so far"
msgstr[0] "현재까지 %(n)s개 페이지에서"

msgid "on our servers, no AI usage"
msgstr "당사 서버에서 처리되며, AI를 사용하지 않습니다."

msgid "or paste a session"
msgstr "또는 세션을 붙여넣으세요"

msgid "repeated across crawls"
msgstr "크롤링을 여러 번 실행할 때마다 반복됨"

msgid "repeated within a crawl"
msgstr "크롤링 한 번 내에서 반복됨"

msgid "same address"
msgstr "같은 주소"

msgid "same page in another crawl"
msgstr "다른 크롤링에서 같은 페이지"

msgid "same text"
msgstr "같은 텍스트"

msgid "staging, password-protected"
msgstr "스테이징, 비밀번호로 보호됨"

#. example entries for a field of subdomains and folders to leave out.
#. Keep the leading / on folders; the names may be adapted.
msgid "staging, web-staging, /careers"
msgstr "스테이징, 웹 스테이징, /careers"

#. Translators: on an exclusion chip: the entry is a subdomain.
msgid "subdomain"
msgstr "하위 도메인"

msgid "text changed — counted from the crawl listed first"
msgstr "텍스트 변경됨 — 첫 번째로 나열된 크롤에서 계산됨"

msgid "the server reached the most Markdown it keeps"
msgstr "서버가 보관하는 Markdown의 최대치에 도달했습니다."

#. Translators: in the README inside a Markdown download, after "Capture
#. stopped before the end of the crawl": the reason it stopped.
msgid "the server was running out of disk space"
msgstr "서버의 디스크 공간이 부족해지고 있었습니다."

msgid "this crawl reached the most Markdown one crawl may save"
msgstr "이번 크롤링에서 한 번의 크롤링으로 저장할 수 있는 Markdown 최대치에 도달했습니다."

msgid "vs."
msgstr "대"

#. the caption under a project's big number, which is a count of words.
msgid "words, each page once"
msgstr "단어, 페이지당 한 번씩"

#. Translators: a group of pages told apart by their writing system.
#. %(script)s is a script's name in your language (Latin, Cyrillic,
#. Arabic…), as the browser names it; phrase it so any name fits.
#, python-format
msgid "written in %(script)s"
msgstr "%(script)s로 작성됨"

#. %(cms)s is the platform the site is built on, such as Webflow or WordPress.
#, python-format
msgid ""
"wxrks has a %(cms)s connector: it pulls your content straight from "
"%(cms)s, translates it with the best AI models and keeps it in sync."
msgstr ""
"wxrks에는 %(cms)s 커넥터가 있습니다. %(cms)s에서 콘텐츠를 바로 가져와 최고의 AI 모델로 번역하고 동기화 상태를 "
"유지합니다."

msgid ""
"wxrks pulls the content and translates it with the best AI models, then "
"keeps it in sync as the site changes."
msgstr "wxrks는 콘텐츠를 가져와 최고의 AI 모델로 번역한 다음, 사이트가 변경될 때마다 동기화 상태를 유지합니다."

#. Translators: marks a duration as approximate ("~25 min"). %(duration)s is
#. a duration such as "25 min" or "1h 8m".
#, python-format
msgid "~%(duration)s"
msgstr "~%(duration)s"

msgid ""
"“How many words does example.com have?” Your assistant starts the count, "
"follows it, and answers with the total."
msgstr ""
"example.com에는 단어가 몇 개 있나요? 어시스턴트가 단어 수를 세기 시작하고, 진행 상황을 추적하며, 총 단어 수를 "
"알려드립니다."

msgid "← Back to the project"
msgstr "← 프로젝트로 돌아가기"

#. a link back to the page explaining the assistant connection.
msgid "← How it works"
msgstr "← 작동 방식"

msgid "← New crawl"
msgstr "← 새 크롤링 시작"

msgid "← Newer"
msgstr "← 더 최신 항목"

#. a link back to the list of projects.
msgid "← Projects"
msgstr "← 프로젝트"

