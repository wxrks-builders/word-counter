msgstr "عدد كلمات لـ %(site)s"

#. an assistant's advice on what to put in a translation quote.
#, python-format
msgid ""
"About %(words)s word, without the machine-generated API docs and the user"
" forum."
msgid_plural ""
"About %(words)s words, without the machine-generated API docs and the "
"user forum."
msgstr[0] "حوالي %(words)s كلمة، من دون وثائق API المُنشأة آليًا ومنتدى المستخدمين."
msgstr[1] "حوالي كلمة واحدة، من دون وثائق API المُنشأة آليًا ومنتدى المستخدمين."
msgstr[2] "حوالي كلمتين، من دون وثائق API المُنشأة آليًا ومنتدى المستخدمين."
msgstr[3] "حوالي %(words)s كلمات، من دون وثائق API المُنشأة آليًا ومنتدى المستخدمين."
msgstr[4] ""
"حوالي %(words)s كلمة، من دون وثائق واجهة برمجة التطبيقات المُنشأة آليًا "
"ومنتدى المستخدمين."
msgstr[5] "حوالي %(words)s كلمة، من دون وثائق API المُنشأة آليًا ومنتدى المستخدمين."

#. %(n)s and %(raw)s are whole-number multiples ("3", "4").
#, python-format
msgid ""
"About “%(n)s× faster” is measured, not arithmetic. Pro fetches %(raw)s× "
"as many pages at once, but fetching is only part of the work — every page"
" is also rendered and its text extracted, and that competes for CPU. The "
"honest number is the smaller one."
msgstr ""
"تعني عبارة «أسرع بمقدار %(n)s×» أن السرعة مقاسة وليست ناتجة عن عملية "
"حسابية. تجلب Pro عددًا أكبر من الصفحات في المرة الواحدة بمقدار %(raw)s×، "
"لكن الجلب ليس سوى جزء من العمل — إذ تُعرَض كل صفحة أيضًا ويُستخرج نصها، "
"وهذا يستهلك موارد وحدة المعالجة المركزية. العدد الحقيقي هو الأصغر."

