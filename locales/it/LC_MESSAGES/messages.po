#. Translators: one exclusion in the settings pill: %(entry)s is what was
#. typed, %(kind)s is "folder" or "subdomain".
#, python-format
msgid "%(entry)s (%(kind)s)"
msgstr "%(entry)s (%(kind)s)"

#. Translators: a duration in hours, abbreviated ("3h").
#, python-format
msgid "%(h)sh"
msgstr "%(h)sh"

#. Translators: a duration, abbreviated: h is hours, m is minutes ("1h 8m").
#, python-format
msgid "%(h)sh %(m)sm"
msgstr "%(h)sh %(m)sm"

#. Translators: one line of the plain-text email: a label and its value
#. ("Total words: 1,234"). Keep both placeholders.
#, python-format
msgid "%(label)s: %(value)s"
msgstr "%(label)s: %(value)s"

#. Translators: beside "Show more": %(loaded)s of %(total)s pages shown.
#, python-format
msgid "%(loaded)s of %(total)s"
msgstr "%(loaded)s di %(total)s"

#. Translators: part of the "Not counted" line; %(n)s counts pages
#. that asked for a sign-in. Agree with "pages" where your language must.
#, python-format
msgid "%(n)s behind a login"
msgid_plural "%(n)s behind a login"
msgstr[0] "%(n)s dietro un accesso con credenziali"
msgstr[1] "%(n)s dietro un accesso"

#. Translators: part of the "Not counted" line; %(n)s counts pages the
#. site's bot protection refused. Agree with "pages" where your language must.
#, python-format
msgid "%(n)s blocked"
msgid_plural "%(n)s blocked"
msgstr[0] "%(n)s bloccato"
msgstr[1] "%(n)s bloccati"

#. how many crawls a project holds, in a project's one-line summary.
#. how many crawls the project holds, then how many of them are still running.
#. a project's crawl count, then its words added up across those crawls.
#, python-format
msgid "%(n)s crawl"
msgid_plural "%(n)s crawls"
msgstr[0] "%(n)s scansione"
msgstr[1] "%(n)s scansioni"

#. Translators: the next four are parts of a short line under "Not
#. counted": "3 duplicates · 2 blocked". Keep them short.
#, python-format
msgid "%(n)s duplicate"
msgid_plural "%(n)s duplicates"
msgstr[0] "%(n)s duplicato"
msgstr[1] "%(n)s duplicati"

#, python-format
msgid "%(n)s duplicate page isn’t in the total at all."
msgid_plural "%(n)s duplicate pages aren’t in the total at all."
msgstr[0] "%(n)s pagina duplicata non è inclusa nel totale."
msgstr[1] "Le %(n)s pagine duplicate non sono incluse nel totale."

#, python-format
msgid "%(n)s duplicate page within the sites."
msgid_plural "%(n)s duplicate pages within the sites."
msgstr[0] "%(n)s pagina duplicata all'interno dei siti."
msgstr[1] "%(n)s pagine duplicate all'interno dei siti."

#. Translators: part of the "Not counted" line; %(n)s counts pages that
#. didn't load. Agree with "pages" where your language must.
#, python-format
msgid "%(n)s failed"
msgid_plural "%(n)s failed"
msgstr[0] "%(n)s non riuscito"
msgstr[1] "%(n)s non riusciti"

#. how many Markdown files are in the ZIP download.
#, python-format
msgid "%(n)s file"
msgid_plural "%(n)s files"
msgstr[0] "%(n)s file"
msgstr[1] "%(n)s file"

#. after the label "Subdomains": %(n)s subdomains were found,        and
#. %(words)s is "N more words", translated on its own.
#, python-format
msgid "%(n)s found, with %(words)s, each on its own line."
msgid_plural "%(n)s found, with %(words)s, each on its own line."
msgstr[0] "%(n)s trovato, con %(words)s, ciascuno su una riga."
msgstr[1] "%(n)s trovati, con %(words)s, ciascuno su una riga."

#. Translators: a duration in minutes, abbreviated ("25 min").
#. how long a count took, in minutes, abbreviated.
#, python-format
msgid "%(n)s min"
msgid_plural "%(n)s min"
msgstr[0] "%(n)s min"
msgstr[1] "%(n)s min"

#. Translators: more pages in that language that weren't fetched at all.
#, python-format
msgid "%(n)s more not fetched"
msgid_plural "%(n)s more not fetched"
msgstr[0] "%(n)s in più non recuperato"
msgstr[1] "Altri %(n)s non recuperati"

#, python-format
msgid "%(n)s more word"
msgid_plural "%(n)s more words"
msgstr[0] "%(n)s parola in più"
msgstr[1] "%(n)s parole in più"

#, python-format
msgid "%(n)s new word"
msgid_plural "%(n)s new words"
msgstr[0] "%(n)s nuova parola"
msgstr[1] "%(n)s nuove parole"

#. Translators: a page count, as part of a longer sentence.
#. how much two sites share: a number of pages, then a number of words in
#. shared sentences.
#, python-format
msgid "%(n)s page"
msgid_plural "%(n)s pages"
msgstr[0] "%(n)s pagina"
msgstr[1] "%(n)s pagine"

#. how many pages a plan fetches at the same time.
#, python-format
msgid "%(n)s page at a time"
msgid_plural "%(n)s pages at a time"
msgstr[0] "%(n)s pagina alla volta"
msgstr[1] "%(n)s pagine alla volta"

#, python-format
msgid "%(n)s page behind a sign-in."
msgid_plural "%(n)s pages behind a sign-in."
msgstr[0] "%(n)s pagina dietro un accesso."
msgstr[1] "%(n)s pagine dietro un accesso."

#, python-format
msgid "%(n)s page failed to load."
msgid_plural "%(n)s pages failed to load."
msgstr[0] "Impossibile caricare %(n)s pagina."
msgstr[1] "Impossibile caricare %(n)s pagine."

#, python-format
msgid "%(n)s page was blocked by this site's own bot detection."
msgid_plural "%(n)s pages were blocked by this site's own bot detection."
msgstr[0] "%(n)s pagina è stata bloccata dal sistema di rilevamento dei bot del sito."
msgstr[1] ""
"%(n)s pagine sono state bloccate dal sistema di rilevamento dei bot del "
"sito."

#. Translators: pages in another language that were fetched, then left
#. out of the count.
#, python-format
msgid "%(n)s read and set aside"
msgid_plural "%(n)s read and set aside"
msgstr[0] "%(n)s letto e messo da parte"
msgstr[1] "%(n)s letti e messi da parte"

#. pages matched only by their address, because their text wasn't kept to
#. compare; %(n)s is a number of pages.
#, python-format
msgid "%(n)s same address"
msgid_plural "%(n)s same address"
msgstr[0] "%(n)s stesso indirizzo"
msgstr[1] "%(n)s stesso indirizzo"

#. under a pair of sites, how many of their shared pages have
#. the same text, changed text, or only the same address. Each %(n)s is a
#. number of pages.
#, python-format
msgid "%(n)s same text"
msgid_plural "%(n)s same text"
msgstr[0] "%(n)s stesso testo"
msgstr[1] "%(n)s stesso testo"

#. after the number of crawls in a project: how many of them are still running.
#, python-format
msgid "%(n)s still crawling"
msgid_plural "%(n)s still crawling"
msgstr[0] "%(n)s scansione ancora in corso"
msgstr[1] "%(n)s ancora in scansione"

#. shared pages whose text differs between the two sites; %(n)s is a number of
#. pages.
#, python-format
msgid "%(n)s text changed"
msgid_plural "%(n)s text changed"
msgstr[0] "%(n)s testo modificato"
msgstr[1] "%(n)s testi modificati"

#. %(n)s is a number of translated pages the crawl skipped.
#, python-format
msgid "%(n)s translated page set aside, never fetched."
msgid_plural "%(n)s translated pages set aside, never fetched."
msgstr[0] "%(n)s pagina tradotta messa da parte, mai recuperata."
msgstr[1] "%(n)s pagine tradotte messe da parte, mai recuperate."

#. Translators: a word count, as part of a longer sentence.
#. a site's word count, in a small chip beside its address.
#. a crawl's word count and page count, in the list of crawls.
#, python-format
msgid "%(n)s word"
msgid_plural "%(n)s words"
msgstr[0] "%(n)s parola"
msgstr[1] "%(n)s parole"

#, python-format
msgid "%(n)s word added up, each page once"
msgid_plural "%(n)s words added up, each page once"
msgstr[0] "%(n)s parola conteggiata, ogni pagina una volta"
msgstr[1] "%(n)s parole aggiunte in totale, ogni pagina una volta"

#, python-format
msgid "%(n)s word checked by page only."
msgid_plural "%(n)s words checked by page only."
msgstr[0] "%(n)s parola controllata solo dalla pagina."
msgstr[1] "%(n)s parole controllate solo per pagina."

#. under a sketch of a web page, how many of its words were counted.
#. %(n)s is the number, in bold.
#, python-format
msgid "%(n)s word counted"
msgid_plural "%(n)s words counted"
msgstr[0] "%(n)s parola conteggiata"
msgstr[1] "%(n)s parole conteggiate"

#, python-format
msgid "%(n)s word in sentences"
msgid_plural "%(n)s words in sentences"
msgstr[0] "%(n)s parola nelle frasi"
msgstr[1] "%(n)s parole nelle frasi"

#. a promotion on the report; %(n)s is the report's word count, in bold.
#. the headline of the wxrks offer, in the crawl email
#. and on the report. %(n)s is the site's word count.
#, python-format
msgid "%(n)s word to translate."
msgid_plural "%(n)s words to translate."
msgstr[0] "%(n)s parola da tradurre."
msgstr[1] "%(n)s parole da tradurre."

#, python-format
msgid "%(name)s (you)"
msgstr "%(name)s (tu)"

#. Translators: %(pct)s is a percentage (64%%), %(folder)s a folder such
#. as /blog, %(words)s a number of words; the plural follows the pages.
#, python-format
msgid "%(pct)s of the words are in %(folder)s: %(words)s on %(n)s page."
msgid_plural "%(pct)s of the words are in %(folder)s: %(words)s on %(n)s pages."
msgstr[0] "%(pct)s delle parole si trovano in %(folder)s: %(words)s in %(n)s pagina."
msgstr[1] "%(pct)s delle parole si trovano in %(folder)s: %(words)s su %(n)s pagine."

#. a percentage in a table cell ("12%"); add the space or sign your language
#. uses.
#, python-format
msgctxt "percent"
msgid "%(pct)s%%"
msgstr "%(pct)s%%"

#, python-format
msgid "%(pct)s%% measured on every count, by sentence."
msgstr "%(pct)s%% misurato a ogni conteggio, per frase."

#. %(pct)s is a percentage of the words; %(new)s is a number of words.
#, python-format
msgid "%(pct)s%% of it repeats text from other pages; %(new)s word is new."
msgid_plural "%(pct)s%% of it repeats text from other pages; %(new)s words are new."
msgstr[0] "%(pct)s%% del testo è ripetuto da altre pagine; %(new)s parola è nuova."
msgstr[1] "%(pct)s%% del testo si ripete in altre pagine; %(new)s parole sono nuove."

#, python-format
msgid "%(pct)s%% repeated in its own report"
msgstr "Ripetuto %(pct)s%% nel proprio report"

#, python-format
msgid "%(person)s shared a report with you"
msgstr "%(person)s ha condiviso un report con te"

#. Translators: the subject of the email inviting someone to a report.
#. %(person)s is the sender's name, or their email address.
#, python-format
msgid "%(person)s shared a word-count report with you"
msgstr "%(person)s ha condiviso con te un report sul conteggio delle parole"

#. Translators: the first line of the README inside a Markdown download.
#. %(product)s is the product's name; %(site)s is the address crawled.
#, python-format
msgid "%(product)s — saved Markdown for %(site)s"
msgstr "%(product)s — Markdown salvato per %(site)s"

#. Translators: the crawl email's subject line. %(status)s is "Crawl
#. finished", "Crawl failed" or "Crawl stopped"; %(site)s is the address
#. that was crawled.
#, python-format
msgid "%(status)s: %(site)s"
msgstr "%(status)s: %(site)s"

#. under the product name on the sign-in page. %(tagline)s is          the
#. product's tagline, such as "Count every word on a website".
#, python-format
msgid "%(tagline)s. Sign in to point it at your own site."
msgstr "%(tagline)s. Accedi per indirizzarlo al tuo sito."

#. Translators: the inbox preview of the crawl-finished email.
#. %(words)s is "1,234 words" and %(pages)s is "56 pages", each
#. already in the plural form its number needs.
#, python-format
msgid "%(words)s across %(pages)s"
msgstr "%(words)s su %(pages)s"

#. an assistant's answer: "2,696,246 words on 2,494 pages".        %(words)s is
#. "N words" and %(pages)s is "N pages", each translated on its own.
#, python-format
msgid "%(words)s on %(pages)s"
msgstr "%(words)s su %(pages)s"

#. Translators: crawl speed, abbreviated; %(words)s and %(pages)s are numbers.
#, python-format
msgid "%(words)s words/min · %(pages)s pages/min"
msgstr "%(words)s parole/min · %(pages)s pagine/min"

msgid "(root)"
msgstr "(root)"

#. what goes between the items of a list ("A, B"). Use your        language's
#. list punctuation, such as "、" or "، ".
#. what goes between the items of a list of site names ("a.com, b.com").    Use
#. your language's list punctuation, such as "、" or "، ".
msgctxt "list separator"
msgid ", "
msgstr ", "

msgid "A chat transcript."
msgstr "Una trascrizione di chat."

msgid "A count you can check, not just a number"
msgstr "Un conteggio che puoi verificare, non solo un numero"

msgid "A page or a sentence on more than one site is counted once."
msgstr ""
"Una pagina o una frase presente su più siti viene conteggiata una sola "
"volta."

msgid "A report link, a CSV of every page, the text as Markdown."
msgstr "Un link al report, un CSV di ogni pagina, il testo in formato Markdown."

msgid "A report you can send"
msgstr "Un report che puoi inviare"

msgid ""
"A run can be in more than one project. In each, a page found in several "
"crawls counts once."
msgstr ""
"Un'esecuzione può appartenere a più di un progetto. In ciascuno, una "
"pagina trovata in più scansioni viene conteggiata una sola volta."

msgid "A website has 200 pages. But how much work is that?"
msgstr "Un sito web ha 200 pagine. Ma quanto lavoro comporta?"

#. Translators: the inbox preview of that email. %(site)s is a web address.
#, python-format
msgid "A word count for %(site)s"
msgstr "Conteggio parole per %(site)s"

#. an assistant's advice on what to put in a translation quote.
#, python-format
msgid ""
"About %(words)s word, without the machine-generated API docs and the user"
" forum."
msgid_plural ""
"About %(words)s words, without the machine-generated API docs and the "
"user forum."
msgstr[0] ""
"Circa %(words)s parola, senza la documentazione API generata "
"automaticamente e il forum degli utenti."
msgstr[1] ""
"Circa %(words)s parole, senza la documentazione API generata "
"automaticamente e il forum degli utenti."

#. %(n)s and %(raw)s are whole-number multiples ("3", "4").
#, python-format
msgid ""
"About “%(n)s× faster” is measured, not arithmetic. Pro fetches %(raw)s× "
"as many pages at once, but fetching is only part of the work — every page"
" is also rendered and its text extracted, and that competes for CPU. The "
"honest number is the smaller one."
msgstr ""
"Informazioni su “%(n)s× più veloce”: è una misura, non un calcolo "
"aritmetico. Pro recupera %(raw)s× più pagine alla volta, ma il recupero è"
" solo una parte del lavoro: ogni pagina viene anche renderizzata e il suo"
" testo estratto, e questo richiede CPU. Il numero corretto è quello più "
"basso."

msgid "Add"
msgstr "Aggiungi"

msgid ""
"Add --scope user to have it in every project. Then type /mcp in Claude "
"Code to check that word-counter is connected, and ask away."
msgstr ""
"Aggiungi --scope user per averlo in ogni progetto. Poi digita /mcp in "
"Claude Code per verificare che word-counter sia connesso, e chiedi pure."

#. Translators: placeholder in the exclusions box once it holds an entry.
msgid "Add another…"
msgstr "Aggiungi un altro…"

#, python-format
msgid "Add existing runs to %(name)s"
msgstr "Aggiungi le esecuzioni esistenti a %(name)s"

#. opens a dialog for adding earlier crawls to this project.
msgid "Add existing runs…"
msgstr "Aggiungi esecuzioni esistenti…"

msgid "Add it to your app"
msgstr "Aggiungilo alla tua app"

msgid "Add people by email"
msgstr "Aggiungi persone tramite e-mail"

msgid "Add the crawls you already have, or crawl a site straight into it."
msgstr ""
"Aggiungi le scansioni che hai già oppure esegui una scansione "
"direttamente su un sito."

#. a button that opens a dialog for choosing projects.
msgid "Add to a project…"
msgstr "Aggiungi a un progetto…"

msgid "Add to project"
msgstr "Aggiungi al progetto"

msgid "Add to project…"
msgstr "Aggiungi al progetto…"

msgid "Added since the last consolidation — in the next one."
msgstr "Aggiunto dall’ultimo consolidamento — nel prossimo."

msgid "Added up: every page of every crawl"
msgstr "Totale: ogni pagina di ogni scansione"

msgid "Added up: every page of every site"
msgstr "Totale: ogni pagina di ogni sito"

msgid "Address shown on this report"
msgstr "Indirizzo mostrato in questo report"

msgid "Adjust settings"
msgstr "Modifica le impostazioni"

msgid "Advanced"
msgstr "Avanzate"

#. a link to a comparison table; %(n)s is how many rows it has.
#, python-format
msgid "All %(n)s differences, side by side"
msgid_plural "All %(n)s differences, side by side"
msgstr[0] "Tutte le %(n)s differenze, affiancate"
msgstr[1] "Tutte e %(n)s le differenze, affiancate"

msgid "All crawls"
msgstr "Tutte le scansioni del sito"

msgid "All your crawls"
msgstr "Tutte le tue scansioni"

#. a heading with the number of crawls in brackets: "All your crawls (25)".
#, python-format
msgid "All your crawls (%(n)s)"
msgid_plural "All your crawls (%(n)s)"
msgstr[0] "Tutte le tue scansioni (%(n)s)"
msgstr[1] "Tutte le tue scansioni (%(n)s)"

msgid "All your runs are in this project already."
msgstr "Tutte le tue esecuzioni sono già in questo progetto."

msgid ""
"Already working in an AI assistant? Connect it to Word Counter and ask "
"about any website in plain words. The crawl runs on Word Counter’s "
"servers, and your assistant answers with the total, the repetition and "
"the split by language, with a link to the full report."
msgstr ""
"Stai già lavorando in un assistente IA? Collegalo a Word Counter e chiedi"
" informazioni su qualsiasi sito web con parole semplici. La scansione "
"viene eseguita sui server di Word Counter e il tuo assistente risponde "
"con il totale, le ripetizioni e la suddivisione per lingua, con un link "
"al report completo."

msgid "An AI assistant on its own"
msgstr "Un assistente IA autonomo"

msgid "An assistant answering with Word Counter"
msgstr "Un assistente che risponde con Word Counter"

msgid ""
"An assistant writes a new crawler every time, and its steps change from "
"one run to the next. Word Counter counts every site the same way, so next"
" month’s count compares with this one."
msgstr ""
"Un assistente scrive un nuovo crawler ogni volta e i suoi passaggi "
"cambiano da un’esecuzione all’altra. Word Counter conta ogni sito allo "
"stesso modo, così il conteggio del mese prossimo sarà confrontabile con "
"quello di questo mese."

msgid ""
"An estimate of the sentences repeated across pages, and the split by "
"language, section and subdomain — the numbers a quote is built on."
msgstr ""
"Una stima delle frasi ripetute tra le pagine e della suddivisione per "
"lingua, sezione e sottodominio: i numeri su cui si basa un preventivo."

msgid ""
"An estimate: each page is split into sentences, matched exactly across "
"the pages counted, as CAT tools do at their simplest. Your TMS analysis "
"will differ with its own segmentation, tags, numbers and translation "
"memory."
msgstr ""
"Una stima: ogni pagina viene suddivisa in frasi, abbinate esattamente tra"
" le pagine conteggiate, come fanno gli strumenti CAT nella loro forma più"
" semplice. La tua analisi TMS sarà diversa per segmentazione, tag, numeri"
" e memoria di traduzione."

msgid ""
"Any other app: use Streamable HTTP with the server URL and the key as a "
"Bearer token — or, if it only takes a URL, your personal URL."
msgstr ""
"Qualsiasi altra app: usa Streamable HTTP con l’URL del server e la chiave"
" come token Bearer oppure, se accetta solo un URL, il tuo URL personale."

msgid "Anyone with the link can view this project"
msgstr "Chiunque abbia il link può visualizzare questo progetto"

msgid "Anyone with the link can view this report"
msgstr "Chiunque abbia il link può visualizzare questo report"

msgid "Articles"
msgstr "Articoli"

msgid "Ask Claude or ChatGPT how many words a website has"
msgstr "Chiedi a Claude o ChatGPT quante parole contiene un sito web"

msgid "Ask Claude or ChatGPT. Get the real count."
msgstr "Chiedi a Claude o ChatGPT. Ottieni il conteggio esatto."

msgid "Ask about any website"
msgstr "Chiedi informazioni su qualsiasi sito web"

msgid "Ask your assistant the question it couldn’t answer before."
msgstr "Fai al tuo assistente la domanda a cui prima non sapeva rispondere."

#, python-format
msgid ""
"At %(n)s words, the crawl pauses and shows the projected word count, page"
" count and time remaining. When a sitemap is available, it helps check "
"the estimate."
msgstr ""
"A %(n)s parole, la scansione si mette in pausa e mostra il conteggio "
"stimato delle parole, il numero di pagine e il tempo rimanente. Quando è "
"disponibile una sitemap, aiuta a verificare la stima."

#. %(n)s is a number of words (where a count pauses to estimate).
#, python-format
msgid ""
"At about %(n)s word a count pauses with an estimate of the whole site. "
"Ask your assistant to continue and it counts every page."
msgid_plural ""
"At about %(n)s words a count pauses with an estimate of the whole site. "
"Ask your assistant to continue and it counts every page."
msgstr[0] ""
"A circa %(n)s parola, il conteggio si interrompe con una stima "
"dell’intero sito. Chiedi al tuo assistente di continuare e conterà ogni "
"pagina."
msgstr[1] ""
"A circa %(n)s parole, il conteggio si interrompe e mostra una stima "
"dell’intero sito. Chiedi al tuo assistente di continuare e conterà ogni "
"pagina."

msgid ""
"Available in English, Arabic, Chinese, French, German, Italian, Japanese,"
" Korean, Portuguese, Spanish and Swedish."
msgstr ""
"Disponibile in inglese, arabo, cinese, francese, tedesco, italiano, "
"giapponese, coreano, portoghese, spagnolo e svedese."

msgid "Available when the crawl finishes"
msgstr "Disponibile al termine della scansione"

msgid "Avg words / page"
msgstr "Media parole / pagina"

msgid "Before you count"
msgstr "Prima di contare"

msgid "Behind a login"
msgstr "Dietro un accesso"

msgid "Between"
msgstr "Tra le"

msgid "Big site? See the estimate before you keep going."
msgstr "Sito grande? Visualizza la stima prima di continuare."

msgid "Blocked by the host"
msgstr "Bloccato dall'host"

#. Translators: a page row's tooltip: the site refused the crawler.
msgid "Blocked by the host's bot detection"
msgstr "Bloccato dal rilevamento dei bot dell'host"

msgid "Blocked or failed pages"
msgstr "Pagine bloccate o non riuscite"

#. Translators: %(reason)s is the technical reason a page was blocked, often in
#. English.
#, python-format
msgid "Blocked: %(reason)s"
msgstr "Bloccato: %(reason)s"

msgid "Broken down where it's useful"
msgstr "Suddiviso dove è utile"

msgid "Built for translation quotes"
msgstr "Pensato per i preventivi di traduzione"

msgid "Built with AI"
msgstr "Realizzato con l'IA"

msgid "Busy server load"
msgstr "Carico elevato del server"

msgid "By folder"
msgstr "Per cartella"

msgid "By language"
msgstr "Per lingua"

msgid "By subdomain"
msgstr "Per sottodominio"

msgid "CMS and site builders"
msgstr "CMS e strumenti per creare siti web"

msgid "CSV export, Markdown ZIP, shareable reports"
msgstr "Esportazione CSV, ZIP Markdown, report condivisibili"

msgid "Cancel"
msgstr "Annulla"

msgid "Cancel anytime, from your billing page"
msgstr "Annulla in qualsiasi momento dalla pagina di fatturazione"

msgid "Cancel crawl"
msgstr "Annulla scansione"

msgid "Cancel every active crawl on the server? This cannot be undone."
msgstr ""
"Annullare tutte le scansioni attive sul server? Questa operazione non può"
" essere annullata."

msgid "Cancelled"
msgstr "Annullato"

msgid "Cancelling…"
msgstr "Annullamento in corso…"

#. Translators: %(reason)s says why, such as "the server was running out
#. of disk space".
#, python-format
msgid ""
"Capture stopped before the end of the crawl because %(reason)s, so this "
"archive covers only the pages listed above. The word count itself is "
"complete."
msgstr ""
"L'acquisizione si è interrotta prima della fine della scansione perché "
"%(reason)s, quindi questo archivio include solo le pagine elencate sopra."
" Il conteggio delle parole è completo."

msgid "Carries a large site past its estimate to the very last page."
msgstr "Porta un sito di grandi dimensioni oltre la stima, fino all’ultima pagina."

msgid "Change language"
msgstr "Cambia lingua"

msgid "Change the address this report shows"
msgstr "Modifica l’indirizzo mostrato da questo report"

msgid "Check staging content before launch"
msgstr "Controlla i contenuti di staging prima del lancio"

#. %(sites)s is a list of site names.
#, python-format
msgid ""
"Checked by page only: %(sites)s. These crawls kept no sentences and saved"
" no Markdown, so their pages count in full unless the same page is in "
"another crawl. A new crawl checks them sentence by sentence."
msgstr ""
"Verificato solo per pagina: %(sites)s. Queste scansioni non hanno "
"conservato frasi né salvato Markdown, quindi le loro pagine vengono "
"conteggiate per intero, a meno che la stessa pagina non sia presente in "
"un’altra scansione. Una nuova scansione li controlla frase per frase."

#. Translators: the name used for text in Chinese or Japanese characters,
#. which the language check can't tell apart.
msgid "Chinese or Japanese characters"
msgstr "Caratteri cinesi o giapponesi"

msgid "Choose Add custom connector."
msgstr "Seleziona Aggiungi connettore personalizzato."

msgid "Claude (claude.ai and Claude Desktop)"
msgstr "Claude (claude.ai e Claude Desktop)"

msgid "Claude (web and desktop)"
msgstr "Claude (web e desktop)"

msgid "Claude Code — paste in a terminal"
msgstr "Claude Code — incolla in un terminale"

msgid "Claude Code, writing its own crawler"
msgstr "Claude Code, che scrive il proprio crawler"

msgid "Claude alone vs. with Word Counter"
msgstr "Claude da solo vs. con Word Counter"

msgid "Claude with and without it →"
msgstr "Claude con e senza →"

msgid "Client view"
msgstr "Vista cliente"

msgid "Close"
msgstr "Chiudi"

msgid ""
"Comma-separated subdomains and folders to leave out. A leading / excludes"
" a folder, anything else a subdomain."
msgstr ""
"Sottodomini e cartelle separati da virgole da escludere. Una / iniziale "
"esclude una cartella, qualsiasi altro valore esclude un sottodominio."

msgid ""
"Comma-separated. A leading / excludes a folder, anything else a subdomain"
" — staging also matches web-staging.example.com. Useful with “Whole "
"domain”, which otherwise includes every subdomain, staging mirrors "
"included."
msgstr ""
"Separati da virgole. Una / iniziale esclude una cartella, qualsiasi altra"
" cosa un sottodominio: staging corrisponde anche a web-"
"staging.example.com. Utile con “Intero dominio”, che altrimenti include "
"tutti i sottodomini, comprese le copie di staging."

#. a button that opens the pricing page.
msgid "Compare plans"
msgstr "Confronta i piani"

msgid "Compare the word counts of our live site and our staging site."
msgstr ""
"Confronta il numero di parole del nostro sito online e del nostro sito di"
" staging."

msgid "Comparing sentences…"
msgstr "Confronto delle frasi…"

msgid "Completed"
msgstr "Completato"

msgid "Connect Claude or ChatGPT"
msgstr "Collega Claude o ChatGPT"

msgid "Connect Claude, ChatGPT or another assistant"
msgstr "Collega Claude, ChatGPT o un altro assistente"

msgid ""
"Connect Word Counter to Claude, ChatGPT, Cursor or any MCP client and ask"
" how many words a website has. It crawls every page and answers with the "
"real total, the repetition and the split by language."
msgstr ""
"Collega Word Counter a Claude, ChatGPT, Cursor o a qualsiasi client MCP e"
" chiedi quante parole contiene un sito web. Esegue la scansione di ogni "
"pagina e restituisce il totale effettivo, le ripetizioni e la "
"suddivisione per lingua."

msgid ""
"Connect Word Counter to your AI assistant. When you ask about a website, "
"it crawls every page and comes back with the real total — the same count "
"as our reports, not a guess from the homepage."
msgstr ""
"Collega Word Counter al tuo assistente IA. Quando chiedi informazioni su "
"un sito web, lo scansiona pagina per pagina e ti restituisce il totale "
"effettivo, lo stesso conteggio dei nostri report, non una stima basata "
"sulla homepage."

msgid "Connect an assistant"
msgstr "Collega un assistente"

msgid "Connect in three steps"
msgstr "Connettiti in tre passaggi"

msgid "Connect your assistant"
msgstr "Collega il tuo assistente"

msgid "Consolidate"
msgstr "Consolida"

msgid "Consolidate again"
msgstr "Consolida di nuovo"

#. %(date)s is when the project's totals were last worked out, filled in by the
#. browser.
#, python-format
msgid "Consolidated %(date)s"
msgstr "Consolidato %(date)s"

msgid "Consolidating"
msgstr "Consolidamento"

msgid "Consolidating…"
msgstr "Consolidamento…"

msgid "Copied"
msgstr "Copiato"

msgid "Copy"
msgstr "Copia"

msgid "Copy it now: this is the only time it’s shown. It works like a password."
msgstr ""
"Copialo ora: è l’unica volta in cui viene mostrato. Funziona come una "
"password."

msgid "Copy link"
msgstr "Copia link"

msgid "Could not reach billing"
msgstr "Impossibile raggiungere la fatturazione"

msgid ""
"Couldn't find a sign-in form there. Enter the address of the site's sign-"
"in page."
msgstr ""
"Non è stato possibile trovare un modulo di accesso. Inserisci l’indirizzo"
" della pagina di accesso del sito."

msgid "Couldn't load more pages."
msgstr "Impossibile caricare altre pagine."

msgid "Couldn't send — try again."
msgstr "Impossibile inviare: riprova."

msgid "Couldn’t delete this crawl. Try again."
msgstr "Impossibile eliminare questa scansione. Riprova."

msgid "Count a website"
msgstr "Conta un sito web"

#. Translators: shown after the product name in page titles
#. ("Word Counter — Count every word on a website") and on the sign-in page.
msgid "Count every word on a website"
msgstr "Conta ogni parola su un sito web"

msgid "Count my website’s words"
msgstr "Conta le parole del mio sito web"

msgid "Count only www.example.com — leave out its subdomains."
msgstr "Conta solo www.example.com — escludi i suoi sottodomini."

msgid "Count the content that belongs in your project"
msgstr "Conta i contenuti da includere nel tuo progetto"

msgid "Count the words on example.com and tell me how much of it repeats."
msgstr "Conta le parole su example.com e dimmi quante si ripetono."

#. %(product)s is the product's name.
#, python-format
msgid "Counted with %(product)s by wxrks"
msgstr "Conteggiato con %(product)s da wxrks"

msgid ""
"Counting relies on spaces between words, so totals for Chinese, Japanese "
"and Thai will be much too low."
msgstr ""
"Il conteggio si basa sugli spazi tra le parole, quindi i totali per "
"cinese, giapponese e thailandese saranno molto inferiori al reale."

msgid ""
"Counts a website: the total, pages, repetition, and the split by "
"language, section and subdomain, with a link to the full report. The "
"whole domain by default, or one host only. Reuses an earlier count of the"
" same site unless asked to count again."
msgstr ""
"Conta un sito web: il totale, le pagine, le ripetizioni e la suddivisione"
" per lingua, sezione e sottodominio, con un link al report completo. "
"L'intero dominio per impostazione predefinita, oppure un solo host. "
"Riutilizza un conteggio precedente dello stesso sito, a meno che non "
"venga richiesto di eseguirne un altro."

msgid "Counts each page once"
msgstr "Conta ogni pagina una sola volta"

#. Translators: %(checked)s and %(total)s are word counts; the sentence
#. says how much of the total the repetition estimate covers.
#, python-format
msgid "Covers %(checked)s of %(total)s word"
msgid_plural "Covers %(checked)s of %(total)s words"
msgstr[0] "Copre %(checked)s di %(total)s parola"
msgstr[1] "Copre %(checked)s di %(total)s parole"

#. Translators: the button that starts a crawl of the address typed in (a
#. verb).
#. the button that starts counting a website (a verb).
msgctxt "button"
msgid "Crawl"
msgstr "Scansione del sito"

#. a table column of crawls (a noun).
msgctxt "noun"
msgid "Crawl"
msgstr "Scansione"

msgid "Crawl a site"
msgstr "Esegui la scansione di un sito web"

msgid ""
"Crawl a website and count every word it contains — total, per page, per "
"folder."
msgstr ""
"Esegui la scansione di un sito web e conta tutte le parole che contiene: "
"in totale, per pagina e per cartella."

msgid "Crawl another site"
msgstr "Esegui la scansione di un altro sito web"

msgid ""
"Crawl any website and count every word — per page, per folder, in total. "
"Built for sizing translation projects, with CSV export and a shareable "
"report."
msgstr ""
"Esegui la scansione di qualsiasi sito web e conta tutte le parole: per "
"pagina, per cartella e in totale. Progettato per stimare le dimensioni "
"dei progetti di traduzione, con esportazione CSV e un report "
"condivisibile."

msgid ""
"Crawl any website and export every page as clean Markdown in a single "
"ZIP. Main content only — ready to feed a language model, a RAG pipeline "
"or a CMS migration."
msgstr ""
"Esegui la scansione di qualsiasi sito web ed esporta tutte le pagine in "
"Markdown pulito in un unico ZIP. Solo contenuto principale: pronto per "
"essere fornito a un modello linguistico, a una pipeline RAG o a una "
"migrazione CMS."

msgid "Crawl didn’t finish: counted only for what the other sites don’t have"
msgstr ""
"La scansione non è stata completata: conteggiati solo gli elementi che "
"gli altri siti non hanno"

msgid "Crawl failed"
msgstr "Scansione non riuscita"

#. Translators: the heading of the email sent when a crawl ends, and the
#. start of its subject line.
msgid "Crawl finished"
msgstr "Scansione completata"

msgid "Crawl stopped"
msgstr "Scansione interrotta"

msgid "Crawled"
msgstr "Scansionato"

#. %(url)s is the address the crawl started from.
#, python-format
msgid "Crawled from %(url)s — only you see this."
msgstr "Scansionato da %(url)s — lo vedi solo tu."

msgid "Crawled signed in on the site’s sign-in page"
msgstr "Accesso effettuato durante la scansione nella pagina di accesso del sito"

#. Translators: %(date)s is the date and time of the crawl.
#, python-format
msgid "Crawled: %(date)s"
msgstr "Scansionato: %(date)s"

#. Translators: status badge: the crawl is reading pages right now.
msgid "Crawling"
msgstr "Scansione del sito"

msgid "Crawls"
msgstr "Scansioni"

msgid "Crawls run at full speed"
msgstr "Le scansioni vengono eseguite alla massima velocità"

msgid "Create"
msgstr "Crea"

msgid "Cursor — in ~/.cursor/mcp.json:"
msgstr "Cursor — in ~/.cursor/mcp.json:"

msgid "Cursor, VS Code and others"
msgstr "Cursor, VS Code e altri"

msgid ""
"Custom MCP servers depend on your ChatGPT plan and, in a workspace, on "
"what your admin allows."
msgstr ""
"I server MCP personalizzati dipendono dal tuo piano ChatGPT e, in un "
"workspace, da ciò che consente il tuo amministratore."

#. Translators: the language row for pages with no language in their address.
msgid "Default"
msgstr "Predefinito"

msgid "Delete project"
msgstr "Elimina progetto"

msgid "Delete run"
msgstr "Elimina esecuzione"

#. Translators: %(site)s is the address of the site that was crawled.
#, python-format
msgid "Delete this crawl of %(site)s? This can’t be undone."
msgstr ""
"Eliminare questa scansione di %(site)s? Questa operazione non può essere "
"annullata."

msgid ""
"Delete this project? Its crawls stay, in your runs and in any other "
"project."
msgstr ""
"Eliminare questo progetto? I suoi crawl restano nelle tue esecuzioni e in"
" qualsiasi altro progetto."

msgid "Delete this run and everything saved with it? This cannot be undone."
msgstr ""
"Eliminare questa scansione e tutto ciò che è stato salvato con essa? "
"Questa operazione non può essere annullata."

msgid "Deleting…"
msgstr "Eliminazione…"

msgid "Detected platform"
msgstr "Piattaforma rilevata"

#. Translators: %(cms)s is a platform's name, such as WordPress.
#, python-format
msgid "Detected platform: %(cms)s"
msgstr "Piattaforma rilevata: %(cms)s"

msgid "Detected platform: Contentful (headless — sitemap conventions vary)"
msgstr ""
"Piattaforma rilevata: Contentful (headless — le convenzioni delle sitemap"
" variano)"

msgid ""
"Didn’t finish: adds only the pages and sentences the crawls above don’t "
"have."
msgstr ""
"Non completato: aggiunge solo le pagine e le frasi che non sono presenti "
"nei crawl precedenti."

msgid "Didn’t load when the crawler asked for them."
msgstr "Non sono stati caricati quando il crawler li ha richiesti."

msgid ""
"Different pages, but at least half of their words are sentences another "
"crawl has."
msgstr ""
"Pagine diverse, ma almeno la metà delle parole sono frasi già presenti in"
" un’altra scansione."

msgid "Differs only by numbers"
msgstr "Differisce solo per i numeri"

msgid "Download Markdown"
msgstr "Scarica Markdown"

#. Translators: a button; %(size)s is a file size such as "12 MB".
#, python-format
msgid "Download Markdown · %(size)s"
msgstr "Scarica Markdown · %(size)s"

msgid "Download every page, with its new words (CSV)"
msgstr "Scarica ogni pagina, con le nuove parole (CSV)"

msgid "Download the pages in more than one crawl (CSV)"
msgstr "Scarica le pagine in più di una scansione (CSV)"

msgid "Download the repeated sentences (CSV)"
msgstr "Scarica le frasi ripetute (CSV)"

msgid "Duplicate of a page already counted"
msgstr "Duplicato di una pagina già conteggiata"

msgid "Duplicate pages"
msgstr "Pagine duplicate"

msgid "Duplicate pages within a crawl"
msgstr "Pagine duplicate in una scansione"

msgid "Duplicate · listed separately"
msgstr "Duplicato · elencato separatamente"

msgid ""
"Each page is opened in a real browser and counted only once it has "
"finished loading — usually a second or two more per page. Tools that read"
" a page the moment it appears finish sooner, but miss text that loads "
"afterwards; on some sites that’s whole sections."
msgstr ""
"Ogni pagina viene aperta in un browser reale e conteggiata solo dopo aver"
" terminato il caricamento: di solito ci vogliono uno o due secondi in più"
" per pagina. Gli strumenti che leggono una pagina appena viene "
"visualizzata terminano prima, ma non rilevano il testo caricato in "
"seguito; su alcuni siti, intere sezioni."

msgid ""
"Each page is opened in a real browser and counted only once it has "
"finished loading — usually a second or two more per page. Tools that read"
" a page the moment it appears finish sooner, but miss text that loads "
"afterwards; on some sites that’s whole sections. You don’t have to wait: "
"if you’re signed in, you’ll get an email when the crawl finishes."
msgstr ""
"Ogni pagina viene aperta in un browser reale e conteggiata solo dopo aver"
" terminato il caricamento: di solito ci vogliono uno o due secondi in più"
" per pagina. Gli strumenti che leggono una pagina appena viene "
"visualizzata terminano prima, ma non rilevano il testo caricato in "
"seguito; su alcuni siti, intere sezioni. Non devi aspettare: se hai "
"effettuato l’accesso, riceverai un’email al termine della scansione."

msgid ""
"Each page runs through a content filter that drops navigation and "
"repeated chrome. That's the difference between a corpus you can search "
"and one where every document matches the phrase “Book Now”."
msgstr ""
"Ogni pagina viene elaborata da un filtro dei contenuti che rimuove la "
"navigazione e gli elementi ripetuti dell’interfaccia. Questa è la "
"differenza tra un corpus in cui puoi effettuare ricerche e uno in cui "
"ogni documento corrisponde alla frase «Prenota ora»."

msgid ""
"Each site’s own report has its pages, its repetition estimate and what it"
" left out."
msgstr ""
"Il report di ogni sito include le sue pagine, la stima delle ripetizioni "
"e ciò che è stato tralasciato."

msgid "Easy server load"
msgstr "Carico del server ridotto"

msgid "Email"
msgstr "Email"

msgid "Email or username"
msgstr "Email o nome utente"

#. Translators: write the numbers the way your language does
#. (662.000 in German, 662 000 in French). "Tokens" are the units a
#. language model reads.
msgid ""
"English runs near 1.3 tokens per word. A 662,000-word site is about "
"880,000 tokens of clean text — as raw HTML it would be several times "
"that, nearly all of it markup."
msgstr ""
"L'inglese ha circa 1,3 token per parola. Un sito di 662.000 parole "
"corrisponde a circa 880.000 token di testo pulito: in HTML grezzo sarebbe"
" diverse volte tanto, quasi tutto markup."

msgid "Enter a web address, such as https://www.example.com."
msgstr "Inserisci un indirizzo web, ad esempio https://www.example.com."

msgid "Enter an email address to send the report to."
msgstr "Inserisci un indirizzo email a cui inviare il report."

msgid "Enter both the email (or username) and the password."
msgstr "Inserisci sia l’indirizzo email (o il nome utente) sia la password."

msgid "Enter the sign-in page as a web address, like https://example.com/login."
msgstr ""
"Inserisci la pagina di accesso come indirizzo web, ad esempio "
"https://example.com/login."

msgid "Enter your website URL"
msgstr "Inserisci l’URL del tuo sito web"

msgid "Estimate confidence"
msgstr "Stima la confidenza"

msgid "Estimate — before you crawl"
msgstr "Stima — prima di eseguire la scansione"

#. %(sites)s is a list of site names.
#, python-format
msgid ""
"Estimated from saved Markdown: %(sites)s. These crawls are from before "
"crawls kept their sentences, so their sentences come from the Markdown "
"they saved — main content only — and each page’s words are split in the "
"same proportions. A new crawl gives exact figures."
msgstr ""
"Stimato dal Markdown salvato: %(sites)s. Queste scansioni risalgono a "
"prima che le scansioni conservassero le frasi, quindi le frasi provengono"
" dal Markdown salvato — solo contenuto principale — e le parole di ogni "
"pagina sono suddivise nelle stesse proporzioni. Una nuova scansione "
"fornisce dati precisi."

msgid "Estimated total"
msgstr "Totale stimato"

msgid "Estimated total pages"
msgstr "Totale pagine stimate"

msgid "Estimated total time"
msgstr "Tempo totale stimato"

msgid ""
"Every file opens with the URL it came from, so nothing loses its source "
"on the way into a retrieval pipeline."
msgstr ""
"Ogni file si apre con l’URL di provenienza, così nulla perde la propria "
"origine durante il passaggio a una pipeline di recupero."

#. %(n)s is a number of pages fetched, in a card comparing two ways of
#. counting.
#, python-format
msgid "Every language crawled: %(n)s page."
msgid_plural "Every language crawled: %(n)s pages."
msgstr[0] "Ogni lingua sottoposta a scansione: %(n)s pagina."
msgstr[1] "Ogni lingua sottoposta a scansione: %(n)s pagine."

msgid ""
"Every page is rendered in a real browser, so content built by JavaScript "
"is counted. Tools that only fetch HTML report a fraction of the truth."
msgstr ""
"Ogni pagina viene renderizzata in un browser reale, quindi viene "
"conteggiato anche il contenuto generato da JavaScript. Gli strumenti che "
"recuperano solo l’HTML mostrano solo una parte della realtà."

msgid "Everything else"
msgstr "Tutto il resto"

msgid "Everything in Free"
msgstr "Tutto incluso nel piano Free"

msgid "Example"
msgstr "Esempio"

msgid "Exclude subdomains or folders"
msgstr "Escludi sottodomini o cartelle"

msgid "Exclude subdomains or folders before continuing"
msgstr "Escludi i sottodomini o le cartelle prima di continuare"

#. placeholder of a field of subdomains and folders to leave out; the examples
#. may be adapted.
msgid "Exclude: staging, /careers"
msgstr "Escludi: staging, /careers"

#. Translators: a pill; %(entries)s is a list such as "staging (subdomain),
#. /careers (folder)".
#, python-format
msgid "Excluded: %(entries)s"
msgstr "Esclusi: %(entries)s"

msgid "Excluded: none"
msgstr "Esclusi: nessuno"

msgid "Export"
msgstr "Esporta"

msgid "Export CSV"
msgstr "Esporta CSV"

msgid "Failed"
msgstr "Non riuscito"

msgid "Failed to fetch page"
msgstr "Impossibile recuperare la pagina"

msgid "Failed to load"
msgstr "Caricamento non riuscito"

#. Translators: %(reason)s is the technical reason a page failed, often in
#. English.
#, python-format
msgid "Failed: %(reason)s"
msgstr "Non riuscito: %(reason)s"

msgid "Find out how much work is on your website."
msgstr "Scopri quanto lavoro c’è sul tuo sito web."

msgid ""
"Find your longest pages and most content-heavy folders. Export a CSV with"
" each page’s URL, title and word count to help build your scope."
msgstr ""
"Trova le pagine più lunghe e le cartelle con più contenuti. Esporta un "
"CSV con l’URL, il titolo e il conteggio delle parole di ogni pagina per "
"definire l’ambito del progetto."

msgid "Folder"
msgstr "Cartella"

msgid "Folders"
msgstr "Cartelle"

msgid ""
"Follows a count that’s still running, and returns the result when it’s "
"done."
msgstr "Segue un conteggio ancora in corso e restituisce il risultato al termine."

msgid "Footer · not counted"
msgstr "Piè di pagina · non conteggiato"

msgid "For Claude and ChatGPT"
msgstr "Per Claude e ChatGPT"

msgid ""
"For a site that asks for a username and password in a browser pop-up, "
"like most staging sites. Sent only to that site, used only for this "
"crawl, never stored."
msgstr ""
"Per un sito che richiede nome utente e password in un popup del browser, "
"come la maggior parte dei siti di staging. Inviato solo a quel sito, "
"utilizzato solo per questa scansione e mai archiviato."

msgid ""
"For a site where you sign in with an email and password. The crawler "
"signs in before it starts and crawls as that account, so use one that can"
" only read; it never opens a log-out, delete or cancel link. Sent only to"
" that site, used only for this crawl, never stored."
msgstr ""
"Per un sito a cui accedi con un indirizzo email e una password. Il "
"crawler accede prima di iniziare e scansiona il sito con quell’account, "
"quindi usane uno con soli permessi di lettura; non apre mai link per "
"uscire, eliminare o annullare. Inviato solo a quel sito, utilizzato solo "
"per questa scansione e mai archiviato."

msgid "For developers"
msgstr "Per sviluppatori"

msgid ""
"For staging sites protected by a browser username-and-password pop-up, "
"enter the credentials to run the crawl. They’re sent only to that site, "
"used only for that crawl and never stored."
msgstr ""
"Per eseguire la scansione dei siti di staging protetti da una finestra "
"pop-up del browser che richiede nome utente e password, inserisci le "
"credenziali. Vengono inviati solo a quel sito, usati solo per quella "
"scansione e non vengono mai archiviati."

msgid "For your client"
msgstr "Per il tuo cliente"

#, python-format
msgid ""
"Found a sitemap — this site has approximately %(n)s page. Crawling all of"
" them may take a while."
msgid_plural ""
"Found a sitemap — this site has approximately %(n)s pages. Crawling all "
"of them may take a while."
msgstr[0] ""
"Trovata una sitemap: questo sito ha circa %(n)s pagina. La scansione di "
"tutti potrebbe richiedere un po' di tempo."
msgstr[1] ""
