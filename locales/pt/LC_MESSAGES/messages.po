msgstr "subdomínio"

msgid "text changed — counted from the crawl listed first"
msgstr "texto alterado — contado a partir do primeiro rastreamento listado"

msgid "the server reached the most Markdown it keeps"
msgstr "o servidor atingiu o limite máximo de Markdown que mantém"

