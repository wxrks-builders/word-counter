msgstr "Esta varredura levou %(took)s. No Pro: %(pro)s."

msgid "This crawl was cancelled — showing partial results."
msgstr "Esta varredura foi cancelada — exibindo resultados parciais."

msgid ""
"This crawl was paused for an estimate and never resumed — showing partial"
" results from before the pause."
msgstr ""
"Esta varredura foi pausada para gerar uma estimativa e nunca foi retomada"
" — exibindo resultados parciais de antes da pausa."

msgid ""
"This crawl was stopped automatically — it was using too much memory to "
"continue safely on this server."
msgstr ""
"Esta varredura foi interrompida automaticamente — estava usando memória "
"demais para continuar com segurança neste servidor."

msgid ""
"This crawl was stopped before it finished, so the report shows partial "
"results."
msgstr ""
"Esta varredura foi interrompida antes de ser concluída, então o relatório"
" mostra resultados parciais."

