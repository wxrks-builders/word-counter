#. Translators: one exclusion in the settings pill: %(entry)s is what was
#. typed, %(kind)s is "folder" or "subdomain".
#, python-format
msgid "%(entry)s (%(kind)s)"
msgstr "%(entry)s（%(kind)s）"

#. Translators: a duration in hours, abbreviated ("3h").
#, python-format
msgid "%(h)sh"
msgstr "%(h)sh"

#. Translators: a duration, abbreviated: h is hours, m is minutes ("1h 8m").
#, python-format
msgid "%(h)sh %(m)sm"
msgstr "%(h)sh %(m)sm"

#. Translators: one line of the plain-text email: a label and its value
#. ("Total words: 1,234"). Keep both placeholders.
#, python-format
msgid "%(label)s: %(value)s"
msgstr "%(label)s：%(value)s"

#. Translators: beside "Show more": %(loaded)s of %(total)s pages shown.
#, python-format
msgid "%(loaded)s of %(total)s"
msgstr "%(loaded)s / %(total)s"

#. Translators: part of the "Not counted" line; %(n)s counts pages
#. that asked for a sign-in. Agree with "pages" where your language must.
#, python-format
msgid "%(n)s behind a login"
msgid_plural "%(n)s behind a login"
msgstr[0] "登录后 %(n)s 个"

#. Translators: part of the "Not counted" line; %(n)s counts pages the
#. site's bot protection refused. Agree with "pages" where your language must.
#, python-format
msgid "%(n)s blocked"
msgid_plural "%(n)s blocked"
msgstr[0] "%(n)s 个已屏蔽"

#. how many crawls a project holds, in a project's one-line summary.
#. how many crawls the project holds, then how many of them are still running.
#. a project's crawl count, then its words added up across those crawls.
#, python-format
msgid "%(n)s crawl"
msgid_plural "%(n)s crawls"
msgstr[0] "%(n)s 次抓取"

#. Translators: the next four are parts of a short line under "Not
#. counted": "3 duplicates · 2 blocked". Keep them short.
#, python-format
msgid "%(n)s duplicate"
msgid_plural "%(n)s duplicates"
msgstr[0] "%(n)s 个重复项"

#, python-format
msgid "%(n)s duplicate page isn’t in the total at all."
msgid_plural "%(n)s duplicate pages aren’t in the total at all."
msgstr[0] "%(n)s 个重复页面完全不计入总数。"

#, python-format
msgid "%(n)s duplicate page within the sites."
msgid_plural "%(n)s duplicate pages within the sites."
msgstr[0] "这些网站中有 %(n)s 个重复页面。"

#. Translators: part of the "Not counted" line; %(n)s counts pages that
#. didn't load. Agree with "pages" where your language must.
#, python-format
msgid "%(n)s failed"
msgid_plural "%(n)s failed"
msgstr[0] "%(n)s 次失败"

#. how many Markdown files are in the ZIP download.
#, python-format
msgid "%(n)s file"
msgid_plural "%(n)s files"
msgstr[0] "%(n)s 个文件"

#. after the label "Subdomains": %(n)s subdomains were found,        and
#. %(words)s is "N more words", translated on its own.
#, python-format
msgid "%(n)s found, with %(words)s, each on its own line."
msgid_plural "%(n)s found, with %(words)s, each on its own line."
msgstr[0] "找到 %(n)s 个，包含 %(words)s，每个单独占一行。"

#. Translators: a duration in minutes, abbreviated ("25 min").
#. how long a count took, in minutes, abbreviated.
#, python-format
msgid "%(n)s min"
msgid_plural "%(n)s min"
msgstr[0] "%(n)s 分钟"

#. Translators: more pages in that language that weren't fetched at all.
#, python-format
msgid "%(n)s more not fetched"
msgid_plural "%(n)s more not fetched"
msgstr[0] "还有 %(n)s 个未抓取"

#, python-format
msgid "%(n)s more word"
msgid_plural "%(n)s more words"
msgstr[0] "还有 %(n)s 个词"

#, python-format
msgid "%(n)s new word"
msgid_plural "%(n)s new words"
msgstr[0] "%(n)s 个新词"

#. Translators: a page count, as part of a longer sentence.
#. how much two sites share: a number of pages, then a number of words in
#. shared sentences.
#, python-format
msgid "%(n)s page"
msgid_plural "%(n)s pages"
msgstr[0] "%(n)s 个页面"

#. how many pages a plan fetches at the same time.
#, python-format
msgid "%(n)s page at a time"
msgid_plural "%(n)s pages at a time"
msgstr[0] "每次处理 %(n)s 个页面"

#, python-format
msgid "%(n)s page behind a sign-in."
msgid_plural "%(n)s pages behind a sign-in."
msgstr[0] "%(n)s 个需要登录才能访问的页面。"

#, python-format
msgid "%(n)s page failed to load."
msgid_plural "%(n)s pages failed to load."
msgstr[0] "%(n)s 个页面加载失败。"

#, python-format
msgid "%(n)s page was blocked by this site's own bot detection."
msgid_plural "%(n)s pages were blocked by this site's own bot detection."
msgstr[0] "此网站自身的机器人检测机制拦截了 %(n)s 个页面。"

#. Translators: pages in another language that were fetched, then left
#. out of the count.
#, python-format
msgid "%(n)s read and set aside"
msgid_plural "%(n)s read and set aside"
msgstr[0] "%(n)s 已读并搁置"

#. pages matched only by their address, because their text wasn't kept to
#. compare; %(n)s is a number of pages.
#, python-format
msgid "%(n)s same address"
msgid_plural "%(n)s same address"
msgstr[0] "%(n)s 个相同地址"

#. under a pair of sites, how many of their shared pages have
#. the same text, changed text, or only the same address. Each %(n)s is a
#. number of pages.
#, python-format
msgid "%(n)s same text"
msgid_plural "%(n)s same text"
msgstr[0] "%(n)s 相同文本"

#. after the number of crawls in a project: how many of them are still running.
#, python-format
msgid "%(n)s still crawling"
msgid_plural "%(n)s still crawling"
msgstr[0] "仍在抓取 %(n)s 个网站"

#. shared pages whose text differs between the two sites; %(n)s is a number of
#. pages.
#, python-format
msgid "%(n)s text changed"
msgid_plural "%(n)s text changed"
msgstr[0] "%(n)s 处文本已更改"

#. %(n)s is a number of translated pages the crawl skipped.
#, python-format
msgid "%(n)s translated page set aside, never fetched."
msgid_plural "%(n)s translated pages set aside, never fetched."
msgstr[0] "已搁置 %(n)s 个已翻译页面，未抓取。"

#. Translators: a word count, as part of a longer sentence.
#. a site's word count, in a small chip beside its address.
#. a crawl's word count and page count, in the list of crawls.
#, python-format
msgid "%(n)s word"
msgid_plural "%(n)s words"
msgstr[0] "%(n)s 个词"

#, python-format
msgid "%(n)s word added up, each page once"
msgid_plural "%(n)s words added up, each page once"
msgstr[0] "共添加了 %(n)s 个词，每个页面仅计一次"

#, python-format
msgid "%(n)s word checked by page only."
msgid_plural "%(n)s words checked by page only."
msgstr[0] "仅按页面检查了 %(n)s 个词。"

#. under a sketch of a web page, how many of its words were counted.
#. %(n)s is the number, in bold.
#, python-format
msgid "%(n)s word counted"
msgid_plural "%(n)s words counted"
msgstr[0] "已统计 %(n)s 个词"

#, python-format
msgid "%(n)s word in sentences"
msgid_plural "%(n)s words in sentences"
msgstr[0] "句子中的 %(n)s 个单词"

#. a promotion on the report; %(n)s is the report's word count, in bold.
#. the headline of the wxrks offer, in the crawl email
#. and on the report. %(n)s is the site's word count.
#, python-format
msgid "%(n)s word to translate."
msgid_plural "%(n)s words to translate."
msgstr[0] "%(n)s 个待翻译单词。"

#, python-format
msgid "%(name)s (you)"
msgstr "%(name)s（您）"

#. Translators: %(pct)s is a percentage (64%%), %(folder)s a folder such
#. as /blog, %(words)s a number of words; the plural follows the pages.
#, python-format
msgid "%(pct)s of the words are in %(folder)s: %(words)s on %(n)s page."
msgid_plural "%(pct)s of the words are in %(folder)s: %(words)s on %(n)s pages."
msgstr[0] "%(pct)s 的词语位于 %(folder)s 中：%(n)s 个页面上共有 %(words)s 个词语。"

#. a percentage in a table cell ("12%"); add the space or sign your language
#. uses.
#, python-format
msgctxt "percent"
msgid "%(pct)s%%"
msgstr "%(pct)s%%"

#, python-format
msgid "%(pct)s%% measured on every count, by sentence."
msgstr "每次计数均按句子测量 %(pct)s%%。"

#. %(pct)s is a percentage of the words; %(new)s is a number of words.
#, python-format
msgid "%(pct)s%% of it repeats text from other pages; %(new)s word is new."
msgid_plural "%(pct)s%% of it repeats text from other pages; %(new)s words are new."
msgstr[0] "其中 %(pct)s%% 的内容与其他页面的文本重复；新增了 %(new)s 个词。"

#, python-format
msgid "%(pct)s%% repeated in its own report"
msgstr "在其自身报告中重复 %(pct)s%% 次"

#, python-format
msgid "%(person)s shared a report with you"
msgstr "%(person)s 与您分享了一份报告"

#. Translators: the subject of the email inviting someone to a report.
#. %(person)s is the sender's name, or their email address.
#, python-format
msgid "%(person)s shared a word-count report with you"
msgstr "%(person)s 与您分享了一份字数统计报告"

#. Translators: the first line of the README inside a Markdown download.
#. %(product)s is the product's name; %(site)s is the address crawled.
#, python-format
msgid "%(product)s — saved Markdown for %(site)s"
msgstr "%(product)s — %(site)s 的已保存 Markdown"

#. Translators: the crawl email's subject line. %(status)s is "Crawl
#. finished", "Crawl failed" or "Crawl stopped"; %(site)s is the address
#. that was crawled.
#, python-format
msgid "%(status)s: %(site)s"
msgstr "%(status)s：%(site)s"

#. under the product name on the sign-in page. %(tagline)s is          the
#. product's tagline, such as "Count every word on a website".
#, python-format
msgid "%(tagline)s. Sign in to point it at your own site."
msgstr "%(tagline)s。 登录后即可将其指向您自己的网站。"

#. Translators: the inbox preview of the crawl-finished email.
#. %(words)s is "1,234 words" and %(pages)s is "56 pages", each
#. already in the plural form its number needs.
#, python-format
msgid "%(words)s across %(pages)s"
msgstr "%(pages)s 个页面共 %(words)s 个词"

#. an assistant's answer: "2,696,246 words on 2,494 pages".        %(words)s is
#. "N words" and %(pages)s is "N pages", each translated on its own.
#, python-format
msgid "%(words)s on %(pages)s"
msgstr "%(pages)s 个页面上有 %(words)s 个词"

#. Translators: crawl speed, abbreviated; %(words)s and %(pages)s are numbers.
#, python-format
msgid "%(words)s words/min · %(pages)s pages/min"
msgstr "每分钟 %(words)s 个单词 · 每分钟 %(pages)s 页"

msgid "(root)"
msgstr "（根）"

#. what goes between the items of a list ("A, B"). Use your        language's
#. list punctuation, such as "、" or "، ".
#. what goes between the items of a list of site names ("a.com, b.com").    Use
#. your language's list punctuation, such as "、" or "، ".
msgctxt "list separator"
msgid ", "
msgstr "、"

msgid "A chat transcript."
msgstr "聊天记录。"

msgid "A count you can check, not just a number"
msgstr "可供核验的字数，而不只是一个数字"

msgid "A page or a sentence on more than one site is counted once."
msgstr "同一页面或句子即使出现在多个网站上，也只计数一次。"

msgid "A report link, a CSV of every page, the text as Markdown."
msgstr "报告链接、包含每个页面的 CSV 文件，以及 Markdown 格式的文本。"

msgid "A report you can send"
msgstr "可供您发送的报告"

msgid ""
"A run can be in more than one project. In each, a page found in several "
"crawls counts once."
msgstr "一次运行可以属于多个项目。 在每次抓取中，同一页面即使被发现多次也只计一次。"

msgid "A website has 200 pages. But how much work is that?"
msgstr "一个网站有 200 个页面。 但这需要多少工作量？"

#. Translators: the inbox preview of that email. %(site)s is a web address.
#, python-format
msgid "A word count for %(site)s"
msgstr "%(site)s 的字数统计"

#. an assistant's advice on what to put in a translation quote.
#, python-format
msgid ""
"About %(words)s word, without the machine-generated API docs and the user"
" forum."
msgid_plural ""
"About %(words)s words, without the machine-generated API docs and the "
"user forum."
msgstr[0] "约 %(words)s 个词，不包括机器生成的 API 文档和用户论坛。"

#. %(n)s and %(raw)s are whole-number multiples ("3", "4").
#, python-format
msgid ""
"About “%(n)s× faster” is measured, not arithmetic. Pro fetches %(raw)s× "
"as many pages at once, but fetching is only part of the work — every page"
" is also rendered and its text extracted, and that competes for CPU. The "
"honest number is the smaller one."
msgstr ""
"关于“%(n)s× 更快”：这是实测结果，并非算术计算。 Pro 每次可抓取的页面数量是 "
"%(raw)s×，但抓取只是工作的一部分——每个页面还需要渲染并提取文本，这些操作都会占用 CPU。 真实的数字是较小的那个。"

msgid "Add"
msgstr "添加"

msgid ""
"Add --scope user to have it in every project. Then type /mcp in Claude "
"Code to check that word-counter is connected, and ask away."
msgstr ""
"添加 --scope user，使其在每个项目中都可用。 然后在 Claude Code 中输入 /mcp，检查 word-counter "
"是否已连接，然后就可以开始提问了。"

#. Translators: placeholder in the exclusions box once it holds an entry.
msgid "Add another…"
msgstr "再添加一个…"

#, python-format
msgid "Add existing runs to %(name)s"
msgstr "将现有运行添加到 %(name)s"

#. opens a dialog for adding earlier crawls to this project.
msgid "Add existing runs…"
msgstr "添加现有运行…"

msgid "Add it to your app"
msgstr "将其添加到您的应用中"

msgid "Add people by email"
msgstr "通过电子邮件添加人员"

msgid "Add the crawls you already have, or crawl a site straight into it."
msgstr "添加您已有的抓取记录，或直接抓取网站并将结果添加到其中。"

#. a button that opens a dialog for choosing projects.
msgid "Add to a project…"
msgstr "添加到项目…"

msgid "Add to project"
msgstr "添加到项目"

msgid "Add to project…"
msgstr "添加到项目…"

msgid "Added since the last consolidation — in the next one."
msgstr "自上次整合后新增 — 将在下次整合时处理。"

msgid "Added up: every page of every crawl"
msgstr "合计：每次抓取的每个页面"

msgid "Added up: every page of every site"
msgstr "总计：每个网站的每个页面"

msgid "Address shown on this report"
msgstr "此报告中显示的地址"

msgid "Adjust settings"
msgstr "调整设置"

msgid "Advanced"
msgstr "高级"

#. a link to a comparison table; %(n)s is how many rows it has.
#, python-format
msgid "All %(n)s differences, side by side"
msgid_plural "All %(n)s differences, side by side"
msgstr[0] "全部 %(n)s 处差异，并排显示"

msgid "All crawls"
msgstr "所有抓取任务"

msgid "All your crawls"
msgstr "您的所有抓取任务"

#. a heading with the number of crawls in brackets: "All your crawls (25)".
#, python-format
msgid "All your crawls (%(n)s)"
msgid_plural "All your crawls (%(n)s)"
msgstr[0] "您的所有抓取（%(n)s）"

msgid "All your runs are in this project already."
msgstr "您的所有运行都已在此项目中。"

msgid ""
"Already working in an AI assistant? Connect it to Word Counter and ask "
"about any website in plain words. The crawl runs on Word Counter’s "
"servers, and your assistant answers with the total, the repetition and "
"the split by language, with a link to the full report."
msgstr ""
"已经在使用 AI 助手了吗？将其连接到 Word Counter，然后用通俗的语言询问任何网站相关的问题。 抓取任务在 Word Counter "
"的服务器上运行，您的助手会提供总字数、重复内容和按语言划分的字数，并附上完整报告的链接。"

msgid "An AI assistant on its own"
msgstr "独立运行的 AI 助手"

msgid "An assistant answering with Word Counter"
msgstr "使用 Word Counter 回答的助手"

msgid ""
"An assistant writes a new crawler every time, and its steps change from "
"one run to the next. Word Counter counts every site the same way, so next"
" month’s count compares with this one."
msgstr ""
"助手每次都会编写一个新的爬虫，其步骤也会随着每次运行而变化。 Word Counter "
"对所有网站采用相同的计数方式，因此下个月的计数可以与本月进行比较。"

msgid ""
"An estimate of the sentences repeated across pages, and the split by "
"language, section and subdomain — the numbers a quote is built on."
msgstr "对跨页面重复句子的估算，以及按语言、版块和子域名划分的明细——报价据此计算。"

msgid ""
"An estimate: each page is split into sentences, matched exactly across "
"the pages counted, as CAT tools do at their simplest. Your TMS analysis "
"will differ with its own segmentation, tags, numbers and translation "
"memory."
msgstr ""
"估算值：每个页面都会拆分成句子，并在统计的各个页面之间进行精确匹配，就像 CAT 工具最基本的工作方式一样。 您的 TMS "
"分析会因其自身的分段、标签、数字和翻译记忆而有所不同。"

msgid ""
"Any other app: use Streamable HTTP with the server URL and the key as a "
"Bearer token — or, if it only takes a URL, your personal URL."
msgstr ""
"其他应用：使用 Streamable HTTP，并填写服务器 URL 和作为 Bearer 令牌的密钥；如果应用只接受 URL，则使用您的个人 "
"URL。"

msgid "Anyone with the link can view this project"
msgstr "任何拥有此链接的人都可以查看此项目"

msgid "Anyone with the link can view this report"
msgstr "任何拥有此链接的人都可以查看此报告"

msgid "Articles"
msgstr "文章"

msgid "Ask Claude or ChatGPT how many words a website has"
msgstr "询问 Claude 或 ChatGPT 网站有多少个单词"

msgid "Ask Claude or ChatGPT. Get the real count."
msgstr "询问 Claude 或 ChatGPT。 获取准确字数。"

msgid "Ask about any website"
msgstr "咨询任何网站的信息"

msgid "Ask your assistant the question it couldn’t answer before."
msgstr "向您的助手提出它之前无法回答的问题。"

#, python-format
msgid ""
"At %(n)s words, the crawl pauses and shows the projected word count, page"
" count and time remaining. When a sitemap is available, it helps check "
"the estimate."
msgstr "达到 %(n)s 个词后，抓取会暂停，并显示预计词数、页面数和剩余时间。 如果有站点地图，就能帮助核对估算结果。"

#. %(n)s is a number of words (where a count pauses to estimate).
#, python-format
msgid ""
"At about %(n)s word a count pauses with an estimate of the whole site. "
"Ask your assistant to continue and it counts every page."
msgid_plural ""
"At about %(n)s words a count pauses with an estimate of the whole site. "
"Ask your assistant to continue and it counts every page."
msgstr[0] "大约统计到 %(n)s 个词时，计数会暂停，并显示整个网站的预估词数。 请让您的助手继续，它会统计每个页面。"

msgid ""
"Available in English, Arabic, Chinese, French, German, Italian, Japanese,"
" Korean, Portuguese, Spanish and Swedish."
msgstr "支持英语、阿拉伯语、中文、法语、德语、意大利语、日语、韩语、葡萄牙语、西班牙语和瑞典语。"

msgid "Available when the crawl finishes"
msgstr "抓取完成后即可使用"

msgid "Avg words / page"
msgstr "平均每页字数"

msgid "Before you count"
msgstr "开始统计之前"

msgid "Behind a login"
msgstr "登录后可见"

msgid "Between"
msgstr "介于"

msgid "Big site? See the estimate before you keep going."
msgstr "网站很大？继续操作前，先查看预估费用。"

msgid "Blocked by the host"
msgstr "被主机屏蔽了"

#. Translators: a page row's tooltip: the site refused the crawler.
msgid "Blocked by the host's bot detection"
msgstr "被主机的机器人检测机制拦截"

msgid "Blocked or failed pages"
msgstr "已屏蔽或加载失败的页面"

#. Translators: %(reason)s is the technical reason a page was blocked, often in
#. English.
#, python-format
msgid "Blocked: %(reason)s"
msgstr "已阻止：%(reason)s"

msgid "Broken down where it's useful"
msgstr "在有用的地方进行细分"

msgid "Built for translation quotes"
msgstr "专为翻译报价打造"

msgid "Built with AI"
msgstr "由 AI 构建"

msgid "Busy server load"
msgstr "服务器负载较高"

msgid "By folder"
msgstr "按文件夹分组"

msgid "By language"
msgstr "按语言分组"

msgid "By subdomain"
msgstr "按子域名分组"

msgid "CMS and site builders"
msgstr "CMS 和网站构建工具"

msgid "CSV export, Markdown ZIP, shareable reports"
msgstr "CSV 导出、Markdown ZIP、可分享的报告"

msgid "Cancel"
msgstr "取消"

msgid "Cancel anytime, from your billing page"
msgstr "可随时在账单页面取消"

msgid "Cancel crawl"
msgstr "取消抓取"

msgid "Cancel every active crawl on the server? This cannot be undone."
msgstr "取消服务器上所有正在进行的抓取任务？此操作无法撤销。"

msgid "Cancelled"
msgstr "已取消"

msgid "Cancelling…"
msgstr "正在取消…"

#. Translators: %(reason)s says why, such as "the server was running out
#. of disk space".
#, python-format
msgid ""
"Capture stopped before the end of the crawl because %(reason)s, so this "
"archive covers only the pages listed above. The word count itself is "
"complete."
msgstr "由于 %(reason)s，抓取在结束前已停止，因此此存档仅涵盖上方列出的页面。 字数统计本身已完成。"

msgid "Carries a large site past its estimate to the very last page."
msgstr "让大型网站的抓取超出预估，直至最后一页。"

msgid "Change language"
msgstr "更改语言"

msgid "Change the address this report shows"
msgstr "更改此报告显示的地址"

msgid "Check staging content before launch"
msgstr "上线前检查预发布内容"

#. %(sites)s is a list of site names.
#, python-format
msgid ""
"Checked by page only: %(sites)s. These crawls kept no sentences and saved"
" no Markdown, so their pages count in full unless the same page is in "
"another crawl. A new crawl checks them sentence by sentence."
msgstr ""
"仅按页面检查：%(sites)s。 这些次抓取未保留任何句子，也未保存任何 "
"Markdown，因此除非同一页面也出现在其他抓取中，否则这些页面将按完整页面计数。 新一轮抓取会逐句检查这些内容。"

#. Translators: the name used for text in Chinese or Japanese characters,
#. which the language check can't tell apart.
msgid "Chinese or Japanese characters"
msgstr "中文或日文字符"

msgid "Choose Add custom connector."
msgstr "选择“添加自定义连接器”。"

msgid "Claude (claude.ai and Claude Desktop)"
msgstr "Claude（claude.ai 和 Claude Desktop）"

msgid "Claude (web and desktop)"
msgstr "Claude（网页版和桌面版）"

msgid "Claude Code — paste in a terminal"
msgstr "Claude Code — 粘贴到终端中"

msgid "Claude Code, writing its own crawler"
msgstr "Claude Code，正在编写自己的爬虫"

msgid "Claude alone vs. with Word Counter"
msgstr "Claude 单独使用 vs. 搭配 Word Counter 使用"

msgid "Claude with and without it →"
msgstr "使用和不使用它的 Claude →"

msgid "Client view"
msgstr "客户视图"

msgid "Close"
msgstr "关闭"

msgid ""
"Comma-separated subdomains and folders to leave out. A leading / excludes"
" a folder, anything else a subdomain."
msgstr "要排除的子域名和文件夹，以逗号分隔。 前导 / 表示排除一个文件夹，其他内容则表示子域名。"

msgid ""
"Comma-separated. A leading / excludes a folder, anything else a subdomain"
" — staging also matches web-staging.example.com. Useful with “Whole "
"domain”, which otherwise includes every subdomain, staging mirrors "
"included."
msgstr ""
"以逗号分隔。 前导 / 表示排除一个文件夹，其他任何内容都表示子域名——staging 也会匹配 web-staging.example.com。"
" 适用于“整个域名”，否则会包含所有子域名，包括暂存环境的镜像站点。"

#. a button that opens the pricing page.
msgid "Compare plans"
msgstr "比较套餐"

msgid "Compare the word counts of our live site and our staging site."
msgstr "比较我们线上网站和预发布网站的字数。"

msgid "Comparing sentences…"
msgstr "正在比较句子…"

msgid "Completed"
msgstr "已完成"

msgid "Connect Claude or ChatGPT"
msgstr "连接 Claude 或 ChatGPT"

msgid "Connect Claude, ChatGPT or another assistant"
msgstr "连接 Claude、ChatGPT 或其他助手"

msgid ""
"Connect Word Counter to Claude, ChatGPT, Cursor or any MCP client and ask"
" how many words a website has. It crawls every page and answers with the "
"real total, the repetition and the split by language."
msgstr ""
"将 Word Counter 连接到 Claude、ChatGPT、Cursor 或任何 MCP 客户端，然后询问网站有多少个单词。 "
"它会抓取每个页面，并提供实际总数、重复内容数量以及按语言划分的统计结果。"

msgid ""
"Connect Word Counter to your AI assistant. When you ask about a website, "
"it crawls every page and comes back with the real total — the same count "
"as our reports, not a guess from the homepage."
msgstr ""
"将 Word Counter 连接到您的 AI 助手。 "
"当您查询网站时，它会抓取每个页面，并返回实际总数——与我们的报告统计结果一致，而不是根据首页估算的数字。"

msgid "Connect an assistant"
msgstr "连接助手"

msgid "Connect in three steps"
msgstr "三步完成连接"

msgid "Connect your assistant"
msgstr "连接您的助手"

msgid "Consolidate"
msgstr "合并"

msgid "Consolidate again"
msgstr "再次合并"

#. %(date)s is when the project's totals were last worked out, filled in by the
#. browser.
#, python-format
msgid "Consolidated %(date)s"
msgstr "已合并 %(date)s"

msgid "Consolidating"
msgstr "正在整合"

msgid "Consolidating…"
msgstr "正在整合…"

msgid "Copied"
msgstr "已复制"

msgid "Copy"
msgstr "复制"

msgid "Copy it now: this is the only time it’s shown. It works like a password."
msgstr "现在复制：它只会显示这一次。 它的作用类似密码。"

msgid "Copy link"
msgstr "复制链接"

msgid "Could not reach billing"
msgstr "无法访问账单页面"

msgid ""
"Couldn't find a sign-in form there. Enter the address of the site's sign-"
"in page."
msgstr "未能在该处找到登录表单。 请输入网站登录页面的网址。"

msgid "Couldn't load more pages."
msgstr "无法加载更多页面。"

msgid "Couldn't send — try again."
msgstr "无法发送 — 请重试。"

msgid "Couldn’t delete this crawl. Try again."
msgstr "无法删除此爬取任务。 重试。"

msgid "Count a website"
msgstr "统计网站词数"

#. Translators: shown after the product name in page titles
#. ("Word Counter — Count every word on a website") and on the sign-in page.
msgid "Count every word on a website"
msgstr "统计网站上的所有字词"

msgid "Count my website’s words"
msgstr "统计我的网站字数"

msgid "Count only www.example.com — leave out its subdomains."
msgstr "仅统计 www.example.com — 不包括其子域名。"

msgid "Count the content that belongs in your project"
msgstr "统计属于您项目的内容数量"

msgid "Count the words on example.com and tell me how much of it repeats."
msgstr "统计 example.com 上的字数，并告诉我其中有多少内容是重复的。"

#. %(product)s is the product's name.
#, python-format
msgid "Counted with %(product)s by wxrks"
msgstr "由 wxrks 的 %(product)s 统计得出"

msgid ""
"Counting relies on spaces between words, so totals for Chinese, Japanese "
"and Thai will be much too low."
msgstr "计数依据单词之间的空格，因此中文、日文和泰文的计数结果会低很多。"

msgid ""
"Counts a website: the total, pages, repetition, and the split by "
"language, section and subdomain, with a link to the full report. The "
"whole domain by default, or one host only. Reuses an earlier count of the"
" same site unless asked to count again."
msgstr ""
"统计网站内容：总数、页面数、重复内容，以及按语言、版块和子域名划分的统计，并附上完整报告链接。 默认覆盖整个域名，或仅限一个主机。 "
"除非您要求重新计数，否则会重复使用该网站之前的计数。"

msgid "Counts each page once"
msgstr "每个页面仅计数一次"

#. Translators: %(checked)s and %(total)s are word counts; the sentence
#. says how much of the total the repetition estimate covers.
#, python-format
msgid "Covers %(checked)s of %(total)s word"
msgid_plural "Covers %(checked)s of %(total)s words"
msgstr[0] "涵盖 %(total)s 个词中的 %(checked)s 个"

#. Translators: the button that starts a crawl of the address typed in (a
#. verb).
#. the button that starts counting a website (a verb).
msgctxt "button"
msgid "Crawl"
msgstr "抓取"

#. a table column of crawls (a noun).
msgctxt "noun"
msgid "Crawl"
msgstr "抓取"

msgid "Crawl a site"
msgstr "抓取网站"

msgid ""
"Crawl a website and count every word it contains — total, per page, per "
"folder."
msgstr "抓取网站并统计其中的所有词数——包括总词数、每页词数和每个文件夹的词数。"

msgid "Crawl another site"
msgstr "再抓取一个网站"

msgid ""
"Crawl any website and count every word — per page, per folder, in total. "
"Built for sizing translation projects, with CSV export and a shareable "
"report."
msgstr "抓取任意网站并统计所有字数——按页面、按文件夹及总计。 专为评估翻译项目规模而打造，支持导出 CSV 和分享报告。"

msgid ""
"Crawl any website and export every page as clean Markdown in a single "
"ZIP. Main content only — ready to feed a language model, a RAG pipeline "
"or a CMS migration."
msgstr ""
"抓取任意网站，并将所有页面导出为整洁的 Markdown 文件，打包成一个 ZIP。 仅包含主要内容 — 可直接输入语言模型、RAG 流程或 "
"CMS 迁移工具。"

msgid "Crawl didn’t finish: counted only for what the other sites don’t have"
msgstr "抓取未完成：仅统计其他网站没有的内容"

msgid "Crawl failed"
msgstr "抓取失败"

#. Translators: the heading of the email sent when a crawl ends, and the
#. start of its subject line.
msgid "Crawl finished"
msgstr "抓取已完成"

msgid "Crawl stopped"
msgstr "爬取已停止"

msgid "Crawled"
msgstr "已抓取"

#. %(url)s is the address the crawl started from.
#, python-format
msgid "Crawled from %(url)s — only you see this."
msgstr "抓取自 %(url)s — 只有您能看到此内容。"

msgid "Crawled signed in on the site’s sign-in page"
msgstr "在网站的登录页面抓取了已登录状态的信息"

#. Translators: %(date)s is the date and time of the crawl.
#, python-format
msgid "Crawled: %(date)s"
msgstr "抓取时间：%(date)s"

#. Translators: status badge: the crawl is reading pages right now.
msgid "Crawling"
msgstr "正在抓取"

msgid "Crawls"
msgstr "抓取次数"

msgid "Crawls run at full speed"
msgstr "爬取任务以全速运行"

msgid "Create"
msgstr "创建"

msgid "Cursor — in ~/.cursor/mcp.json:"
msgstr "Cursor — 位于 ~/.cursor/mcp.json："

msgid "Cursor, VS Code and others"
msgstr "Cursor、VS Code 等工具"

msgid ""
"Custom MCP servers depend on your ChatGPT plan and, in a workspace, on "
"what your admin allows."
msgstr "自定义 MCP 服务器取决于您的 ChatGPT 套餐；如果您在工作区中使用，还取决于管理员允许的内容。"

#. Translators: the language row for pages with no language in their address.
msgid "Default"
msgstr "默认值"

msgid "Delete project"
msgstr "删除项目"

msgid "Delete run"
msgstr "删除运行记录"

#. Translators: %(site)s is the address of the site that was crawled.
#, python-format
msgid "Delete this crawl of %(site)s? This can’t be undone."
msgstr "确定要删除对 %(site)s 的这次抓取吗？此操作无法撤销。"

msgid ""
"Delete this project? Its crawls stay, in your runs and in any other "
"project."
msgstr "删除此项目？它的抓取记录会保留在您的运行记录和其他任何项目中。"

msgid "Delete this run and everything saved with it? This cannot be undone."
msgstr "要删除此轮运行及其保存的所有内容吗？此操作无法撤销。"

msgid "Deleting…"
msgstr "正在删除…"

msgid "Detected platform"
msgstr "检测到的平台"

#. Translators: %(cms)s is a platform's name, such as WordPress.
#, python-format
msgid "Detected platform: %(cms)s"
msgstr "检测到的平台：%(cms)s"

msgid "Detected platform: Contentful (headless — sitemap conventions vary)"
msgstr "检测到的平台： Contentful（无头式——站点地图规范各不相同）"

msgid ""
"Didn’t finish: adds only the pages and sentences the crawls above don’t "
"have."
msgstr "未完成：仅添加上述抓取中尚未包含的页面和句子。"

msgid "Didn’t load when the crawler asked for them."
msgstr "爬虫请求这些内容时，它们未能加载。"

msgid ""
"Different pages, but at least half of their words are sentences another "
"crawl has."
msgstr "页面各不相同，但至少一半的文字是另一次抓取中已有的句子。"

msgid "Differs only by numbers"
msgstr "仅数字不同"

msgid "Download Markdown"
msgstr "下载 Markdown"

#. Translators: a button; %(size)s is a file size such as "12 MB".
#, python-format
msgid "Download Markdown · %(size)s"
msgstr "下载 Markdown · %(size)s"

msgid "Download every page, with its new words (CSV)"
msgstr "下载所有页面及其新增词汇（CSV）"

msgid "Download the pages in more than one crawl (CSV)"
msgstr "在多个抓取任务中下载页面（CSV）"

msgid "Download the repeated sentences (CSV)"
msgstr "下载重复句子（CSV）"

msgid "Duplicate of a page already counted"
msgstr "与已计数页面重复"

msgid "Duplicate pages"
msgstr "重复页面"

msgid "Duplicate pages within a crawl"
msgstr "一次抓取中的重复页面"

msgid "Duplicate · listed separately"
msgstr "重复项 · 单独列出"

msgid ""
"Each page is opened in a real browser and counted only once it has "
"finished loading — usually a second or two more per page. Tools that read"
" a page the moment it appears finish sooner, but miss text that loads "
"afterwards; on some sites that’s whole sections."
msgstr ""
"每个页面都会在真实浏览器中打开，并且只有在加载完成后才会计数——通常每页还需要一两秒。 "
"页面一出现就读取的工具完成得更快，但会漏掉之后加载的文本；在某些网站上，甚至会漏掉整个版块。"

msgid ""
"Each page is opened in a real browser and counted only once it has "
"finished loading — usually a second or two more per page. Tools that read"
" a page the moment it appears finish sooner, but miss text that loads "
"afterwards; on some sites that’s whole sections. You don’t have to wait: "
"if you’re signed in, you’ll get an email when the crawl finishes."
msgstr ""
"每个页面都会在真实浏览器中打开，并且只有在加载完成后才会计数——通常每页还需多等一两秒。 "
"页面一出现就读取的工具完成得更快，但会漏掉之后加载的文本；在某些网站上，甚至会漏掉整个版块。 "
"您无需等待：登录后，网站抓取完成时，您会收到一封电子邮件。"

msgid ""
"Each page runs through a content filter that drops navigation and "
"repeated chrome. That's the difference between a corpus you can search "
"and one where every document matches the phrase “Book Now”."
msgstr "每个页面都会经过内容筛选器，移除导航内容和重复的界面元素。 这就是可搜索的语料库与每份文档都包含“Book Now”这一短语的语料库之间的区别。"

msgid ""
"Each site’s own report has its pages, its repetition estimate and what it"
" left out."
msgstr "每个网站的报告都包含该网站的页面、重复内容估算值以及遗漏内容。"

msgid "Easy server load"
msgstr "服务器负载低"

msgid "Email"
msgstr "电子邮件"

msgid "Email or username"
msgstr "电子邮件或用户名"

#. Translators: write the numbers the way your language does
#. (662.000 in German, 662 000 in French). "Tokens" are the units a
#. language model reads.
msgid ""
"English runs near 1.3 tokens per word. A 662,000-word site is about "
"880,000 tokens of clean text — as raw HTML it would be several times "
"that, nearly all of it markup."
msgstr ""
"英语平均每个单词约含 1.3 个词元。 一个包含 662,000 个单词的网站，纯文本约为 880,000 个词元；如果是原始 "
"HTML，体积会达到数倍，其中几乎全是标记。"

msgid "Enter a web address, such as https://www.example.com."
msgstr "请输入网址，例如 https://www.example.com。"

msgid "Enter an email address to send the report to."
msgstr "输入电子邮件地址以发送报告。"

msgid "Enter both the email (or username) and the password."
msgstr "请输入电子邮件（或用户名）和密码。"

msgid "Enter the sign-in page as a web address, like https://example.com/login."
msgstr "请输入登录页面的网址，例如 https://example.com/login。"

msgid "Enter your website URL"
msgstr "输入您的网站网址"

msgid "Estimate confidence"
msgstr "估算置信度"

msgid "Estimate — before you crawl"
msgstr "估算 — 抓取前"

#. %(sites)s is a list of site names.
#, python-format
msgid ""
"Estimated from saved Markdown: %(sites)s. These crawls are from before "
"crawls kept their sentences, so their sentences come from the Markdown "
"they saved — main content only — and each page’s words are split in the "
"same proportions. A new crawl gives exact figures."
msgstr ""
"根据已保存的 Markdown 估算：%(sites)s。 这些次抓取发生在抓取结果开始保留句子之前，因此其中的句子来自保存的 "
"Markdown——仅包含主要内容——且每个页面的词数按相同比例拆分。 新一轮网站抓取可提供精确数据。"

msgid "Estimated total"
msgstr "预计总计"

msgid "Estimated total pages"
msgstr "预计总页数"

msgid "Estimated total time"
msgstr "预计总耗时"

msgid ""
"Every file opens with the URL it came from, so nothing loses its source "
"on the way into a retrieval pipeline."
msgstr "每个文件开头都会标明其来源网址，确保文件进入检索流程后仍能追溯来源。"

#. %(n)s is a number of pages fetched, in a card comparing two ways of
#. counting.
#, python-format
msgid "Every language crawled: %(n)s page."
msgid_plural "Every language crawled: %(n)s pages."
msgstr[0] "已抓取的每种语言： %(n)s 个页面。"

msgid ""
"Every page is rendered in a real browser, so content built by JavaScript "
"is counted. Tools that only fetch HTML report a fraction of the truth."
msgstr "每个页面都会在真实浏览器中渲染，因此通过 JavaScript 生成的内容也会计入统计。 仅抓取 HTML 的工具只能呈现部分真实情况。"

msgid "Everything else"
msgstr "其他所有内容"

msgid "Everything in Free"
msgstr "免费版包含所有功能"

msgid "Example"
msgstr "示例"

msgid "Exclude subdomains or folders"
msgstr "排除子域名或文件夹"

msgid "Exclude subdomains or folders before continuing"
msgstr "继续前排除子域名或文件夹"

#. placeholder of a field of subdomains and folders to leave out; the examples
#. may be adapted.
msgid "Exclude: staging, /careers"
msgstr "排除：staging、/careers"

#. Translators: a pill; %(entries)s is a list such as "staging (subdomain),
#. /careers (folder)".
#, python-format
msgid "Excluded: %(entries)s"
msgstr "已排除：%(entries)s"

msgid "Excluded: none"
msgstr "已排除：无"

msgid "Export"
msgstr "导出"

msgid "Export CSV"
msgstr "导出 CSV"

msgid "Failed"
msgstr "失败"

msgid "Failed to fetch page"
msgstr "获取页面失败"

msgid "Failed to load"
msgstr "加载失败"

#. Translators: %(reason)s is the technical reason a page failed, often in
#. English.
#, python-format
msgid "Failed: %(reason)s"
msgstr "失败：%(reason)s"

msgid "Find out how much work is on your website."
msgstr "了解您的网站有多少工作量。"

msgid ""
"Find your longest pages and most content-heavy folders. Export a CSV with"
" each page’s URL, title and word count to help build your scope."
msgstr "找出篇幅最长的页面和内容最多的文件夹。 导出包含每个页面的网址、标题和字数的 CSV 文件，帮助您制定项目范围。"

msgid "Folder"
msgstr "文件夹"

msgid "Folders"
msgstr "文件夹"

msgid ""
"Follows a count that’s still running, and returns the result when it’s "
"done."
msgstr "跟踪仍在进行的计数，并在完成后返回结果。"

msgid "Footer · not counted"
msgstr "页脚 · 不计入统计"

msgid "For Claude and ChatGPT"
msgstr "适用于 Claude 和 ChatGPT"

msgid ""
"For a site that asks for a username and password in a browser pop-up, "
"like most staging sites. Sent only to that site, used only for this "
"crawl, never stored."
msgstr "适用于大多数预发布网站等会在浏览器弹出窗口中要求输入用户名和密码的网站。 仅发送至该网站，仅用于本次抓取，绝不存储。"

msgid ""
"For a site where you sign in with an email and password. The crawler "
"signs in before it starts and crawls as that account, so use one that can"
" only read; it never opens a log-out, delete or cancel link. Sent only to"
" that site, used only for this crawl, never stored."
msgstr ""
"适用于使用电子邮件和密码登录的网站。 爬虫会先登录，然后以该账户身份抓取网站，因此请使用仅有读取权限的账户；它绝不会打开退出登录、删除或取消链接。"
" 仅发送至该网站，仅用于本次抓取，绝不存储。"

msgid "For developers"
msgstr "面向开发者"

msgid ""
"For staging sites protected by a browser username-and-password pop-up, "
"enter the credentials to run the crawl. They’re sent only to that site, "
"used only for that crawl and never stored."
msgstr "对于受浏览器用户名和密码弹窗保护的预发布网站，请输入凭据以运行抓取。 它们仅发送至该网站，仅用于该次抓取，且绝不会被存储。"

msgid "For your client"
msgstr "供您的客户使用"

#, python-format
msgid ""
"Found a sitemap — this site has approximately %(n)s page. Crawling all of"
" them may take a while."
msgid_plural ""
"Found a sitemap — this site has approximately %(n)s pages. Crawling all "
"of them may take a while."
msgstr[0] "已找到站点地图 — 此网站约有 %(n)s 个页面。 抓取所有网站可能需要一些时间。"

msgid "Found while crawling, but not in the total."
msgstr "爬取时发现，但未计入总数。"

msgid "Frameworks and hand-written code"
msgstr "框架和手写代码"

msgid "Free"
msgstr "免费"

#. %(n)s is a number of words (the size at which a guest crawl pauses).
#, python-format
msgid ""
"Free to use. No sign-up to start. Sites over %(n)s word require Google "
"sign-in to finish."
msgid_plural ""
"Free to use. No sign-up to start. Sites over %(n)s words require Google "
"sign-in to finish."
msgstr[0] "免费使用。 无需注册即可开始。 超过 %(n)s 个词的网站需要登录 Google 才能完成。"

msgid ""
"Free with a Word Counter account. Works with Claude Code, Claude, "
"ChatGPT, Cursor, VS Code and any app that speaks MCP."
msgstr ""
"拥有 Word Counter 账户即可免费使用。 兼容 Claude Code、Claude、ChatGPT、Cursor、VS Code "
"以及任何支持 MCP 的应用。"

#. %(n)s is a number of words (the size at which a guest crawl pauses).
#, python-format
msgid ""
"Free. No sign-up for sites under %(n)s word. Sign in with Google to "
"finish larger sites."
msgid_plural ""
"Free. No sign-up for sites under %(n)s words. Sign in with Google to "
"finish larger sites."
msgstr[0] "免费。 少于 %(n)s 个词的网站无需注册。 使用 Google 登录以完成较大的网站抓取。"

msgid "Full report, every page →"
msgstr "完整报告，所有页面 →"

msgid "Get the Markdown"
msgstr "获取 Markdown"

msgid "Get the text without the copy-paste"
msgstr "无需复制粘贴即可获取文本"

msgid "Get your connection URL"
msgstr "获取您的连接 URL"

msgid "Give the project a name."
msgstr "为项目命名。"

msgid "Going through the crawls for the first time…"
msgstr "正在首次检查这些网站抓取结果…"

msgid "Good to know"
msgstr "须知"

msgid ""
"Google didn’t send your profile. Try again, and allow access to your name"
" and email."
msgstr "Google 未发送您的个人资料。 请重试，并允许访问您的姓名和电子邮件。"

msgid "Google sign-in didn’t finish. Try again."
msgstr "Google 登录未完成。 重试。"

msgid ""
"Ground a support assistant in your own answers, audit content at a scale "
"nobody can read, brief translators with real terminology, or move "
"platforms without losing the writing."
msgstr "基于您自己的答案构建支持助手，大规模审核无人能读完的内容，用真实术语为译员提供简报，或迁移平台而不丢失文案。"

msgid ""
"Groups this crawl with others of the same client: combined totals, each "
"page counted once, and the overlap between crawls. Optional — a run can "
"join a project later, from its report."
msgstr ""
"将此次抓取与同一客户的其他抓取归为一组：汇总总数，每个页面仅计一次，并显示各次抓取之间的重叠部分。 可选 — "
"您可以稍后从报告中将一次爬取添加到项目中。"

msgid ""
"Hand it to a translator, prepare a CMS migration or use it with an AI "
"tool or search index."
msgstr "将其交给译员、用于准备 CMS 迁移，或与 AI 工具或搜索索引搭配使用。"

msgid "Header and menu · not counted"
msgstr "页眉和菜单 · 不计入统计"

#. Translators: how sure the word-count estimate is, shown in the email as
#. "Estimate confidence: High".
msgid "High"
msgstr "高"

msgid "High confidence"
msgstr "高置信度"

msgid "Host"
msgstr "主机"

msgid "How long does a count take?"
msgstr "统计需要多长时间？"

msgid "How many words are in the German part of example.com?"
msgstr "example.com 的德语部分有多少个单词？"

msgid "How many words does wxrks.com have?"
msgstr "wxrks.com 有多少个单词？"

msgid "How the added-up words split"
msgstr "汇总后的词数如何拆分"

msgid "How the crawls come down to the new words"
msgstr "爬取结果如何归结为新增词数"

msgid "I counted every page with Word Counter:"
msgstr "我使用 Word Counter 统计了每个页面："

msgid ""
"If it opens in a browser, Word Counter can count it — whatever it was "
"built with: a CMS, a site builder, a framework, hand-written code or an "
"AI tool. It also recognises WordPress, Webflow, Drupal, Shopify, "
"Squarespace, Wix, Ghost and Contentful, and names the platform in the "
"report."
msgstr ""
"只要能在浏览器中打开，Word Counter 就能统计其中的词数——无论网站是用 CMS、建站工具、框架、手写代码还是 AI 工具构建的。 "
"它还可以识别 WordPress、Webflow、Drupal、Shopify、Squarespace、Wix、Ghost 和 "
"Contentful，并在报告中注明平台名称。"

#, python-format
msgid ""
"If your vendor prices by translation memory, the %(new)s new word is the "
"number that matters."
msgid_plural ""
"If your vendor prices by translation memory, the %(new)s new words are "
"the number that matters."
msgstr[0] "如果您的供应商按翻译记忆收费，那么这 %(new)s 个新词才是关键。"

msgid "In a chat, add Word Counter from the + menu and ask your question."
msgstr "在聊天中，从 + 菜单添加 Word Counter，然后提出您的问题。"

msgid "In a terminal, add the server with your key in a header:"
msgstr "在终端中，在标头中添加服务器和您的密钥："

msgid ""
"Include the whole domain, a single subdomain or just the main site. Leave"
" out folders and subdomains you don’t need, such as /careers, old "
"archives or a staging copy."
msgstr "包含整个域名、单个子域名或仅主站。 排除您不需要的文件夹和子域名，例如 /careers、旧档案或暂存副本。"

msgid "Includes content loaded by JavaScript"
msgstr "包括由 JavaScript 加载的内容"

msgid ""
"Includes waiting for each page to finish loading, so text that loads late"
" isn’t missed."
msgstr "包括等待每个页面加载完成，以免遗漏延迟加载的文本。"

#, python-format
msgid "Interactive report: %(url)s"
msgstr "交互式报告：%(url)s"

msgid ""
"Into Your runs, like any count you start here — each with its report, "
"every page and a CSV."
msgstr "在“您的运行记录”中查看您在此处启动的所有统计任务，每项任务都包含报告、所有页面和 CSV 文件。"

msgid "Invited"
msgstr "已邀请"

#. Translators: under an invited person's address; %(date)s is when.
#, python-format
msgid "Invited %(date)s"
msgstr "已于 %(date)s 邀请您"

msgid "Is my URL safe to share?"
msgstr "分享我的 URL 安全吗？"

msgid "Is our help center bigger than our blog?"
msgstr "我们的帮助中心比博客内容更多吗？"

msgid ""
"It also assumes this app is what's slowing you down. A site that rate-"
"limits or blocks a heavier crawler caps every plan at the same place; the"
" report marks those pages, so you can see when that's what happened."
msgstr ""
"它还假设拖慢您速度的是这个应用。 "
"如果某个网站对负载较高的爬虫进行速率限制或拦截，就会让所有套餐都受限于同一水平；报告会标记这些页面，方便您了解是否发生了这种情况。"

msgid "It counts what a translator is handed"
msgstr "它会统计译者收到的内容。"

msgid "It counts what you would translate"
msgstr "它统计您需要翻译的内容"

msgid ""
"It follows links the way a visitor does, so it finds the help centers, "
"docs and subdomains a sitemap leaves out."
msgstr "它会像访客一样沿着链接浏览，因此能找到网站地图遗漏的帮助中心、文档和子域名。"

msgid "It knows what repeats"
msgstr "它知道哪些内容会重复"

msgid "It reads every page"
msgstr "它会读取每个页面"

msgid "It sees pages the way a reader does"
msgstr "它以读者的视角查看网页"

msgid "Keep the scope under control"
msgstr "控制好范围"

msgid "Keep translated copies out of the total"
msgstr "总数中不计入已翻译的副本"

msgid "Key — for apps that send it as a header"
msgstr "密钥 — 适用于将其作为标头发送的应用程序"

msgid "Know how much content you’re dealing with."
msgstr "了解您需要处理多少内容。"

msgid "Language"
msgstr "语言"

#. a field for language codes such as en or pt; "auto" means detected
#. automatically.
msgid "Language (auto)"
msgstr "语言（自动）"

#. Translators: a small pill; %(lang)s is a language's name, shown in bold.
#, python-format
msgid "Language: %(lang)s"
msgstr "语言：%(lang)s"

#. Translators: a small pill; %(lang)s is the language the crawler detected, in
#. bold.
#, python-format
msgid "Language: %(lang)s (auto)"
msgstr "语言：%(lang)s（自动）"

msgid "Languages"
msgstr "语言"

#. Translators: a small pill; %(primary)s is the first language (bold),
#. %(rest)s a list of the others.
#, python-format
msgid "Languages: %(primary)s + %(rest)s"
msgstr "语言：%(primary)s + %(rest)s"

#. Translators: a small pill on the report; keep it short.
msgid "Languages: All"
msgstr "语言： 全部"

msgid ""
"Leave the advanced settings empty and add it. In a chat, make sure Word "
"Counter is switched on in the tools menu. On the Free plan Claude allows "
"one custom connector."
msgstr "高级设置留空，然后添加它。 在聊天中，请确保已在工具菜单中启用 Word Counter。 在免费套餐中，Claude 允许使用一个自定义连接器。"

msgid "Left out"
msgstr "已遗漏"

msgid "Linked but not crawled"
msgstr "已关联但尚未抓取"

msgid ""
"Linked from the pages crawled but not counted — outside this run’s "
"settings, excluded, or not reached before it stopped."
msgstr "由已抓取的页面链接到，但未计入统计 — 超出本次运行的设置范围、已排除，或在抓取停止前未能访问。"

msgid "Linked subdomains not crawled"
msgstr "未抓取关联的子域名"

msgid "List the 20 longest pages under example.com/blog."
msgstr "列出 example.com/blog 下最长的 20 个页面。"

msgid "Loading…"
msgstr "正在加载…"

msgid "Log out"
msgstr "退出登录"

msgid "Low"
msgstr "低"

msgid "Low confidence"
msgstr "置信度低"

msgid "MCP server"
msgstr "MCP 服务器"

msgid "Main content, not the whole page"
msgstr "主要内容，而非整个页面"

msgid ""
"Main page content only — site navigation, footers and other repeated "
"chrome are stripped. Each file starts with the URL it came from."
msgstr "仅限主页内容——网站导航、页脚及其他重复的界面元素均已移除。 每个文件都以其来源网址开头。"

msgid "Main site"
msgstr "主站"

msgid "Make a connection"
msgstr "建立连接"

msgid ""
"Make a connection for each app you use. Each one has its own URL and key,"
" and you can revoke it without touching the others."
msgstr "为您使用的每个应用建立连接。 每个密钥都有自己的 URL，您可以单独撤销，不影响其他密钥。"

msgid "Manage billing"
msgstr "管理账单信息"

msgid "Manage subscription"
msgstr "管理订阅"

msgid ""
"Many sites keep adding content after a page appears. Each page is counted"
" only once it has finished loading, so lists, tabs and sections that load"
" late are included. It takes a little longer, and the count is more "
"complete."
msgstr ""
"许多网站会在页面显示后继续添加内容。 每个页面只有在加载完成后才会计数，因此延迟加载的列表、标签页和版块也会包含在内。 "
"这需要多花一点时间，但统计结果会更完整。"

msgid "Markdown saved"
msgstr "Markdown 已保存"

#, python-format
msgid ""
"Markdown was saved for the first %(n)s page, then stopped because of an "
"error while saving. The word count below is complete either way."
msgid_plural ""
"Markdown was saved for the first %(n)s pages, then stopped because of an "
"error while saving. The word count below is complete either way."
msgstr[0] "前 %(n)s 个页面的 Markdown 已保存，随后因保存时出错而停止。 无论选择哪种方式，以下字数统计均完整。"

#, python-format
msgid ""
"Markdown was saved for the first %(n)s page, then stopped because the "
"per-crawl size limit was reached. The word count below is complete either"
" way."
msgid_plural ""
"Markdown was saved for the first %(n)s pages, then stopped because the "
"per-crawl size limit was reached. The word count below is complete either"
" way."
msgstr[0] "已保存前 %(n)s 个页面的 Markdown，随后因达到单次抓取大小限制而停止。 无论选择哪种方式，以下字数统计均完整。"

#, python-format
msgid ""
"Markdown was saved for the first %(n)s page, then stopped because the "
"server was running low on disk space. The word count below is complete "
"either way."
msgid_plural ""
"Markdown was saved for the first %(n)s pages, then stopped because the "
"server was running low on disk space. The word count below is complete "
"either way."
msgstr[0] "前 %(n)s 个页面的 Markdown 已保存，随后因服务器磁盘空间不足而停止。 无论选择哪种方式，以下字数统计均完整。"

#, python-format
msgid ""
"Markdown was saved for the first %(n)s page, then stopped because the "
"server's total Markdown limit was reached. The word count below is "
"complete either way."
msgid_plural ""
"Markdown was saved for the first %(n)s pages, then stopped because the "
"server's total Markdown limit was reached. The word count below is "
"complete either way."
msgstr[0] "已保存前 %(n)s 个页面的 Markdown，随后因达到服务器 Markdown 总量限制而停止。 无论选择哪种方式，以下字数统计均完整。"

msgid "Matching pages…"
msgstr "正在匹配页面…"

msgid "Measured only when asked."
msgstr "仅在您提出要求时测量。"

msgid "Medium"
msgstr "中等"

msgid "Medium confidence"
msgstr "中等置信度"

msgid "Member logins aren’t supported."
msgstr "不支持会员登录。"

msgid "Member-only content stays out."
msgstr "仅限会员的内容不会被纳入。"

#. %(n)s is a percentage.
#, python-format
msgid ""
"Menu and footer counted on every page: %(n)s%% more than the text people "
"read"
msgstr "每个页面的菜单和页脚都会计入：比人们阅读的文本多 %(n)s%%"

msgid "Menus, footers and forms, which repeat on every page."
msgstr "在每个页面上重复出现的菜单、页脚和表单。"

msgid "Moderate server load"
msgstr "中等服务器负载"

msgid "More"
msgstr "更多"

msgid "More actions"
msgstr "更多操作"

msgid ""
"More pages fetched at once, and it starts ahead of the queue. Everything "
"else about the crawl is identical."
msgstr "一次抓取更多页面，并提前开始处理队列。 爬取的其他所有方面都相同。"

msgid "Most repeated text"
msgstr "重复次数最多的文本"

msgid "Name it Word Counter and paste your personal URL:"
msgstr "将其命名为 Word Counter，然后粘贴您的个人网址："

#. Translators: write the numbers the way your language does.
msgid ""
"Navigation, footers, sidebars and forms are stripped before counting, so "
"a 500-page site doesn't inflate by the same menu repeated 500 times."
msgstr "计数前会移除导航栏、页脚、侧边栏和表单，因此不会因为同一个菜单重复出现 500 次，就让一个 500 页的网站虚增字数。"

msgid ""
"Need the content as well as the count? Select Save Markdown to download "
"each page’s main text as a separate file, with its source URL included, "
"all in one ZIP."
msgstr ""
"您需要内容和字数统计吗？选择“保存 Markdown”，即可将每个页面的正文分别下载为单独文件，并在文件中包含其源 URL，所有文件打包在一个 "
"ZIP 中。"

msgid "New"
msgstr "新建"

msgid "New crawl"
msgstr "新建抓取任务"

msgid "New project name"
msgstr "新项目名称"

msgid "New project, e.g. the client’s name"
msgstr "新建项目，例如客户名称"

msgid "New project…"
msgstr "新建项目…"

msgid "New words"
msgstr "新词数"

msgid "New words and repeated words"
msgstr "新词和重复词"

msgid "Newest first"
msgstr "最新的排在前面"

msgid ""
"No crawler on your laptop and no AI usage spent fetching pages. Close the"
" tab: if you’re signed in, you’ll get an email when it’s done."
msgstr "无需在您的笔记本电脑上运行爬虫，也不会消耗 AI 用量来抓取网页。 关闭此标签页：如果您已登录，完成后会收到一封电子邮件。"

msgid "No crawls in this project yet"
msgstr "此项目中尚无爬取记录"

#. keep the <a href="%(href)s"> and </a> tags around the words that link to a
#. new crawl.
#, python-format
msgid "No crawls yet — <a href=\"%(href)s\">start one</a>."
msgstr "尚未运行过抓取任务 — <a href=\"%(href)s\">开始一次</a>。"

msgid "No crawls yet — add some from the project."
msgstr "尚无抓取记录 — 请从项目中添加一些。"

msgid "No crawls yet — try one above."
msgstr "尚无抓取记录 — 请先在上方试用一次。"

msgid "No finished crawls in this project yet."
msgstr "此项目中尚无已完成的抓取任务。"

msgid "No further detail was recorded."
msgstr "未记录更多详细信息。"

msgid "No other subdomains were linked from the pages crawled."
msgstr "从已抓取的页面中未发现链接到其他子域名的内容。"

msgid "No page or sentence is in more than one crawl."
msgstr "每次抓取中，每个页面或句子都只会出现一次。"

msgid "No pages counted yet."
msgstr "尚未统计任何页面。"

msgid "No project"
msgstr "没有项目"

msgid ""
"No projects yet. Make one above, then add crawls to it — from the project"
" page, or from any report’s ⋯ menu."
msgstr "尚无项目。 先在上方创建一个项目，然后从项目页面或任意报告的 ⋯ 菜单中向其中添加抓取任务。"

msgid "No sentence is in more than one crawl."
msgstr "每次抓取中，每个句子只出现一次。"

#, python-format
msgid ""
"No sitemap found — this estimate is based only on pages discovered so far"
" (approximately %(n)s), so it may be less accurate. Crawling all of them "
"may take a while."
msgid_plural ""
"No sitemap found — this estimate is based only on pages discovered so far"
" (approximately %(n)s), so it may be less accurate. Crawling all of them "
"may take a while."
msgstr[0] "未找到站点地图 — 此估算仅基于目前发现的页面（约 %(n)s 个），因此准确性可能较低。 抓取所有网站可能需要一些时间。"

msgid "No sitemap needed"
msgstr "无需站点地图"

msgid ""
"No — treat it like a password: anyone with it can count as you. You can "
"revoke it at any time and make a new one."
msgstr "不——请像对待密码一样保管它：任何拥有它的人都能冒充您进行计数。 您可以随时撤销它并创建一个新的。"

msgid "Nobody knows how many words are on their website."
msgstr "没人知道自己的网站上有多少个词。"

msgid "None found. It trusted the sitemap."
msgstr "未找到。 它信任站点地图。"

msgid "None yet."
msgstr "暂无内容。"

msgid "Not checked"
msgstr "未检查"

msgid "Not counted"
msgstr "未计数"

msgid "Not found"
msgstr "未找到"

msgid "Not in the total"
msgstr "不计入总数"

msgid "Not in this count"
msgstr "不计入此字数统计"

msgid ""
"Not the marketing lead, not the person who built it, and not the agency "
"about to quote you for translating it. Point this at a URL and find out —"
" page by page, folder by folder."
msgstr "不是营销负责人，不是构建网站的人，也不是即将为您提供翻译报价的代理机构。 将其指向一个 URL，即可逐页、逐文件夹查看结果。"

msgid ""
"Nothing could be counted because the starting page itself couldn't be "
"accessed. If you know another page on this site that might be more "
"accessible (e.g. a blog post or inner page rather than the homepage), try"
" starting the crawl from that URL instead."
msgstr "无法访问起始页面，因此无法统计任何内容。 如果您知道此网站上有其他可能更易于访问的页面（例如博客文章或内页，而不是首页），请尝试改用该网址开始抓取。"

msgid "Nothing extra: the same as counting on the website. Pro counts run faster."
msgstr "没有额外内容：与在网站上计数相同。 Pro 统计速度更快。"

msgid "Nothing left out"
msgstr "没有遗漏任何内容"

msgid "Older →"
msgstr "更早 →"

msgid ""
"On its own, an assistant estimates from the pages it opens — or, in "
"Claude Code, writes a one-off crawler that counts the menu on every page."
" Word Counter follows every link and the sitemap until there is nothing "
"left to read."
msgstr ""
"单靠助手，它只能根据打开的页面进行估算；而在 Claude Code 中，它会编写一次性爬虫，统计每个页面上的菜单。 Word Counter "
"会沿着每个链接和站点地图抓取网站，直到没有剩余内容可读取。"

msgid ""
"One client, every crawl that belongs to it, and the number that counts "
"each page once."
msgstr "一个客户、属于该客户的每次抓取，以及每个页面仅计数一次的数字。"

msgid "One file per page, provenance intact"
msgstr "每页一个文件，来源信息完整保留"

msgid "One subdomain"
msgstr "一个子域名"

msgid ""
"Only crawl this language’s pages, for sites with a /en/, /fr/, ... path "
"per language. Leave blank to auto-detect the starting page’s language."
msgstr "仅抓取此语言的页面，适用于每种语言的路径为 /en/、/fr/ 等的网站。 留空即可自动检测起始页面的语言。"

msgid ""
"Only crawl this language’s pages, for sites with a /en/, /fr/, ... path "
"per language. Leave blank to auto-detect the starting page’s language. "
"Comma-separate multiple codes to keep more than one (e.g. en, pt, es)."
msgstr ""
"仅抓取此语言的页面，适用于每种语言的路径为 /en/、/fr/ 等的网站。 留空即可自动检测起始页面的语言。 "
"多个代码请用逗号分隔，以保留多个代码（例如 en、pt、es）。"

msgid ""
"Open Plugins and choose + → Add custom MCP server. (Some accounts have it"
" under Settings → Apps & Connectors → Advanced → Developer mode → "
"Create.)"
msgstr ""
"打开“插件”，然后选择“+” → “添加自定义 MCP 服务器”。 "
"（部分账户可在“设置”→“应用和连接器”→“高级”→“开发者模式”→“创建”中找到。）"

msgid "Open Settings → Connectors (on some versions, Customize → Connectors)."
msgstr "打开“设置”→“连接器”（某些版本中为“自定义”→“连接器”）。"

#. Translators: a link that opens the crawled page in a new tab.
msgid "Open ↗"
msgstr "打开 ↗"

msgid "Opening checkout…"
msgstr "正在打开结账页面…"

#. above the report's address, for mail apps that hide the button.
msgid "Or paste this into your browser:"
msgstr "或将此内容粘贴到浏览器中："

msgid "Overview"
msgstr "概览"

msgid "Owner"
msgstr "所有者"

msgid "PDFs, Word and Excel files, images and videos aren’t counted."
msgstr "PDF、Word 和 Excel 文件、图片及视频不计入统计。"

msgid "Page"
msgstr "页面"

#, python-format
msgid "Page %(page)s of %(total)s"
msgstr "第 %(page)s 页，共 %(total)s 页"

msgid ""
"Page counts only tell you so much. Some pages have a paragraph. Others "
"have thousands of words. Opening them one by one takes time you could "
"spend doing the work."
msgstr "页面数量只能说明部分情况。 有些页面包含一个段落。 其他网站有数千个单词。 逐个打开它们会耗费时间，而这些时间本可以用来完成工作。"

msgid "Pages"
msgstr "页面"

msgid "Pages appear below as they’re read."
msgstr "页面会在读取时显示在下方。"

msgid ""
"Pages behind a login or blocked by the site are listed separately, so you"
" can see what the total leaves out."
msgstr "需要登录或被网站屏蔽的页面会单独列出，方便您了解总数未包含哪些页面。"

msgid "Pages behind a sign-in"
msgstr "登录后才能访问的页面"

msgid "Pages counted"
msgstr "已统计的页面数"

msgid "Pages fetched so far"
msgstr "已抓取的页面数"

msgid "Pages in more than one crawl"
msgstr "多个抓取任务中的页面"

#. Translators: %(saved)s is how many pages are in the download and
#. %(total)s how many the crawl counted.
#, python-format
msgid "Pages in this archive: %(saved)s of %(total)s crawled"
msgid_plural "Pages in this archive: %(saved)s of %(total)s crawled"
msgstr[0] "此存档中的页面：已抓取 %(saved)s/%(total)s 个"

msgid "Pages mostly repeated from another crawl"
msgstr "大部分页面与另一次抓取重复"

msgid "Pages need a link to be found."
msgstr "页面需要包含链接才能被找到。"

msgid ""
"Pages open in Chrome, so text that appears after JavaScript runs can be "
"counted too."
msgstr "页面会在 Chrome 中打开，因此 JavaScript 运行后显示的文本也可以计入。"

msgid "Pages requiring a member login are listed but can’t be read."
msgstr "需要会员登录的页面会列出，但无法读取。"

msgid "Pages so far"
msgstr "目前已处理的页面数"

msgid "Pages with no links pointing to them may be missed."
msgstr "没有链接指向的页面可能会被遗漏。"

msgid ""
"Part of this is estimated: some sites were crawled before their sentences"
" were kept, so their repetition is worked out from their main content."
msgstr "其中一部分是估算值：有些网站在保留句子之前就已完成抓取，因此其重复内容是根据主要内容计算得出的。"

msgid "Password"
msgstr "密码"

msgid "Password-protected"
msgstr "受密码保护的"

msgid "Password-protected site"
msgstr "受密码保护的网站"

msgid "Paused"
msgstr "已暂停"

#. a crawl stops here to show its estimate. %(n)s is a number of words.
#, python-format
msgid "Paused at %(n)s word"
msgid_plural "Paused at %(n)s words"
msgstr[0] "已在 %(n)s 个词处暂停"

msgid "People with access"
msgstr "有权访问的人员"

msgid "Personal URL — for Claude, ChatGPT and apps that only take a URL"
msgstr "个人 URL — 适用于 Claude、ChatGPT 和仅接受 URL 的应用程序"

msgid "Pick your app below and paste it in. It takes a minute."
msgstr "在下方选择您的应用并粘贴进去。 只需一分钟。"

msgid "Plans for teams of every size, billed monthly or yearly."
msgstr "适合各种规模团队的套餐，按月或按年计费。"

msgid "Please enter a valid http(s) URL"
msgstr "请输入有效的 http(s) URL"

msgid ""
"Point this at a URL and get every page back as Markdown, in one ZIP — "
"main content only, no navigation, no cookie banners, no markup burning "
"tokens without carrying meaning."
msgstr ""
"输入网址，即可将所有页面的主要内容导出为 Markdown，并打包成一个 ZIP 文件——不含导航栏、Cookie "
"横幅或占用令牌却没有实际意义的标记。"

msgid "Preparing…"
msgstr "正在准备…"

msgid ""
"Press Enter or comma to add one. A leading / excludes a folder, anything "
"else a subdomain — each entry is labelled with how it will be treated. "
"Applies to the rest of this crawl; pages already counted stay counted."
msgstr ""
"按 Enter 或逗号添加一项。 以 / 开头表示排除文件夹，其他内容则表示子域名——每个条目都标注了其处理方式。 "
"适用于本次抓取的其余页面；已计数的页面仍保留计数。"

msgid "Preview"
msgstr "预览"

msgid "Pricing"
msgstr "定价"

#. a field for language codes such as en or pt; "auto" means detected
#. automatically.
msgid "Primary language (auto)"
msgstr "主要语言（自动）"

msgid "Print"
msgstr "打印"

msgid "Print report"
msgstr "打印报告"

msgid "Pro"
msgstr "Pro"

msgid "Proceed with crawl"
msgstr "继续抓取网站"

msgid "Project"
msgstr "项目"

msgid "Project name"
msgstr "项目名称"

msgid "Projects"
msgstr "项目"

msgid "Public link"
msgstr "公开链接"

msgid "Questions people ask"
msgstr "常见问题"

msgid "Queued"
msgstr "已加入队列"

msgid "Quote with a word count behind you"
msgstr "报价时，字数统计就在您手边"

msgid ""
"Quoting a translation, planning a website rewrite or moving to a new CMS?"
" Get a word count for your site, broken down by page and folder, so you "
"can scope the work before you commit."
msgstr "正在为翻译项目报价、规划网站改版，还是准备迁移到新的 CMS？获取网站的字数统计，并按页面和文件夹细分，以便在确定合作前评估工作量。"

msgid "Re-crawl"
msgstr "重新抓取"

#. menu items that open a form or a dialog, hence the ellipsis.
msgid "Re-crawl…"
msgstr "重新抓取…"

msgid "Re-run to check every word"
msgstr "重新运行以检查每个词语"

msgid "Read how Claude does with and without it →"
msgstr "了解 Claude 使用和不使用它时的表现 →"

msgid ""
"Read in this order, each crawl adds what the ones above it don’t have: "
"completed crawls first, newest first; a crawl that didn’t finish only "
"fills the gaps. Of a site crawled twice, the latest completed crawl "
"counts."
msgstr ""
"请按以下顺序阅读，每次抓取都会补充上方抓取中没有的内容：先显示已完成的抓取，按时间从新到旧排列；未完成的抓取仅填补缺失内容。 "
"对于已抓取两次的网站，以最近一次完成的抓取为准。"

msgid "Reading sentences…"
msgstr "正在读取句子…"

msgid "Reading the crawls…"
msgstr "正在读取抓取结果…"

msgid "Ready for whatever comes next"
msgstr "为接下来的任何挑战做好准备"

msgid "Remove"
msgstr "移除"

#. Translators: the × beside an invited person; %(email)s is their address.
#, python-format
msgid "Remove %(email)s"
msgstr "移除 %(email)s"

#. Translators: the × on an exclusion chip; %(entry)s is what was typed, such
#. as /careers.
#, python-format
msgid "Remove %(entry)s"
msgstr "移除 %(entry)s"

msgid "Removing…"
msgstr "正在移除…"

msgid "Rename project"
msgstr "重命名项目"

msgid "Repeated"
msgstr "重复"

msgid "Repeated from other crawls"
msgstr "在其他抓取任务中重复出现的内容"

msgid "Repeated within"
msgstr "重复间隔为"

msgid "Repeated words"
msgstr "重复词语"

msgid "Repeated · est."
msgstr "重复 · 预计。"

msgid "Repetition"
msgstr "重复项"

msgid "Repetition estimate"
msgstr "重复率估算"

msgid "Replaced by the newer crawl of this site — not counted."
msgstr "已由此网站较新的抓取结果替代 — 不计入统计。"

msgid "Report sections"
msgstr "报告部分"

#. Translators: why a page wasn't counted, in the report's list of pages
#. that failed and in its tooltips.
msgid "Requires login"
msgstr "需要登录才能使用"

msgid "Resuming…"
msgstr "正在继续…"

msgid ""
"Review the scope, exclude anything you don’t need and sign in with Google"
" to finish for free."
msgstr "查看范围，排除不需要的内容，然后使用 Google 登录即可免费完成。"

msgid "Revoke"
msgstr "撤销授权"

msgid ""
"Revoke this connection? Any app using it stops counting until you give it"
" a new one."
msgstr "要撤销此连接吗？任何使用它的应用都会停止计数，直到您为其提供新的一个。"

msgid "Runs not in a project"
msgstr "不属于任何项目的运行记录"

msgid "Runs on our servers, not your computer"
msgstr "在我们的服务器上运行，而不是在您的电脑上"

#. %(pro)s is "N pages" in bold (how many pages Pro fetches at        once) and
#. %(free)s is the Free plan's number, in bold, with the noun left        out
#. ("instead of 4"). %(counter)s and %(markdown)s are the two product
#. names.
#, python-format
msgid ""
"Same crawler, same counting, same reports. Pro fetches %(pro)s at once "
"instead of %(free)s, and starts ahead of everyone else when the queue is "
"busy. One subscription covers both %(counter)s and %(markdown)s — they’re"
" the same account."
msgstr ""
"同一爬虫、同样的计数、同样的报告。 Pro 可一次获取 %(pro)s，而不是 %(free)s；队列繁忙时，还会优先于其他所有人开始处理。 "
"一个订阅即可使用 %(counter)s 和 %(markdown)s——两者共用同一个账户。"

msgid "Same page in another crawl"
msgstr "另一次抓取中的同一页面"

msgid "Same page in more than one crawl"
msgstr "同一页面出现在多个抓取任务中"

msgid "Same page on more than one site"
msgstr "同一页面出现在多个网站上"

msgid "Same pages"
msgstr "相同页面"

msgid "Save"
msgstr "保存"

msgid "Save Markdown"
msgstr "保存 Markdown"

msgid "Save each page as Markdown"
msgstr "将每个页面保存为 Markdown"

msgid ""
"Save each page's main content as Markdown, downloadable as a ZIP when the"
" crawl finishes."
msgstr "将每个页面的主要内容保存为 Markdown，爬取完成后可下载为 ZIP。"

msgid "Saving…"
msgstr "正在保存…"

msgid "Search your runs"
msgstr "搜索您的运行记录"

